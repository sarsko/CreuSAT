use seq.Seq

type t_Lit  =
  { t_Lit__idx: int; t_Lit__polarity: bool }

type t_AssignedState  =
  | C_False
  | C_True
  | C_Unassigned

type t_Assignments  =
  { t_Assignments__assignments: Seq.seq t_AssignedState }

predicate unassigned [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 39 4 39 51] (self : t_Lit) (a : t_Assignments)

 =
  [%#sabstract_sat'3] Seq.get a.t_Assignments__assignments self.t_Lit__idx = C_Unassigned

predicate sat [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 21 4 21 44] (self : t_Lit) (a : t_Assignments) =
  [%#sabstract_sat'4] if self.t_Lit__polarity then
    Seq.get a.t_Assignments__assignments self.t_Lit__idx = C_True
  else
    Seq.get a.t_Assignments__assignments self.t_Lit__idx = C_False


predicate unsat [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 30 4 30 46] (self : t_Lit) (a : t_Assignments) =
  [%#sabstract_sat'5] if self.t_Lit__polarity then
    Seq.get a.t_Assignments__assignments self.t_Lit__idx = C_False
  else
    Seq.get a.t_Assignments__assignments self.t_Lit__idx = C_True


constant self  : t_Lit

constant a  : t_Assignments

function unit_test_unassigned_implies_neither_sat_nor_unsat [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 65 4 65 79] (self'0 : t_Lit) (a'0 : t_Assignments) : ()


goal vc_unit_test_unassigned_implies_neither_sat_nor_unsat : ([%#sabstract_sat] unassigned self a)
 -> ([%#sabstract_sat'0] not sat self a) && ([%#sabstract_sat'1] not unsat self a)
