use mach.int.Int

type t_Lit  =
  { t_Lit__idx: int; t_Lit__polarity: bool }

function opp [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 51 4 51 28] (self : t_Lit) : t_Lit =
  [%#sabstract_sat'4] { t_Lit__idx = self.t_Lit__idx; t_Lit__polarity = not self.t_Lit__polarity }

predicate invariant' [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 13 4 13 30] (self : t_Lit) =
  [%#sabstract_sat'5] self.t_Lit__idx >= 0

constant self  : t_Lit

function unit_test_opp [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 89 4 89 26] (self'0 : t_Lit) : ()

goal vc_unit_test_opp : ([%#sabstract_sat] opp (opp self) = self)
