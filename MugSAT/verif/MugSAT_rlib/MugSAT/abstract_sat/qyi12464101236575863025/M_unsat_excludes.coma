(* abstract_sat::Formula *)

let%span sabstract_sat = "/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 450 15 450 28
let%span sabstract_sat'0 = "/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 451 14 451 26
let%span sabstract_sat'1 = "/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 453 44 453 46
let%span sabstract_sat'2 = "/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 381 12 381 67
let%span sabstract_sat'3 = "/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 373 12 373 66
let%span sabstract_sat'4 = "/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 131 12 131 67
let%span sabstract_sat'5 = "/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 115 12 115 64
let%span sabstract_sat'6 = "/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 31 8 34 9
