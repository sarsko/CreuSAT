use seq.Seq
use set.Fset
use mach.int.Int

type t_Lit  =
  { t_Lit__idx: int; t_Lit__polarity: bool }

type t_Clause  =
  { t_Clause__clause_seq: Seq.seq t_Lit; t_Clause__clause_set: Fset.fset t_Lit }

type t_Formula  =
  { t_Formula__formula_seq: Seq.seq t_Clause; t_Formula__formula_set: Fset.fset t_Clause; t_Formula__num_vars: int }

function len [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 167 4 167 27] (self : t_Clause) : int =
  [%#sabstract_sat'17] Fset.cardinal self.t_Clause__clause_set

predicate no_duplicate_indexes [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 173 4 173 45] (self : t_Clause) =
  [%#sabstract_sat'15] forall j : int, k : int . 0 <= j /\ j < len self /\ 0 <= k /\ k < len self /\ k <> j
   -> (Seq.get self.t_Clause__clause_seq k).t_Lit__idx <> (Seq.get self.t_Clause__clause_seq j).t_Lit__idx

predicate contains [@inline:trivial] (self : Fset.fset t_Lit) (e : t_Lit) =
  [%#sfset] Fset.mem e self

predicate contains'0 (self : Seq.seq t_Lit) (x : t_Lit) =
  [%#sseq] exists i : int . 0 <= i /\ i < Seq.length self /\ Seq.get self i = x

predicate invariant' [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 100 4 100 30] (self : t_Clause) =
  [%#sabstract_sat'13] no_duplicate_indexes self
  /\ Seq.length self.t_Clause__clause_seq = Fset.cardinal self.t_Clause__clause_set
  /\ (forall i : int . 0 <= i /\ i < Seq.length self.t_Clause__clause_seq
   -> contains self.t_Clause__clause_set (Seq.get self.t_Clause__clause_seq i))
  /\ (forall l : t_Lit . contains self.t_Clause__clause_set l  -> contains'0 self.t_Clause__clause_seq l)

predicate invariant''0 [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 13 4 13 30] (self : t_Lit) =
  [%#sabstract_sat'18] self.t_Lit__idx >= 0

predicate inv [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 45 4 45 36] (self : t_Lit) (n : int) =
  [%#sabstract_sat'16] invariant''0 self /\ self.t_Lit__idx < n

predicate vars_in_range_set [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 190 4 190 50] (self : t_Clause) (n : int)

 =
  [%#sabstract_sat'14] forall l : t_Lit . contains self.t_Clause__clause_set l  -> inv l n

predicate inv'0 [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 212 4 212 36] (self : t_Clause) (n : int) =
  [%#sabstract_sat'9] invariant' self /\ vars_in_range_set self n

predicate inv'1 [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 411 4 411 28] (self : t_Formula) =
  [%#sabstract_sat'11] forall i : int . 0 <= i /\ i < Seq.length self.t_Formula__formula_seq
   -> inv'0 (Seq.get self.t_Formula__formula_seq i) self.t_Formula__num_vars

predicate contains'1 [@inline:trivial] (self : Fset.fset t_Clause) (e : t_Clause) =
  [%#sfset] Fset.mem e self

predicate inv_set [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 420 4 420 32] (self : t_Formula) =
  [%#sabstract_sat'12] forall c : t_Clause . contains'1 self.t_Formula__formula_set c
   -> inv'0 c self.t_Formula__num_vars

predicate invariant''1 [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 431 4 431 30] (self : t_Formula) =
  [%#sabstract_sat'8] inv'1 self
  /\ inv_set self
  /\ (forall i : int . 0 <= i /\ i < Seq.length self.t_Formula__formula_seq
   -> contains'1 self.t_Formula__formula_set (Seq.get self.t_Formula__formula_seq i))
  /\ (forall c : t_Clause . contains'1 self.t_Formula__formula_set c
   -> (exists i : int . 0 <= i
  /\ i < Seq.length self.t_Formula__formula_seq /\ Seq.get self.t_Formula__formula_seq i = c))

function insert [@inline:trivial] (self : Fset.fset t_Clause) (e : t_Clause) : Fset.fset t_Clause =
  [%#sfset'0] Fset.add e self

function insert'0 [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 347 4 347 46] (self : t_Formula) (clause : t_Clause) : t_Formula

 =
  [%#sabstract_sat'10] { t_Formula__formula_seq = Seq.snoc self.t_Formula__formula_seq clause;
                         t_Formula__formula_set = insert self.t_Formula__formula_set clause;
                         t_Formula__num_vars = self.t_Formula__num_vars }

constant self  : t_Formula

constant clause  : t_Clause

constant o  : t_Formula

function unit_test_insert [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 365 4 365 54] (self'0 : t_Formula) (clause'0 : t_Clause) (o'0 : t_Formula) : ()


goal vc_unit_test_insert : ([%#sabstract_sat] invariant''1 self)
 -> ([%#sabstract_sat'0] inv'0 clause self.t_Formula__num_vars)
 -> ([%#sabstract_sat'1] o = insert'0 self clause)
 -> ([%#sabstract_sat'2] (insert'0 self clause).t_Formula__num_vars = self.t_Formula__num_vars)
&& ([%#sabstract_sat'3] inv'1 o)
&& ([%#sabstract_sat'4] inv_set o)
&& ([%#sabstract_sat'5] forall i : int . 0 <= i /\ i < Seq.length o.t_Formula__formula_seq
 -> contains'1 o.t_Formula__formula_set (Seq.get o.t_Formula__formula_seq i))
&& ([%#sabstract_sat'6] forall c : t_Clause . contains'1 o.t_Formula__formula_set c
 -> (exists i : int . 0 <= i /\ i < Seq.length o.t_Formula__formula_seq /\ Seq.get o.t_Formula__formula_seq i = c))
