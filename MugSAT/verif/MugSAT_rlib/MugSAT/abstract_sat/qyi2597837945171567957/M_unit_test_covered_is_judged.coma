use seq.Seq
use set.Fset
use mach.int.Int

type t_Lit  =
  { t_Lit__idx: int; t_Lit__polarity: bool }

type t_Clause  =
  { t_Clause__clause_seq: Seq.seq t_Lit; t_Clause__clause_set: Fset.fset t_Lit }

type t_AssignedState  =
  | C_False
  | C_True
  | C_Unassigned

type t_Assignments  =
  { t_Assignments__assignments: Seq.seq t_AssignedState }

function len [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 167 4 167 27] (self : t_Clause) : int =
  [%#sabstract_sat'16] Fset.cardinal self.t_Clause__clause_set

predicate no_duplicate_indexes [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 173 4 173 45] (self : t_Clause) =
  [%#sabstract_sat'12] forall j : int, k : int . 0 <= j /\ j < len self /\ 0 <= k /\ k < len self /\ k <> j
   -> (Seq.get self.t_Clause__clause_seq k).t_Lit__idx <> (Seq.get self.t_Clause__clause_seq j).t_Lit__idx

predicate contains [@inline:trivial] (self : Fset.fset t_Lit) (e : t_Lit) =
  [%#sfset] Fset.mem e self

predicate contains'0 (self : Seq.seq t_Lit) (x : t_Lit) =
  [%#sseq] exists i : int . 0 <= i /\ i < Seq.length self /\ Seq.get self i = x

predicate invariant' [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 100 4 100 30] (self : t_Clause) =
  [%#sabstract_sat'7] no_duplicate_indexes self
  /\ Seq.length self.t_Clause__clause_seq = Fset.cardinal self.t_Clause__clause_set
  /\ (forall i : int . 0 <= i /\ i < Seq.length self.t_Clause__clause_seq
   -> contains self.t_Clause__clause_set (Seq.get self.t_Clause__clause_seq i))
  /\ (forall l : t_Lit . contains self.t_Clause__clause_set l  -> contains'0 self.t_Clause__clause_seq l)

predicate invariant''0 [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 13 4 13 30] (self : t_Lit) =
  [%#sabstract_sat'17] self.t_Lit__idx >= 0

predicate inv [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 45 4 45 36] (self : t_Lit) (n : int) =
  [%#sabstract_sat'13] invariant''0 self /\ self.t_Lit__idx < n

predicate vars_in_range_set [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 190 4 190 50] (self : t_Clause) (n : int)

 =
  [%#sabstract_sat'8] forall l : t_Lit . contains self.t_Clause__clause_set l  -> inv l n

predicate inv'0 [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 212 4 212 36] (self : t_Clause) (n : int) =
  [%#sabstract_sat'3] invariant' self /\ vars_in_range_set self n

function len'0 [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 506 4 506 27] (self : t_Assignments) : int =
  [%#sabstract_sat'4] Seq.length self.t_Assignments__assignments

predicate unassigned [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 39 4 39 51] (self : t_Lit) (a : t_Assignments)

 =
  [%#sabstract_sat'9] Seq.get a.t_Assignments__assignments self.t_Lit__idx = C_Unassigned

predicate is_covered [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 151 4 151 51] (self : t_Clause) (a : t_Assignments)

 =
  [%#sabstract_sat'5] forall l : t_Lit . contains self.t_Clause__clause_set l  -> not unassigned l a

predicate sat [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 21 4 21 44] (self : t_Lit) (a : t_Assignments) =
  [%#sabstract_sat'14] if self.t_Lit__polarity then
    Seq.get a.t_Assignments__assignments self.t_Lit__idx = C_True
  else
    Seq.get a.t_Assignments__assignments self.t_Lit__idx = C_False


predicate sat'0 [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 113 4 113 44] (self : t_Clause) (a : t_Assignments)

 =
  [%#sabstract_sat'10] exists l : t_Lit . contains self.t_Clause__clause_set l /\ sat l a

predicate unsat [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 30 4 30 46] (self : t_Lit) (a : t_Assignments) =
  [%#sabstract_sat'15] if self.t_Lit__polarity then
    Seq.get a.t_Assignments__assignments self.t_Lit__idx = C_False
  else
    Seq.get a.t_Assignments__assignments self.t_Lit__idx = C_True


predicate unsat'0 [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 129 4 129 46] (self : t_Clause) (a : t_Assignments)

 =
  [%#sabstract_sat'11] forall l : t_Lit . contains self.t_Clause__clause_set l  -> unsat l a

predicate is_judged [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 145 4 145 50] (self : t_Clause) (a : t_Assignments)

 =
  [%#sabstract_sat'6] sat'0 self a \/ unsat'0 self a

constant self  : t_Clause

constant a  : t_Assignments

function unit_test_covered_is_judged [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 294 4 294 56] (self'0 : t_Clause) (a'0 : t_Assignments) : ()


goal vc_unit_test_covered_is_judged : ([%#sabstract_sat] inv'0 self (len'0 a))
 -> ([%#sabstract_sat'0] is_covered self a)  -> ([%#sabstract_sat'1] is_judged self a)
