(* abstract_sat::Clause *)

let%span sabstract_sat = "/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 254 15 254 31
let%span sabstract_sat'0 = "/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 255 15 255 30
let%span sabstract_sat'1 = "/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 256 14 256 27
let%span sabstract_sat'2 = "/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 257 61 257 63
let%span sabstract_sat'3 = "/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 102 12 105 89
let%span sabstract_sat'4 = "/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 165 4 165 12
let%span sabstract_sat'5 = "/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 131 12 131 67
let%span sabstract_sat'6 = "/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 175 12 176 107
let%span sabstract_sat'7 = "/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 31 8 34 9
let%span sfset = "/Users/sarekhs/creusot/creusot-contracts/src/logic/fset.rs" 47 8 47 26
let%span sseq = "/Users/sarekhs/creusot/creusot-contracts/src/logic/seq.rs" 362 20 362 77

use seq.Seq
use set.Fset
use mach.int.Int

type t_Lit  =
  { t_Lit__idx: int; t_Lit__polarity: bool }

type t_Clause  =
  { t_Clause__clause_seq: Seq.seq t_Lit; t_Clause__clause_set: Fset.fset t_Lit }

type t_AssignedState  =
  | C_False
  | C_True
  | C_Unassigned

type t_Assignments  =
  { t_Assignments__assignments: Seq.seq t_AssignedState }

function len [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 167 4 167 27] (self : t_Clause) : int =
  [%#sabstract_sat'4] Fset.cardinal self.t_Clause__clause_set

predicate no_duplicate_indexes [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 173 4 173 45] (self : t_Clause) =
  [%#sabstract_sat'6] forall j : int, k : int . 0 <= j /\ j < len self /\ 0 <= k /\ k < len self /\ k <> j
   -> (Seq.get self.t_Clause__clause_seq k).t_Lit__idx <> (Seq.get self.t_Clause__clause_seq j).t_Lit__idx

predicate contains [@inline:trivial] (self : Fset.fset t_Lit) (e : t_Lit) =
  [%#sfset] Fset.mem e self

predicate contains'0 (self : Seq.seq t_Lit) (x : t_Lit) =
  [%#sseq] exists i : int . 0 <= i /\ i < Seq.length self /\ Seq.get self i = x

predicate invariant' [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 100 4 100 30] (self : t_Clause) =
  [%#sabstract_sat'3] no_duplicate_indexes self
  /\ Seq.length self.t_Clause__clause_seq = Fset.cardinal self.t_Clause__clause_set
  /\ (forall i : int . 0 <= i /\ i < Seq.length self.t_Clause__clause_seq
   -> contains self.t_Clause__clause_set (Seq.get self.t_Clause__clause_seq i))
  /\ (forall l : t_Lit . contains self.t_Clause__clause_set l  -> contains'0 self.t_Clause__clause_seq l)

predicate unsat [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 30 4 30 46] (self : t_Lit) (a : t_Assignments) =
  [%#sabstract_sat'7] if self.t_Lit__polarity then
    Seq.get a.t_Assignments__assignments self.t_Lit__idx = C_False
  else
    Seq.get a.t_Assignments__assignments self.t_Lit__idx = C_True


predicate unsat'0 [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 129 4 129 46] (self : t_Clause) (a : t_Assignments)

 =
  [%#sabstract_sat'5] forall l : t_Lit . contains self.t_Clause__clause_set l  -> unsat l a

constant self  : t_Clause

constant a  : t_Assignments

function unit_test_empty_clause_is_unsat [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 257 4 257 60] (self'0 : t_Clause) (a'0 : t_Assignments) : ()


goal vc_unit_test_empty_clause_is_unsat : ([%#sabstract_sat] invariant' self)
 -> ([%#sabstract_sat'0] len self = 0)  -> ([%#sabstract_sat'1] unsat'0 self a)
