(* abstract_sat::Clause *)

let%span sabstract_sat = "/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 267 15 267 31
let%span sabstract_sat'0 = "/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 269 8 270 87
let%span sabstract_sat'1 = "/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 272 45 272 47
let%span sabstract_sat'2 = "/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 102 12 105 89
let%span sabstract_sat'3 = "/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 165 4 165 12
let%span sabstract_sat'4 = "/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 175 12 176 107
let%span sfset = "/Users/sarekhs/creusot/creusot-contracts/src/logic/fset.rs" 47 8 47 26
let%span sseq = "/Users/sarekhs/creusot/creusot-contracts/src/logic/seq.rs" 362 20 362 77

use seq.Seq
use set.Fset
use mach.int.Int

type t_Lit  =
  { t_Lit__idx: int; t_Lit__polarity: bool }

type t_Clause  =
  { t_Clause__clause_seq: Seq.seq t_Lit; t_Clause__clause_set: Fset.fset t_Lit }

function len [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 167 4 167 27] (self : t_Clause) : int =
  [%#sabstract_sat'3] Fset.cardinal self.t_Clause__clause_set

predicate no_duplicate_indexes [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 173 4 173 45] (self : t_Clause) =
  [%#sabstract_sat'4] forall j : int, k : int . 0 <= j /\ j < len self /\ 0 <= k /\ k < len self /\ k <> j
   -> (Seq.get self.t_Clause__clause_seq k).t_Lit__idx <> (Seq.get self.t_Clause__clause_seq j).t_Lit__idx

predicate contains [@inline:trivial] (self : Fset.fset t_Lit) (e : t_Lit) =
  [%#sfset] Fset.mem e self

predicate contains'0 (self : Seq.seq t_Lit) (x : t_Lit) =
  [%#sseq] exists i : int . 0 <= i /\ i < Seq.length self /\ Seq.get self i = x

predicate invariant' [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 100 4 100 30] (self : t_Clause) =
  [%#sabstract_sat'2] no_duplicate_indexes self
  /\ Seq.length self.t_Clause__clause_seq = Fset.cardinal self.t_Clause__clause_set
  /\ (forall i : int . 0 <= i /\ i < Seq.length self.t_Clause__clause_seq
   -> contains self.t_Clause__clause_set (Seq.get self.t_Clause__clause_seq i))
  /\ (forall l : t_Lit . contains self.t_Clause__clause_set l  -> contains'0 self.t_Clause__clause_seq l)

constant self  : t_Clause

function unit_test_no_duplicates_implies [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 272 4 272 44] (self'0 : t_Clause) : ()


goal vc_unit_test_no_duplicates_implies : ([%#sabstract_sat] invariant' self)
 -> ([%#sabstract_sat'0] forall j : int, k : int . 0 <= j /\ j < len self /\ 0 <= k /\ k < len self /\ k <> j
 -> Seq.get self.t_Clause__clause_seq k <> Seq.get self.t_Clause__clause_seq j)
