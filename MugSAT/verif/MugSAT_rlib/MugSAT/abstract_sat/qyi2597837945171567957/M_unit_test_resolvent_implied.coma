use seq.Seq
use set.Fset
use mach.int.Int

type t_Lit  =
  { t_Lit__idx: int; t_Lit__polarity: bool }

type t_Clause  =
  { t_Clause__clause_seq: Seq.seq t_Lit; t_Clause__clause_set: Fset.fset t_Lit }

type t_Formula  =
  { t_Formula__formula_seq: Seq.seq t_Clause; t_Formula__formula_set: Fset.fset t_Clause; t_Formula__num_vars: int }

function len [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 167 4 167 27] (self : t_Clause) : int =
  [%#sabstract_sat'14] Fset.cardinal self.t_Clause__clause_set

predicate no_duplicate_indexes [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 173 4 173 45] (self : t_Clause) =
  [%#sabstract_sat'12] forall j : int, k : int . 0 <= j /\ j < len self /\ 0 <= k /\ k < len self /\ k <> j
   -> (Seq.get self.t_Clause__clause_seq k).t_Lit__idx <> (Seq.get self.t_Clause__clause_seq j).t_Lit__idx

predicate contains [@inline:trivial] (self : Fset.fset t_Lit) (e : t_Lit) =
  [%#sfset] Fset.mem e self

predicate contains'0 (self : Seq.seq t_Lit) (x : t_Lit) =
  [%#sseq] exists i : int . 0 <= i /\ i < Seq.length self /\ Seq.get self i = x

predicate invariant' [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 100 4 100 30] (self : t_Clause) =
  [%#sabstract_sat'9] no_duplicate_indexes self
  /\ Seq.length self.t_Clause__clause_seq = Fset.cardinal self.t_Clause__clause_set
  /\ (forall i : int . 0 <= i /\ i < Seq.length self.t_Clause__clause_seq
   -> contains self.t_Clause__clause_set (Seq.get self.t_Clause__clause_seq i))
  /\ (forall l : t_Lit . contains self.t_Clause__clause_set l  -> contains'0 self.t_Clause__clause_seq l)

predicate invariant''0 [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 13 4 13 30] (self : t_Lit) =
  [%#sabstract_sat'15] self.t_Lit__idx >= 0

predicate inv [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 45 4 45 36] (self : t_Lit) (n : int) =
  [%#sabstract_sat'13] invariant''0 self /\ self.t_Lit__idx < n

predicate vars_in_range_set [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 190 4 190 50] (self : t_Clause) (n : int)

 =
  [%#sabstract_sat'10] forall l : t_Lit . contains self.t_Clause__clause_set l  -> inv l n

predicate inv'0 [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 212 4 212 36] (self : t_Clause) (n : int) =
  [%#sabstract_sat'6] invariant' self /\ vars_in_range_set self n

predicate inv'1 [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 411 4 411 28] (self : t_Formula) =
  [%#sabstract_sat'7] forall i : int . 0 <= i /\ i < Seq.length self.t_Formula__formula_seq
   -> inv'0 (Seq.get self.t_Formula__formula_seq i) self.t_Formula__num_vars

function opp [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 51 4 51 28] (self : t_Lit) : t_Lit =
  [%#sabstract_sat'11] { t_Lit__idx = self.t_Lit__idx; t_Lit__polarity = not self.t_Lit__polarity }

predicate resolvent_of [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 236 4 236 69] (self : t_Clause) (c1 : t_Clause) (c2 : t_Clause) (o : t_Lit)

 =
  [%#sabstract_sat'8] (forall l : t_Lit . contains c1.t_Clause__clause_set l /\ l <> o
   -> contains self.t_Clause__clause_set l)
  /\ (forall l : t_Lit . contains c2.t_Clause__clause_set l /\ l <> opp o  -> contains self.t_Clause__clause_set l)
  /\ (forall l : t_Lit . contains self.t_Clause__clause_set l
   -> contains c1.t_Clause__clause_set l \/ contains c2.t_Clause__clause_set l)
  /\ not contains self.t_Clause__clause_set o
  /\ not contains self.t_Clause__clause_set (opp o)
  /\ contains c1.t_Clause__clause_set o /\ contains c2.t_Clause__clause_set (opp o)

predicate contains'1 (self : Seq.seq t_Clause) (x : t_Clause) =
  [%#sseq] exists i : int . 0 <= i /\ i < Seq.length self /\ Seq.get self i = x

constant self  : t_Clause

constant c1  : t_Clause

constant c2  : t_Clause

constant o  : t_Lit

constant f  : t_Formula

function unit_test_resolvent_implied [#"/Users/sarekhs/CreuSAT/MugSAT/src/abstract_sat.rs" 333 4 333 84] (self'0 : t_Clause) (c1'0 : t_Clause) (c2'0 : t_Clause) (o'0 : t_Lit) (f'0 : t_Formula) : ()


goal vc_unit_test_resolvent_implied : ([%#sabstract_sat] inv'0 self f.t_Formula__num_vars /\ inv'1 f)
 -> ([%#sabstract_sat'0] resolvent_of self c1 c2 o)
 -> ([%#sabstract_sat'1] contains'1 f.t_Formula__formula_seq c1 /\ contains'1 f.t_Formula__formula_seq c2)
 -> ([%#sabstract_sat'2] inv'0 self f.t_Formula__num_vars)
 -> ([%#sabstract_sat'3] inv'0 c1 f.t_Formula__num_vars) && ([%#sabstract_sat'4] inv'0 c2 f.t_Formula__num_vars)
