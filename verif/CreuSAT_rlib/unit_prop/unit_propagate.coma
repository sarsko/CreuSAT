type t_Vec_Watcher_Global

type t_Watcher = { cref: UInt64.t; blocker: t_Lit }

function view_Vec_Watcher_Global (self: t_Vec_Watcher_Global) : Seq.seq t_Watcher

axiom view_Vec_Watcher_Global_spec:
  forall self: t_Vec_Watcher_Global [view_Vec_Watcher_Global self]. [%#svec'0] Seq.length (view_Vec_Watcher_Global self)
    <= UInt64.t'int const_MAX

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate watches_inv_internal [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_watches.rs" 9 0 9 77] (w: Seq.seq t_Vec_Watcher_Global) (n: int) (f: t_Formula) =
  [%#slogic_watches'0] 2 * n = Seq.length w
  /\ (forall i: int. 0 <= i /\ i < Seq.length w
    -> (forall j: int. 0 <= j /\ j < Seq.length (view_Vec_Watcher_Global (Seq.get w i))
      -> UInt64.t'int (Seq.get (view_Vec_Watcher_Global (Seq.get w i)) j).cref
        < Seq.length (view_Vec_Clause_Global f.clauses)
      /\ gt_log_Int (Seq.length (view_Clause (Seq.get (view_Vec_Clause_Global f.clauses) (UInt64.t'int (Seq.get (view_Vec_Watcher_Global (Seq.get w i)) j).cref)))) 1
      /\ index (Seq.get (view_Vec_Watcher_Global (Seq.get w i)) j).blocker < UInt64.t'int f.num_vars))

function view_Vec_Vec_Watcher_Global_Global (self: t_Vec_Vec_Watcher_Global_Global) : Seq.seq t_Vec_Watcher_Global

axiom view_Vec_Vec_Watcher_Global_Global_spec:
  forall self: t_Vec_Vec_Watcher_Global_Global [view_Vec_Vec_Watcher_Global_Global self]. [%#svec'0] Seq.length (view_Vec_Vec_Watcher_Global_Global self)
    <= UInt64.t'int const_MAX

