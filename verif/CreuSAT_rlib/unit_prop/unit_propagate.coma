  [%#slogic_watches] watches_inv_internal (view_Vec_Vec_Watcher_Global_Global self.watches) (UInt64.t'int f.num_vars) f

function view_Vec_u8_Global (self: t_Vec_u8_Global) : Seq.seq UInt8.t

axiom view_Vec_u8_Global_spec:
