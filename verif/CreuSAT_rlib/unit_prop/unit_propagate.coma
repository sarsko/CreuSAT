    <= UInt64.t'int const_MAX

function view_Assignments [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_assignments.rs" 17 4 17 33] (self: t_Assignments) : Seq.seq UInt8.t
 = [%#slogic_assignments'0] view_Vec_u8_Global self.f0

predicate inv'0 [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_assignments.rs" 45 4 45 40] (self: t_Assignments) (f: t_Formula) =
  [%#slogic_assignments] UInt64.t'int f.num_vars = Seq.length (view_Assignments self)
  /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Assignments self)
    -> UInt8.t'int (Seq.get (view_Assignments self) i) <= 3)

predicate inv'1 [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_lit.rs" 66 4 66 36] (self: t_Lit) (n: int) =
  [%#slogic_lit'0] index self < n

predicate inv'2 [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_trail.rs" 10 4 10 40] (self: t_Reason) (f: t_Formula) =
  [%#slogic_trail'6] match self with
    | Long cref'0 -> 0 <= UInt64.t'int cref'0
    /\ UInt64.t'int cref'0 < Seq.length (view_Vec_Clause_Global f.clauses)
    /\ gt_log_Int (Seq.length (view_Clause (Seq.get (view_Vec_Clause_Global f.clauses) (UInt64.t'int cref'0)))) 1
    | Unit cref'0 -> 0 <= UInt64.t'int cref'0
    /\ UInt64.t'int cref'0 < Seq.length (view_Vec_Clause_Global f.clauses)
    /\ Seq.length (view_Clause (Seq.get (view_Vec_Clause_Global f.clauses) (UInt64.t'int cref'0))) = 1
    | _ -> true
    end

predicate trail_invariant [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_trail.rs" 93 0 93 60] (trail'0: Seq.seq t_Step) (f: t_Formula) =
  [%#slogic_trail'0] forall i: int. 0 <= i /\ i < Seq.length trail'0
