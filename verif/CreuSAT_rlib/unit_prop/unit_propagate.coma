  [%#slogic_lit'1] exists i: int. 0 <= i
    /\ i < Seq.length (view_Clause c) /\ index (Seq.get (view_Clause c) i) = index self

predicate lit_not_in_less_inner [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_trail.rs" 81 0 81 62] (t: Seq.seq t_Step) (f: t_Formula) =
