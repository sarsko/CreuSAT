    -> (forall j: int. 0 <= j /\ j < i
      -> match (Seq.get t j).reason with
        | Long cref'0 -> not lit_idx_in (Seq.get t i).lit (Seq.get (view_Vec_Clause_Global f.clauses) (UInt64.t'int cref'0))
