use creusot.int.UInt64
use creusot.int.UInt32
use seq.Seq
use creusot.prelude.MutBorrow
use creusot.int.UInt8
use int.ComputerDivision
use creusot.prelude.Any
use int.Int

type t_Vec_Clause_Global

type t_Formula = { clauses: t_Vec_Clause_Global; num_vars: UInt64.t }

type t_Vec_Lit_Global

type t_Clause = { deleted: bool; lbd: UInt32.t; search: UInt64.t; lits: t_Vec_Lit_Global }

predicate in_bounds_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_Clause) =
  [%#sslice] UInt64.t'int self < Seq.length seq

meta "rewrite_def" predicate in_bounds_usize

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Clause_Global (self: t_Vec_Clause_Global) : Seq.seq t_Clause

axiom view_Vec_Clause_Global_spec: forall self: t_Vec_Clause_Global. [%#svec'1] Seq.length (view_Vec_Clause_Global self)
    <= UInt64.t'int const_MAX

predicate has_value_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_Clause) (out: t_Clause) =
  [%#sslice'0] Seq.get seq (UInt64.t'int self) = out

meta "rewrite_def" predicate has_value_usize

let rec index_Vec_Clause_Global (self_: t_Vec_Clause_Global) (ix: UInt64.t) (return (x: t_Clause)) =
  {[@stop_split] [@expl:index requires] [%#svec] in_bounds_usize ix (view_Vec_Clause_Global self_)}
  any
  [ return (result: t_Clause) ->
  {[@stop_split] [@expl:index ensures] [%#svec'0] has_value_usize ix (view_Vec_Clause_Global self_) result}
    (! return {result}) ]

type t_Lit = { idx: UInt64.t; polarity: bool }

function view_Vec_Lit_Global (self: t_Vec_Lit_Global) : Seq.seq t_Lit

axiom view_Vec_Lit_Global_spec: forall self: t_Vec_Lit_Global. [%#svec'1] Seq.length (view_Vec_Lit_Global self)
    <= UInt64.t'int const_MAX

function view_Clause [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 13 4 13 33] (self: t_Clause) : Seq.seq t_Lit
 = [%#slogic_clause] view_Vec_Lit_Global self.lits

let rec len (self: t_Clause) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sclause] UInt64.t'int result
    = Seq.length (view_Clause self)}
    (! return {result}) ]

type t_FormulaModel = { clauses'0: Seq.seq t_Clause; num_vars'0: int }

function view_Formula [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 16 4 16 33] (self: t_Formula) : t_FormulaModel
 = [%#slogic_formula'2] { clauses'0 = view_Vec_Clause_Global self.clauses; num_vars'0 = UInt64.t'int self.num_vars }

let rec index_Formula (self: t_Formula) (ix: UInt64.t) (return (x: t_Clause)) =
  {[@stop_split] [@expl:index requires] [%#sformula] UInt64.t'int ix < Seq.length (view_Formula self).clauses'0}
  any
  [ return (result: t_Clause) ->
  {[@stop_split] [@expl:index ensures] [%#sformula'0] Seq.get (view_Formula self).clauses'0 (UInt64.t'int ix) = result}
    (! return {result}) ]

function min_log [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/util.rs" 83 0 83 37] (a: int) (b: int) : int =
  [%#sutil'4] if a <= b then a else b

let rec min (a: UInt64.t) (b: UInt64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:min ensures] ([@stop_split] [@expl:min ensures #0] [%#sutil] UInt64.t'int result
      = min_log (UInt64.t'int a) (UInt64.t'int b))
