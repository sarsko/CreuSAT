  | & i: UInt64.t = Any.any_l ()
  | & _30: bool = Any.any_l ()
  | & _32: UInt64.t = Any.any_l ()
  | & _35: bool = Any.any_l ()
  | & _37: t_Clause = Any.any_l ()
  | & _43: bool = Any.any_l ()
  | & _44: UInt64.t = Any.any_l ()
  | & _46: t_Clause = Any.any_l () ])
  [ return (result: t_SatResult) ->
  {[@stop_split] [@expl:check_formula_invariant ensures] [%#sformula'17] match result with
      | Sat assn -> formula_sat_inner (view_Formula self) (view_Vec_u8_Global assn)
      | Unsat -> not_satisfiable self
      | Unknown -> inv'1 self
      /\ 0 < UInt64.t'int self.num_vars /\ UInt64.t'int self.num_vars < ComputerDivision.div (UInt64.t'int const_MAX) 2
      | Err -> true
      end}
    (! return {result}) ]
