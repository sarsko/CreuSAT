type t_Vec_Lit_Global

type t_Clause = { deleted: bool; lbd: UInt32.t; search: UInt64.t; lits: t_Vec_Lit_Global }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Clause_Global (self: t_Vec_Clause_Global) : Seq.seq t_Clause

axiom view_Vec_Clause_Global_spec: forall self: t_Vec_Clause_Global. [%#svec'2] Seq.length (view_Vec_Clause_Global self)
    <= UInt64.t'int const_MAX

let rec len_Clause (self_: t_Vec_Clause_Global) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#svec] UInt64.t'int result
    = Seq.length (view_Vec_Clause_Global self_)}
    (! return {result}) ]

predicate unset [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic.rs" 18 0 18 38] (v: UInt8.t) =
  [%#slogic] if UInt8.t'int v >= 2 then true else false

predicate complete_inner [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_assignments.rs" 31 0 31 52] (a: Seq.seq UInt8.t) =
  [%#slogic_assignments'1] forall i: int. 0 <= i /\ i < Seq.length a -> not unset (Seq.get a i)

type t_Lit = { idx: UInt64.t; polarity: bool }

function view_Vec_Lit_Global (self: t_Vec_Lit_Global) : Seq.seq t_Lit

axiom view_Vec_Lit_Global_spec: forall self: t_Vec_Lit_Global. [%#svec'2] Seq.length (view_Vec_Lit_Global self)
    <= UInt64.t'int const_MAX

function view_Clause [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 13 4 13 33] (self: t_Clause) : Seq.seq t_Lit
 = [%#slogic_clause] view_Vec_Lit_Global self.lits

predicate is_positive [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_lit.rs" 23 4 23 42] [@inline:trivial] (self: t_Lit) =
  [%#slogic_lit'5] self.polarity

meta "rewrite_def" predicate is_positive

function index [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_lit.rs" 18 4 18 35] [@inline:trivial] (self: t_Lit) : int
 = [%#slogic_lit'1] UInt64.t'int self.idx

meta "rewrite_def" function index

predicate sat_inner [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_lit.rs" 71 4 71 57] (self: t_Lit) (a: Seq.seq UInt8.t) =
  [%#slogic_lit'2] if is_positive self then
    UInt8.t'int (Seq.get a (index self)) = 1
  else
    UInt8.t'int (Seq.get a (index self)) = 0


predicate sat_inner'0 [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 164 4 164 57] (self: t_Clause) (a: Seq.seq UInt8.t) =
  [%#slogic_clause'2] exists i: int. 0 <= i
    /\ i < Seq.length (view_Clause self) /\ sat_inner (Seq.get (view_Clause self) i) a

predicate sat_inner'1 [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 104 4 104 57] (self: t_Formula) (a: Seq.seq UInt8.t) =
  [%#slogic_formula'6] forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Clause_Global self.clauses)
    -> sat_inner'0 (Seq.get (view_Vec_Clause_Global self.clauses) i) a

predicate eventually_sat_complete [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 54 4 54 48] (self: t_Formula) =
  [%#slogic_formula'2] exists a2: Seq.seq UInt8.t. Seq.length a2 = UInt64.t'int self.num_vars
    /\ complete_inner a2 /\ sat_inner'1 self a2

predicate equisat [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 61 4 61 44] (self: t_Formula) (o: t_Formula) =
  [%#slogic_formula] eventually_sat_complete self = eventually_sat_complete o

predicate inv [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_lit.rs" 66 4 66 36] (self: t_Lit) (n: int) =
  [%#slogic_lit] index self < n

predicate vars_in_range_inner [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 19 0 19 55] (s: Seq.seq t_Lit) (n: int) =
  [%#slogic_clause'4] forall i: int. 0 <= i /\ i < Seq.length s -> inv (Seq.get s i) n

predicate no_duplicate_indexes_inner [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 39 0 39 54] (s: Seq.seq t_Lit) =
  [%#slogic_clause'5] forall j: int, k: int. 0 <= j /\ j < Seq.length s /\ 0 <= k /\ k < Seq.length s /\ k <> j
    -> index (Seq.get s k) <> index (Seq.get s j)

predicate inv_internal [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 27 0 27 48] (s: Seq.seq t_Lit) (n: int) =
  [%#slogic_clause'3] vars_in_range_inner s n /\ no_duplicate_indexes_inner s

predicate inv'0 [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 199 4 199 36] (self: t_Clause) (n: int) =
  [%#slogic_clause'1] inv_internal (view_Clause self) n

predicate inv_mirror [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 73 4 73 35] (self: t_Formula) =
  [%#slogic_formula'3] (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Clause_Global self.clauses)
      -> inv'0 (Seq.get (view_Vec_Clause_Global self.clauses) i) (UInt64.t'int self.num_vars))
  /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Clause_Global self.clauses)
    -> Seq.length (view_Clause (Seq.get (view_Vec_Clause_Global self.clauses) i)) >= 1)

type t_FormulaModel = { clauses'0: Seq.seq t_Clause; num_vars'0: int }

predicate formula_invariant [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 22 0 22 49] (f: t_FormulaModel) =
  [%#slogic_formula'4] forall i: int. 0 <= i /\ i < Seq.length f.clauses'0
    -> inv'0 (Seq.get f.clauses'0 i) f.num_vars'0 /\ Seq.length (view_Clause (Seq.get f.clauses'0 i)) > 0

function view_Formula [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 16 4 16 33] (self: t_Formula) : t_FormulaModel
 = [%#slogic_formula'5] { clauses'0 = view_Vec_Clause_Global self.clauses; num_vars'0 = UInt64.t'int self.num_vars }

predicate inv'1 [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 68 4 68 28] (self: t_Formula) =
  [%#slogic_formula'1] formula_invariant (view_Formula self)

axiom inv_spec: forall self: t_Formula. [%#slogic_formula'0] inv'1 self = inv_mirror self

type t_Vec_u8_Global

type t_Assignments = { f0: t_Vec_u8_Global }

type t_Vec_usize_Global

type t_Vec_Step_Global

type t_Trail = {
  assignments: t_Assignments;
  lit_to_level: t_Vec_usize_Global;
  trail: t_Vec_Step_Global;
  curr_i: UInt64.t;
  decisions: t_Vec_usize_Global }

function view_Vec_u8_Global (self: t_Vec_u8_Global) : Seq.seq UInt8.t

axiom view_Vec_u8_Global_spec: forall self: t_Vec_u8_Global. [%#svec'2] Seq.length (view_Vec_u8_Global self)
    <= UInt64.t'int const_MAX

function view_Assignments [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_assignments.rs" 17 4 17 33] (self: t_Assignments) : Seq.seq UInt8.t
 = [%#slogic_assignments'0] view_Vec_u8_Global self.f0

predicate inv'2 [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_assignments.rs" 45 4 45 40] (self: t_Assignments) (f: t_Formula) =
  [%#slogic_assignments] UInt64.t'int f.num_vars = Seq.length (view_Assignments self)
  /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Assignments self)
    -> UInt8.t'int (Seq.get (view_Assignments self) i) <= 3)

type t_Reason = Decision | Unit UInt64.t | Long UInt64.t

type t_Step = { lit: t_Lit; decision_level: UInt64.t; reason: t_Reason }

predicate inv'3 [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_trail.rs" 10 4 10 40] (self: t_Reason) (f: t_Formula) =
  [%#slogic_trail'6] match self with
    | Long cref -> 0 <= UInt64.t'int cref
    /\ UInt64.t'int cref < Seq.length (view_Vec_Clause_Global f.clauses)
    /\ Seq.length (view_Clause (Seq.get (view_Vec_Clause_Global f.clauses) (UInt64.t'int cref))) > 1
    | Unit cref -> 0 <= UInt64.t'int cref
    /\ UInt64.t'int cref < Seq.length (view_Vec_Clause_Global f.clauses)
    /\ Seq.length (view_Clause (Seq.get (view_Vec_Clause_Global f.clauses) (UInt64.t'int cref))) = 1
    | _ -> true
    end

predicate trail_invariant [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_trail.rs" 93 0 93 60] (trail'0: Seq.seq t_Step) (f: t_Formula) =
  [%#slogic_trail'0] forall i: int. 0 <= i /\ i < Seq.length trail'0
