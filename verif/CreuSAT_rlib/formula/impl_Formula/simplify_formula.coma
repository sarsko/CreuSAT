let delete_clauses (self: MutBorrow.t t_Formula) (watches'0: MutBorrow.t t_Watches) (t: t_Trail) (return (x: ())) =
{[@stop_split] [@expl:delete_clauses requires] ([@stop_split] [@expl:delete_clauses requires #0] [%#sformula'7] inv'1 self.current)
  /\ ([@stop_split] [@expl:delete_clauses requires #1] [%#sformula'8] inv'2 watches'0.current self.current)
  /\ ([@stop_split] [@expl:delete_clauses requires #2] [%#sformula'9] inv'5 t self.current)
  /\ ([@stop_split] [@expl:delete_clauses requires #3] [%#sformula'10] inv'5 t self.current)
  /\ ([@stop_split] [@expl:delete_clauses requires #4] [%#sformula'11] UInt64.t'int self.current.num_vars
  < ComputerDivision.div (UInt64.t'int const_MAX) 2)}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:delete_clauses ensures] ([@stop_split] [@expl:delete_clauses ensures #0] [%#sformula'7] inv'1 self.final)
    /\ ([@stop_split] [@expl:delete_clauses ensures #1] [%#sformula'8] inv'2 watches'0.final self.final)
    /\ ([@stop_split] [@expl:delete_clauses ensures #2] [%#sformula'9] inv'5 t self.final)
    /\ ([@stop_split] [@expl:delete_clauses ensures #3] [%#sformula'12] self.current.num_vars = self.final.num_vars)
    /\ ([@stop_split] [@expl:delete_clauses ensures #4] [%#sformula'13] equisat self.current self.final)}
    (! return {result}) ]

predicate resolve_refmut_Watches [@inline:trivial] (_1: MutBorrow.t t_Watches) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Watches

predicate resolve_refmut_Formula [@inline:trivial] (_1: MutBorrow.t t_Formula) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Formula

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

