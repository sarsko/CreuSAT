{[@stop_split] [@expl:simplify_formula requires] ([@stop_split] [@expl:simplify_formula requires #0] [%#sformula'0] inv'1 self.current)
  /\ ([@stop_split] [@expl:simplify_formula requires #1] [%#sformula'1] inv'2 watches'0.current self.current)
  /\ ([@stop_split] [@expl:simplify_formula requires #2] [%#sformula'2] UInt64.t'int self.current.num_vars
    < ComputerDivision.div (UInt64.t'int const_MAX) 2)
  /\ ([@stop_split] [@expl:simplify_formula requires #3] [%#sformula'3] inv'5 t self.current)}
  (! bb0
  [ bb0 = s0
    [ s0 = MutBorrow.borrow_final <t_Formula> {self.current} {MutBorrow.get_id self}
        (fun (_bor: MutBorrow.t t_Formula) -> [ &_27 <- _bor ] [ &self <- { self with current = _bor.final } ] s1)
    | s1 = MutBorrow.borrow_final <t_Watches> {watches'0.current} {MutBorrow.get_id watches'0}
        (fun (_bor: MutBorrow.t t_Watches) ->
          [ &_28 <- _bor ] [ &watches'0 <- { watches'0 with current = _bor.final } ] s2)
