    | s3 = -{resolve_refmut_Watches watches'0}- s4
    | s4 = -{resolve_refmut_Formula self}- s5
    | s5 = return {_ret} ] ]
  [ & _ret: () = Any.any_l ()
  | & self: MutBorrow.t t_Formula = self
  | & watches'0: MutBorrow.t t_Watches = watches'0
  | & t: t_Trail = t
  | & _26: () = Any.any_l ()
  | & _27: MutBorrow.t t_Formula = Any.any_l ()
  | & _28: MutBorrow.t t_Watches = Any.any_l () ])
  [ return (result: ()) ->
  {[@stop_split] [@expl:simplify_formula ensures] ([@stop_split] [@expl:simplify_formula ensures #0] [%#sformula'0] inv'1 self.final)
    /\ ([@stop_split] [@expl:simplify_formula ensures #1] [%#sformula'1] inv'2 watches'0.final self.final)
    /\ ([@stop_split] [@expl:simplify_formula ensures #2] [%#sformula'4] inv'5 t self.final)
    /\ ([@stop_split] [@expl:simplify_formula ensures #3] [%#sformula'5] self.current.num_vars = self.final.num_vars)
    /\ ([@stop_split] [@expl:simplify_formula ensures #4] [%#sformula'6] equisat self.current self.final)}
