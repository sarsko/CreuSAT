      | s2 = any [ br0 -> {_28 = false} (! bb10) | br1 -> {_28} (! bb5) ] ]
      [ bb5 = s0
        [ s0 = index_Clause [%#sformula'3] {clause} {i} (fun (_x: t_Lit) -> [ &_35 <- _x ] s1)
        | s1 = lit_sat [%#sformula'4] {_35} {a} (fun (_x: bool) -> [ &_33 <- _x ] s2)
        | s2 = any [ br0 -> {_33 = false} (! bb9) | br1 -> {_33} (! bb8) ] ]
      | bb9 = s0
        [ s0 = UInt64.add [%#sformula'6] {i} {[%#sformula'5] (1: UInt64.t)} (fun (_x: UInt64.t) -> [ &i <- _x ] s1)
        | s1 = bb2 ] ] ]
  | bb8 = s0 [ s0 = [ &_ret <- [%#sformula'7] true ] s1 | s1 = return {_ret} ]
  | bb10 = s0 [ s0 = [ &_ret <- [%#sformula'8] false ] s1 | s1 = return {_ret} ] ]
