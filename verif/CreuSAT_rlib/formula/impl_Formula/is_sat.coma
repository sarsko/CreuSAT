  (a: t_Assignments) (return (x: bool)) =
{[@stop_split] [@expl:is_sat requires] ([@stop_split] [@expl:is_sat requires #0] [%#sformula'7] inv'1 self)
  /\ ([@stop_split] [@expl:is_sat requires #1] [%#sformula'8] inv'2 a self)}
