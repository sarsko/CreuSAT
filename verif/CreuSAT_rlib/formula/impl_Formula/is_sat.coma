        | s1 = any [ br0 -> {_24 = false} (! bb7) | br1 -> {_24} (! bb6) ] ]
      | bb6 = s0
        [ s0 = UInt64.add [%#sformula'4] {i} {[%#sformula'3] (1: UInt64.t)} (fun (_x: UInt64.t) -> [ &i <- _x ] s1)
        | s1 = bb1 ] ] ]
  | bb7 = s0 [ s0 = [ &_ret <- [%#sformula'5] false ] s1 | s1 = return {_ret} ]
  | bb8 = s0 [ s0 = [ &_ret <- [%#sformula'6] true ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & self: t_Formula = self
  | & a: t_Assignments = a
  | & i: UInt64.t = Any.any_l ()
  | & _19: bool = Any.any_l ()
  | & _21: UInt64.t = Any.any_l ()
  | & _24: bool = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:is_sat ensures] [%#sformula'9] result = sat'0 self a}
