  [ bb0 = s0 [ s0 = [ &i <- [%#sformula] (0: UInt64.t) ] s1 | s1 = bb1 ]
  | bb1 = bb1
    [ bb1 = {[@expl:loop invariant] [%#sformula'1] forall k: int. 0 <= k /\ k < UInt64.t'int i
        -> sat (Seq.get (view_Vec_Clause_Global self.clauses) k) a}
