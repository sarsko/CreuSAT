axiom inv_spec: forall self: t_Formula [inv'1 self]. [%#slogic_formula] inv'1 self = inv_mirror self

predicate inv'2 [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_assignments.rs" 45 4 45 40] (self: t_Assignments) (f: t_Formula) =
