predicate complete_inner [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_assignments.rs" 31 0 31 52] (a: Seq.seq UInt8.t) =
  [%#slogic_assignments'1] forall i: int. 0 <= i /\ i < Seq.length a -> not unset (Seq.get a i)

predicate sat_inner'0 [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 164 4 164 57] (self: t_Clause) (a: Seq.seq UInt8.t) =
  [%#slogic_clause'5] exists i: int. 0 <= i
    /\ i < Seq.length (view_Clause self) /\ sat_inner (Seq.get (view_Clause self) i) a

predicate formula_sat_inner [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 30 0 30 72] (f: t_FormulaModel) (a: Seq.seq UInt8.t) =
  [%#slogic_formula'7] forall i: int. 0 <= i /\ i < Seq.length f.clauses'0 -> sat_inner'0 (Seq.get f.clauses'0 i) a

predicate eventually_sat_complete [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 38 0 38 55] (f: t_FormulaModel) =
  [%#slogic_formula'5] exists a2: Seq.seq UInt8.t. Seq.length a2 = f.num_vars'0
    /\ complete_inner a2 /\ formula_sat_inner f a2

predicate equisat_extension_inner [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 32 0 32 66] (c: t_Clause) (f: t_FormulaModel) =
  [%#slogic_clause'3] eventually_sat_complete f
  -> eventually_sat_complete { clauses'0 = Seq.snoc f.clauses'0 c; num_vars'0 = f.num_vars'0 }

predicate sat_inner'1 [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 104 4 104 57] (self: t_Formula) (a: Seq.seq UInt8.t) =
  [%#slogic_formula'8] forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Clause_Global self.clauses)
    -> sat_inner'0 (Seq.get (view_Vec_Clause_Global self.clauses) i) a

predicate eventually_sat_complete'0 [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 54 4 54 48] (self: t_Formula) =
  [%#slogic_formula'6] exists a2: Seq.seq UInt8.t. Seq.length a2 = UInt64.t'int self.num_vars
    /\ complete_inner a2 /\ sat_inner'1 self a2

predicate equisat [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 61 4 61 44] (self: t_Formula) (o: t_Formula) =
  [%#slogic_formula'2] eventually_sat_complete'0 self = eventually_sat_complete'0 o

meta "compute_max_steps" 1000000

