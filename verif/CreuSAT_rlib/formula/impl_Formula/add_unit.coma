let rec add_unit [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/formula.rs" 178 4 178 67]
  (self: MutBorrow.t t_Formula) (clause: t_Clause) (_t: t_Trail) (return (x: UInt64.t)) =
  {[@stop_split] [@expl:add_unit requires] ([@stop_split] [@expl:add_unit requires #0] [%#sformula'2] inv'1 self.current)
  /\ ([@stop_split] [@expl:add_unit requires #1] [%#sformula'3] inv'4 _t self.current)
  /\ ([@stop_split] [@expl:add_unit requires #2] [%#sformula'4] Seq.length (view_Clause clause) = 1)
  /\ ([@stop_split] [@expl:add_unit requires #3] [%#sformula'5] inv'0 clause (UInt64.t'int self.current.num_vars))
  /\ ([@stop_split] [@expl:add_unit requires #4] [%#sformula'6] UInt64.t'int self.current.num_vars
    < ComputerDivision.div (UInt64.t'int const_MAX) 2)
  /\ ([@stop_split] [@expl:add_unit requires #5] [%#sformula'7] vars_in_range_inner (view_Clause clause) (UInt64.t'int self.current.num_vars))
  /\ ([@stop_split] [@expl:add_unit requires #6] [%#sformula'8] no_duplicate_indexes_inner (view_Clause clause))
  /\ ([@stop_split] [@expl:add_unit requires #7] [%#sformula'9] equisat_extension_inner clause (view_Formula self.current))}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &old_self <- [%#sformula] self ] s1
    | s1 = len_Clause [%#sformula'0] {self.current.clauses} (fun (_x: UInt64.t) -> [ &cref <- _x ] s2)
    | s2 = MutBorrow.borrow_final <t_Vec_Clause_Global> {self.current.clauses}
        {MutBorrow.inherit_id (MutBorrow.get_id self) 0}
        (fun (_bor: MutBorrow.t t_Vec_Clause_Global) ->
          [ &_47 <- _bor ] [ &self <- { self with current = { self.current with clauses = _bor.final } } ] s3)
    | s3 = push_Clause [%#sformula'1] {_47} {clause} (fun (_x: ()) -> [ &_46 <- _x ] s4)
    | s4 = -{resolve_refmut_Formula self}- s5
    | s5 = [ &_ret <- cref ] s6
    | s6 = return {_ret} ] ]
  [ & _ret: UInt64.t = Any.any_l ()
  | & self: MutBorrow.t t_Formula = self
  | & clause: t_Clause = clause
  | & old_self: MutBorrow.t t_Formula = Any.any_l ()
  | & cref: UInt64.t = Any.any_l ()
  | & _46: () = Any.any_l ()
  | & _47: MutBorrow.t t_Vec_Clause_Global = Any.any_l () ])
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:add_unit ensures] ([@stop_split] [@expl:add_unit ensures #0] [%#sformula'2] inv'1 self.final)
    /\ ([@stop_split] [@expl:add_unit ensures #1] [%#sformula'3] inv'4 _t self.final)
    /\ ([@stop_split] [@expl:add_unit ensures #2] [%#sformula'10] UInt64.t'int self.current.num_vars
      = UInt64.t'int self.final.num_vars)
    /\ ([@stop_split] [@expl:add_unit ensures #3] [%#sformula'11] forall i: int. 0 <= i
          /\ i < Seq.length (view_Vec_Clause_Global self.current.clauses)
        -> Seq.get (view_Vec_Clause_Global self.current.clauses) i
        = Seq.get (view_Vec_Clause_Global self.final.clauses) i)
    /\ ([@stop_split] [@expl:add_unit ensures #4] [%#sformula'12] equisat self.current self.final)
    /\ ([@stop_split] [@expl:add_unit ensures #5] [%#sformula'13] UInt64.t'int result
      = Seq.length (view_Vec_Clause_Global self.current.clauses))
    /\ ([@stop_split] [@expl:add_unit ensures #6] [%#sformula'14] Seq.length (view_Clause (Seq.get (view_Vec_Clause_Global self.final.clauses) (UInt64.t'int result)))
      = 1)
    /\ ([@stop_split] [@expl:add_unit ensures #7] [%#sformula'15] Seq.length (view_Vec_Clause_Global self.current.clauses)
      + 1
    = Seq.length (view_Vec_Clause_Global self.final.clauses))}
    (! return {result}) ]
