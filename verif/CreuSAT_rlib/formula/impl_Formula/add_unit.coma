  [%#slogic_lit'3] sat_inner self (view_Assignments a)

predicate unit_are_sat [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_trail.rs" 160 0 160 73] (trail'0: Seq.seq t_Step) (f: t_Formula) (a: t_Assignments) =
  [%#slogic_trail'5] forall j: int. 0 <= j /\ j < Seq.length trail'0
    -> match (Seq.get trail'0 j).reason with
      | Unit k -> (Seq.get trail'0 j).lit
        = Seq.get (view_Clause (Seq.get (view_Vec_Clause_Global f.clauses) (UInt64.t'int k))) 0
      /\ sat (Seq.get (view_Clause (Seq.get (view_Vec_Clause_Global f.clauses) (UInt64.t'int k))) 0) a
      | _ -> true
      end

predicate inv'4 [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_trail.rs" 49 4 49 40] [@inline:trivial] (self: t_Trail) (f: t_Formula) =
  [%#slogic_trail] inv'2 self.assignments f
  /\ trail_invariant (view_Vec_Step_Global self.trail) f
  /\ Seq.length (view_Vec_usize_Global self.lit_to_level) = UInt64.t'int f.num_vars
  /\ lit_not_in_less_inner (view_Vec_Step_Global self.trail) f
  /\ lit_is_unique_inner (view_Vec_Step_Global self.trail)
  /\ long_are_post_unit_inner (view_Vec_Step_Global self.trail) f (view_Assignments self.assignments)
  /\ trail_entries_are_assigned_inner (view_Vec_Step_Global self.trail) (view_Assignments self.assignments)
  /\ sorted (view_Vec_usize_Global self.decisions)
  /\ unit_are_sat (view_Vec_Step_Global self.trail) f self.assignments
  /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_usize_Global self.decisions)
    -> UInt64.t'int (Seq.get (view_Vec_usize_Global self.decisions) i) <= Seq.length (view_Vec_Step_Global self.trail))

meta "rewrite_def" predicate inv'4

