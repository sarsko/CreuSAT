axiom view_Vec_Step_Global_spec: forall self: t_Vec_Step_Global. [%#svec'1] Seq.length (view_Vec_Step_Global self)
    <= UInt64.t'int const_MAX

function view_Vec_usize_Global (self: t_Vec_usize_Global) : Seq.seq UInt64.t

axiom view_Vec_usize_Global_spec: forall self: t_Vec_usize_Global. [%#svec'1] Seq.length (view_Vec_usize_Global self)
    <= UInt64.t'int const_MAX

predicate lit_idx_in [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_lit.rs" 58 4 58 46] (self: t_Lit) (c: t_Clause) =
  [%#slogic_lit'1] exists i: int. 0 <= i
    /\ i < Seq.length (view_Clause c) /\ index (Seq.get (view_Clause c) i) = index self

predicate lit_not_in_less_inner [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_trail.rs" 81 0 81 62] (t: Seq.seq t_Step) (f: t_Formula) =
