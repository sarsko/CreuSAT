let rec len_Clause (self_: t_Vec_Clause_Global) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#svec] UInt64.t'int result
    = Seq.length (view_Vec_Clause_Global self_)}
    (! return {result}) ]

let rec push_Clause (self_: MutBorrow.t t_Vec_Clause_Global) (v: t_Clause) (return (x: ())) = any
  [ return (result: ()) -> {[@stop_split] [@expl:push ensures] [%#svec'0] view_Vec_Clause_Global self_.final
    = Seq.snoc (view_Vec_Clause_Global self_.current) v}
    (! return {result}) ]

