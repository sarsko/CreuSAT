type t_Vec_Clause_Global

type t_Formula = { clauses: t_Vec_Clause_Global; num_vars: UInt64.t }

type t_Vec_Lit_Global

type t_Clause = { deleted: bool; lbd: UInt32.t; search: UInt64.t; lits: t_Vec_Lit_Global }

predicate in_bounds_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_Clause) =
  [%#sslice] UInt64.t'int self < Seq.length seq

meta "rewrite_def" predicate in_bounds_usize

constant const_MAX: UInt64.t = [%#suint_macros] (18446744073709551615: UInt64.t)

function view_Vec_Clause_Global (self: t_Vec_Clause_Global) : Seq.seq t_Clause

axiom view_Vec_Clause_Global_spec:
  forall self: t_Vec_Clause_Global [view_Vec_Clause_Global self]. [%#svec'4] Seq.length (view_Vec_Clause_Global self)
    <= UInt64.t'int const_MAX

predicate has_value_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_Clause) (out: t_Clause) =
  [%#sslice'0] Seq.get seq (UInt64.t'int self) = out

meta "rewrite_def" predicate has_value_usize

predicate resolve_elswhere_usize [@inline:trivial] (self: UInt64.t) (old': Seq.seq t_Clause) (fin: Seq.seq t_Clause) =
  [%#sslice'1] forall i: int. 0 <= i /\ i <> UInt64.t'int self /\ i < Seq.length old' -> Seq.get old' i = Seq.get fin i

meta "rewrite_def" predicate resolve_elswhere_usize

let index_mut_Vec_Clause_Global (self_: MutBorrow.t t_Vec_Clause_Global) (ix: UInt64.t)
  (return (x: MutBorrow.t t_Clause)) =
{[@stop_split] [@expl:index_mut requires] [%#svec] in_bounds_usize ix (view_Vec_Clause_Global self_.current)}
  any
  [ return (result: MutBorrow.t t_Clause) ->
  {[@stop_split] [@expl:index_mut_Vec_Clause_Global ensures] ([@stop_split] [@expl:index_mut ensures #0] [%#svec'0] has_value_usize ix (view_Vec_Clause_Global self_.current) result.current)
    /\ ([@stop_split] [@expl:index_mut ensures #1] [%#svec'1] has_value_usize ix (view_Vec_Clause_Global self_.final) result.final)
    /\ ([@stop_split] [@expl:index_mut ensures #2] [%#svec'2] resolve_elswhere_usize ix (view_Vec_Clause_Global self_.current) (view_Vec_Clause_Global self_.final))
    /\ ([@stop_split] [@expl:index_mut ensures #3] [%#svec'3] Seq.length (view_Vec_Clause_Global self_.final)
    = Seq.length (view_Vec_Clause_Global self_.current))}
    (! return {result}) ]

predicate resolve_refmut_Clause [@inline:trivial] (_1: MutBorrow.t t_Clause) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Clause

predicate resolve_refmut_Formula [@inline:trivial] (_1: MutBorrow.t t_Formula) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Formula

type t_FormulaModel = { clauses'0: Seq.seq t_Clause; num_vars'0: int }

function view_Formula [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 16 4 16 33] (self: t_Formula) : t_FormulaModel
 = [%#slogic_formula] { clauses'0 = view_Vec_Clause_Global self.clauses; num_vars'0 = UInt64.t'int self.num_vars }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

