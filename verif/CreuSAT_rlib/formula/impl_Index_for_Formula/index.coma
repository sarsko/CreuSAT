use creusot.int.UInt64
use creusot.int.UInt32
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_Vec_Clause_Global

type t_Formula = { clauses: t_Vec_Clause_Global; num_vars: UInt64.t }

type t_Vec_Lit_Global

type t_Clause = { deleted: bool; lbd: UInt32.t; search: UInt64.t; lits: t_Vec_Lit_Global }

predicate in_bounds_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_Clause) =
  [%#sslice] UInt64.t'int self < Seq.length seq

meta "rewrite_def" predicate in_bounds_usize

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Clause_Global (self: t_Vec_Clause_Global) : Seq.seq t_Clause

axiom view_Vec_Clause_Global_spec: forall self: t_Vec_Clause_Global. [%#svec'1] Seq.length (view_Vec_Clause_Global self)
    <= UInt64.t'int const_MAX

predicate has_value_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_Clause) (out: t_Clause) =
  [%#sslice'0] Seq.get seq (UInt64.t'int self) = out

meta "rewrite_def" predicate has_value_usize

let rec index_Vec_Clause_Global (self_: t_Vec_Clause_Global) (ix: UInt64.t) (return (x: t_Clause)) =
  {[@stop_split] [@expl:index requires] [%#svec] in_bounds_usize ix (view_Vec_Clause_Global self_)}
  any
  [ return (result: t_Clause) ->
  {[@stop_split] [@expl:index ensures] [%#svec'0] has_value_usize ix (view_Vec_Clause_Global self_) result}
    (! return {result}) ]

type t_FormulaModel = { clauses'0: Seq.seq t_Clause; num_vars'0: int }

function view_Formula [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 16 4 16 33] (self: t_Formula) : t_FormulaModel
 = [%#slogic_formula] { clauses'0 = view_Vec_Clause_Global self.clauses; num_vars'0 = UInt64.t'int self.num_vars }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec index_Formula [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/formula.rs" 29 4 29 41] (self: t_Formula)
  (ix: UInt64.t) (return (x: t_Clause)) = {[@stop_split] [@expl:index requires] [%#sformula'0] UInt64.t'int ix
  < Seq.length (view_Formula self).clauses'0}
  (! bb0
  [ bb0 = s0
    [ s0 = index_Vec_Clause_Global [%#sformula] {self.clauses} {ix} (fun (_x: t_Clause) -> [ &_10 <- _x ] s1)
    | s1 = [ &_9 <- _10 ] s2
    | s2 = [ &_ret <- _9 ] s3
    | s3 = return {_ret} ] ]
  [ & _ret: t_Clause = Any.any_l ()
  | & self: t_Formula = self
  | & ix: UInt64.t = ix
  | & _9: t_Clause = Any.any_l ()
  | & _10: t_Clause = Any.any_l () ])
  [ return (result: t_Clause) ->
  {[@stop_split] [@expl:index ensures] [%#sformula'1] Seq.get (view_Formula self).clauses'0 (UInt64.t'int ix) = result}
    (! return {result}) ]
