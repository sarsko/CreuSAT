constant const_MAX: UInt64.t = [%#suint_macros] (18446744073709551615: UInt64.t)

constant const_INVALID: UInt64.t = [%#sdecision'15] const_MAX

type t_Vec_u8_Global

type t_Assignments = { f0: t_Vec_u8_Global }

function view_Vec_u8_Global (self: t_Vec_u8_Global) : Seq.seq UInt8.t

axiom view_Vec_u8_Global_spec:
  forall self: t_Vec_u8_Global [view_Vec_u8_Global self]. [%#svec'1] Seq.length (view_Vec_u8_Global self)
    <= UInt64.t'int const_MAX

function view_Assignments [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_assignments.rs" 17 4 17 33] (self: t_Assignments) : Seq.seq UInt8.t
 = [%#slogic_assignments] view_Vec_u8_Global self.f0

let index_Assignments (self: t_Assignments) (ix: UInt64.t) (return (x: UInt8.t)) =
{[@stop_split] [@expl:index requires] [%#sassignments] UInt64.t'int ix < Seq.length (view_Assignments self)}
  any
  [ return (result: UInt8.t) ->
  {[@stop_split] [@expl:index ensures] [%#sassignments'0] Seq.get (view_Assignments self) (UInt64.t'int ix) = result}
    (! return {result}) ]

type t_Node = { next: UInt64.t; prev: UInt64.t; ts: UInt64.t }

predicate in_bounds_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_Node) =
  [%#sslice] UInt64.t'int self < Seq.length seq

meta "rewrite_def" predicate in_bounds_usize

function view_Vec_Node_Global (self: t_Vec_Node_Global) : Seq.seq t_Node

axiom view_Vec_Node_Global_spec:
  forall self: t_Vec_Node_Global [view_Vec_Node_Global self]. [%#svec'1] Seq.length (view_Vec_Node_Global self)
    <= UInt64.t'int const_MAX

predicate has_value_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_Node) (out: t_Node) =
  [%#sslice'0] Seq.get seq (UInt64.t'int self) = out

meta "rewrite_def" predicate has_value_usize

let index_Vec_Node_Global (self_: t_Vec_Node_Global) (ix: UInt64.t) (return (x: t_Node)) =
{[@stop_split] [@expl:index requires] [%#svec] in_bounds_usize ix (view_Vec_Node_Global self_)}
  any
  [ return (result: t_Node) ->
  {[@stop_split] [@expl:index ensures] [%#svec'0] has_value_usize ix (view_Vec_Node_Global self_) result}
    (! return {result}) ]

predicate resolve_refmut_Decisions [@inline:trivial] (_1: MutBorrow.t t_Decisions) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Decisions

type t_Option_usize = None | Some UInt64.t

let len (self: t_Assignments) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sassignments'1] UInt64.t'int result
    = Seq.length (view_Assignments self)}
    (! return {result}) ]

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate unset [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic.rs" 18 0 18 38] (v: UInt8.t) =
  [%#slogic] if ge_log_Int (UInt8.t'int v) 2 then true else false

type t_Vec_Clause_Global

type t_Formula = { clauses: t_Vec_Clause_Global; num_vars: UInt64.t }

predicate inv [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_decision.rs" 7 4 7 36] (self: t_Decisions) (n: int) =
  [%#slogic_decision] Seq.length (view_Vec_Node_Global self.linked_list) = n
  /\ (UInt64.t'int self.search < Seq.length (view_Vec_Node_Global self.linked_list)
    \/ UInt64.t'int self.search = UInt64.t'int const_MAX)
  /\ UInt64.t'int self.start < Seq.length (view_Vec_Node_Global self.linked_list)
  /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Node_Global self.linked_list)
    -> (UInt64.t'int (Seq.get (view_Vec_Node_Global self.linked_list) i).next = UInt64.t'int const_MAX
      \/ UInt64.t'int (Seq.get (view_Vec_Node_Global self.linked_list) i).next < n)
    /\ (UInt64.t'int (Seq.get (view_Vec_Node_Global self.linked_list) i).prev = UInt64.t'int const_MAX
    \/ UInt64.t'int (Seq.get (view_Vec_Node_Global self.linked_list) i).prev < n))

predicate inv'0 [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_assignments.rs" 45 4 45 40] (self: t_Assignments) (f: t_Formula) =
  [%#slogic_assignments'0] UInt64.t'int f.num_vars = Seq.length (view_Assignments self)
  /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Assignments self)
    -> UInt8.t'int (Seq.get (view_Assignments self) i) <= 3)

predicate complete [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_assignments.rs" 53 4 53 33] (self: t_Assignments) =
  [%#slogic_assignments'1] forall i: int. 0 <= i /\ i < Seq.length (view_Assignments self)
    -> not unset (Seq.get (view_Assignments self) i)

