  {[@stop_split] [@expl:rescore ensures] ([@stop_split] [@expl:rescore ensures #0] [%#sdecision'15] inv self.final (UInt64.t'int _f.num_vars))
    /\ ([@stop_split] [@expl:rescore ensures #1] [%#sdecision'17] UInt64.t'int self.final.timestamp
      = Seq.length (view_Vec_Node_Global self.current.linked_list) + 1)
