    /\ ([@stop_split] [@expl:index_mut ensures #1] [%#svec'1] has_value_usize ix (view_Vec_Node_Global self_.final) result.final)
    /\ ([@stop_split] [@expl:index_mut ensures #2] [%#svec'2] resolve_elswhere_usize ix (view_Vec_Node_Global self_.current) (view_Vec_Node_Global self_.final))
    /\ ([@stop_split] [@expl:index_mut ensures #3] [%#svec'3] Seq.length (view_Vec_Node_Global self_.final)
    = Seq.length (view_Vec_Node_Global self_.current))}
    (! return {result}) ]

