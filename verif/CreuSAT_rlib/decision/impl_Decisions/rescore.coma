type t_Vec_Node_Global

type t_Decisions = { linked_list: t_Vec_Node_Global; timestamp: UInt64.t; start: UInt64.t; search: UInt64.t }

type t_Node = { next: UInt64.t; prev: UInt64.t; ts: UInt64.t }

constant const_MAX: UInt64.t = [%#suint_macros] (18446744073709551615: UInt64.t)

function view_Vec_Node_Global (self: t_Vec_Node_Global) : Seq.seq t_Node

axiom view_Vec_Node_Global_spec:
  forall self: t_Vec_Node_Global [view_Vec_Node_Global self]. [%#svec'0] Seq.length (view_Vec_Node_Global self)
    <= UInt64.t'int const_MAX

let len_Node (self_: t_Vec_Node_Global) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#svec] UInt64.t'int result
    = Seq.length (view_Vec_Node_Global self_)}
    (! return {result}) ]

constant const_INVALID: UInt64.t = [%#sdecision'17] const_MAX

predicate inv [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_decision.rs" 7 4 7 36] (self: t_Decisions) (n: int) =
  [%#slogic_decision] Seq.length (view_Vec_Node_Global self.linked_list) = n
  /\ (UInt64.t'int self.search < Seq.length (view_Vec_Node_Global self.linked_list)
    \/ UInt64.t'int self.search = UInt64.t'int const_MAX)
  /\ UInt64.t'int self.start < Seq.length (view_Vec_Node_Global self.linked_list)
  /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Node_Global self.linked_list)
    -> (UInt64.t'int (Seq.get (view_Vec_Node_Global self.linked_list) i).next = UInt64.t'int const_MAX
      \/ UInt64.t'int (Seq.get (view_Vec_Node_Global self.linked_list) i).next < n)
    /\ (UInt64.t'int (Seq.get (view_Vec_Node_Global self.linked_list) i).prev = UInt64.t'int const_MAX
    \/ UInt64.t'int (Seq.get (view_Vec_Node_Global self.linked_list) i).prev < n))

type t_Vec_Clause_Global

type t_Formula = { clauses: t_Vec_Clause_Global; num_vars: UInt64.t }

predicate in_bounds_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_Node) =
  [%#sslice] UInt64.t'int self < Seq.length seq

meta "rewrite_def" predicate in_bounds_usize

predicate has_value_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_Node) (out: t_Node) =
  [%#sslice'0] Seq.get seq (UInt64.t'int self) = out

meta "rewrite_def" predicate has_value_usize

predicate resolve_elswhere_usize [@inline:trivial] (self: UInt64.t) (old': Seq.seq t_Node) (fin: Seq.seq t_Node) =
  [%#sslice'1] forall i: int. 0 <= i /\ i <> UInt64.t'int self /\ i < Seq.length old' -> Seq.get old' i = Seq.get fin i

meta "rewrite_def" predicate resolve_elswhere_usize

let index_mut_Vec_Node_Global (self_: MutBorrow.t t_Vec_Node_Global) (ix: UInt64.t) (return (x: MutBorrow.t t_Node)) =
{[@stop_split] [@expl:index_mut requires] [%#svec'1] in_bounds_usize ix (view_Vec_Node_Global self_.current)}
  any
  [ return (result: MutBorrow.t t_Node) ->
  {[@stop_split] [@expl:index_mut_Vec_Node_Global ensures] ([@stop_split] [@expl:index_mut ensures #0] [%#svec'2] has_value_usize ix (view_Vec_Node_Global self_.current) result.current)
    /\ ([@stop_split] [@expl:index_mut ensures #1] [%#svec'3] has_value_usize ix (view_Vec_Node_Global self_.final) result.final)
    /\ ([@stop_split] [@expl:index_mut ensures #2] [%#svec'4] resolve_elswhere_usize ix (view_Vec_Node_Global self_.current) (view_Vec_Node_Global self_.final))
    /\ ([@stop_split] [@expl:index_mut ensures #3] [%#svec'5] Seq.length (view_Vec_Node_Global self_.final)
    = Seq.length (view_Vec_Node_Global self_.current))}
    (! return {result}) ]

predicate resolve_refmut_Node [@inline:trivial] (_1: MutBorrow.t t_Node) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Node

let index_Vec_Node_Global (self_: t_Vec_Node_Global) (ix: UInt64.t) (return (x: t_Node)) =
{[@stop_split] [@expl:index requires] [%#svec'6] in_bounds_usize ix (view_Vec_Node_Global self_)}
  any
  [ return (result: t_Node) ->
  {[@stop_split] [@expl:index ensures] [%#svec'7] has_value_usize ix (view_Vec_Node_Global self_) result}
    (! return {result}) ]

predicate resolve_refmut_Decisions [@inline:trivial] (_1: MutBorrow.t t_Decisions) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Decisions

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

