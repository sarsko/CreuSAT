  [%#slogic_lit] index self < n

predicate vars_in_range_inner [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 19 0 19 55] (s: Seq.seq t_Lit) (n: int) =
  [%#slogic_clause'2] forall i: int. 0 <= i /\ i < Seq.length s -> inv (Seq.get s i) n

predicate no_duplicate_indexes_inner [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 39 0 39 54] (s: Seq.seq t_Lit) =
  [%#slogic_clause'3] forall j: int, k: int. 0 <= j /\ j < Seq.length s /\ 0 <= k /\ k < Seq.length s /\ k <> j
    -> index (Seq.get s k) <> index (Seq.get s j)

predicate inv_internal [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 27 0 27 48] (s: Seq.seq t_Lit) (n: int) =
  [%#slogic_clause'1] vars_in_range_inner s n /\ no_duplicate_indexes_inner s

function view_Vec_Lit_Global (self: t_Vec_Lit_Global) : Seq.seq t_Lit

axiom view_Vec_Lit_Global_spec:
  forall self: t_Vec_Lit_Global [view_Vec_Lit_Global self]. [%#svec'2] Seq.length (view_Vec_Lit_Global self)
    <= UInt64.t'int const_MAX

function view_Clause [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 13 4 13 33] (self: t_Clause) : Seq.seq t_Lit
 = [%#slogic_clause'0] view_Vec_Lit_Global self.lits'0

predicate inv'0 [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 199 4 199 36] (self: t_Clause) (n: int) =
  [%#slogic_clause] inv_internal (view_Clause self) n

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate inv_mirror [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 73 4 73 35] (self: t_Formula) =
  [%#slogic_formula'1] (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Clause_Global self.clauses)
      -> inv'0 (Seq.get (view_Vec_Clause_Global self.clauses) i) (UInt64.t'int self.num_vars))
  /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Clause_Global self.clauses)
    -> ge_log_Int (Seq.length (view_Clause (Seq.get (view_Vec_Clause_Global self.clauses) i))) 1)

type t_FormulaModel = { clauses'0: Seq.seq t_Clause; num_vars'0: int }

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate formula_invariant [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 22 0 22 49] (f: t_FormulaModel) =
  [%#slogic_formula'2] forall i: int. 0 <= i /\ i < Seq.length f.clauses'0
    -> inv'0 (Seq.get f.clauses'0 i) f.num_vars'0 /\ gt_log_Int (Seq.length (view_Clause (Seq.get f.clauses'0 i))) 0

function view_Formula [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 16 4 16 33] (self: t_Formula) : t_FormulaModel
 = [%#slogic_formula'3] { clauses'0 = view_Vec_Clause_Global self.clauses; num_vars'0 = UInt64.t'int self.num_vars }

predicate inv'1 [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 68 4 68 28] (self: t_Formula) =
  [%#slogic_formula'0] formula_invariant (view_Formula self)

axiom inv_spec: forall self: t_Formula [inv'1 self]. [%#slogic_formula] inv'1 self = inv_mirror self

predicate inv'2 [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_decision.rs" 7 4 7 36] (self: t_Decisions) (n: int) =
  [%#slogic_decision] Seq.length (view_Vec_Node_Global self.linked_list) = n
  /\ (UInt64.t'int self.search < Seq.length (view_Vec_Node_Global self.linked_list)
    \/ UInt64.t'int self.search = UInt64.t'int const_MAX)
  /\ UInt64.t'int self.start < Seq.length (view_Vec_Node_Global self.linked_list)
  /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Node_Global self.linked_list)
    -> (UInt64.t'int (Seq.get (view_Vec_Node_Global self.linked_list) i).next = UInt64.t'int const_MAX
      \/ UInt64.t'int (Seq.get (view_Vec_Node_Global self.linked_list) i).next < n)
    /\ (UInt64.t'int (Seq.get (view_Vec_Node_Global self.linked_list) i).prev = UInt64.t'int const_MAX
    \/ UInt64.t'int (Seq.get (view_Vec_Node_Global self.linked_list) i).prev < n))

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let make_linked_list [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/decision.rs" 41 4 41 76]
  (f: t_Formula) (lit_order: t_Vec_usize_Global) (return (x: t_Decisions)) =
{[@stop_split] [@expl:make_linked_list requires] ([@stop_split] [@expl:make_linked_list requires #0] [%#sdecision'37] inv'1 f)
  /\ ([@stop_split] [@expl:make_linked_list requires #1] [%#sdecision'38] 0 < UInt64.t'int f.num_vars
    /\ UInt64.t'int f.num_vars < ComputerDivision.div (UInt64.t'int const_MAX) 2)
