  [%#sslice'0] Seq.get seq (UInt64.t'int self) = out

meta "rewrite_def" predicate has_value_usize

let index_Vec_usize_Global (self_: t_Vec_usize_Global) (ix: UInt64.t) (return (x: UInt64.t)) =
{[@stop_split] [@expl:index requires] [%#svec'3] in_bounds_usize ix (view_Vec_usize_Global self_)}
  any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:index ensures] [%#svec'4] has_value_usize ix (view_Vec_usize_Global self_) result}
    (! return {result}) ]

predicate in_bounds_usize'0 [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_Node) =
  [%#sslice] UInt64.t'int self < Seq.length seq

meta "rewrite_def" predicate in_bounds_usize'0

predicate has_value_usize'0 [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_Node) (out: t_Node) =
  [%#sslice'0] Seq.get seq (UInt64.t'int self) = out

meta "rewrite_def" predicate has_value_usize'0

predicate resolve_elswhere_usize [@inline:trivial] (self: UInt64.t) (old': Seq.seq t_Node) (fin: Seq.seq t_Node) =
  [%#sslice'1] forall i: int. 0 <= i /\ i <> UInt64.t'int self /\ i < Seq.length old' -> Seq.get old' i = Seq.get fin i

meta "rewrite_def" predicate resolve_elswhere_usize

let index_mut_Vec_Node_Global (self_: MutBorrow.t t_Vec_Node_Global) (ix: UInt64.t) (return (x: MutBorrow.t t_Node)) =
{[@stop_split] [@expl:index_mut requires] [%#svec'5] in_bounds_usize'0 ix (view_Vec_Node_Global self_.current)}
  any
  [ return (result: MutBorrow.t t_Node) ->
  {[@stop_split] [@expl:index_mut_Vec_Node_Global ensures] ([@stop_split] [@expl:index_mut ensures #0] [%#svec'6] has_value_usize'0 ix (view_Vec_Node_Global self_.current) result.current)
    /\ ([@stop_split] [@expl:index_mut ensures #1] [%#svec'7] has_value_usize'0 ix (view_Vec_Node_Global self_.final) result.final)
    /\ ([@stop_split] [@expl:index_mut ensures #2] [%#svec'8] resolve_elswhere_usize ix (view_Vec_Node_Global self_.current) (view_Vec_Node_Global self_.final))
    /\ ([@stop_split] [@expl:index_mut ensures #3] [%#svec'9] Seq.length (view_Vec_Node_Global self_.final)
    = Seq.length (view_Vec_Node_Global self_.current))}
    (! return {result}) ]

predicate resolve_refmut_Node [@inline:trivial] (_1: MutBorrow.t t_Node) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Node

