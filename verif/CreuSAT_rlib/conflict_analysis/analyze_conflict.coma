        /\ no_duplicate_indexes_inner (view_Clause clause)
        /\ equisat_extension_inner clause (view_Formula f) /\ UInt64.t'int s_idx < Seq.length (view_Clause clause)
        | Restart'0 clause -> inv'0 clause (UInt64.t'int f.num_vars)
        /\ gt_log_Int (Seq.length (view_Clause clause)) 1
        /\ vars_in_range_inner (view_Clause clause) (UInt64.t'int f.num_vars)
        /\ no_duplicate_indexes_inner (view_Clause clause) /\ equisat_extension_inner clause (view_Formula f)
        end)
    /\ ([@stop_split] [@expl:analyze_conflict ensures #1] [%#sconflict_analysis'67] inv'5 d.final (UInt64.t'int f.num_vars))}
    (! return {result}) ]
