use creusot.int.UInt64
use seq.Seq
use creusot.int.UInt32
use creusot.prelude.MutBorrow
use creusot.int.UInt8
use creusot.prelude.Any
use int.Int

type t_Vec_u8_Global

type t_Assignments = { f0: t_Vec_u8_Global }

type t_Vec_usize_Global

type t_Vec_Step_Global

type t_Trail = {
  assignments: t_Assignments;
  lit_to_level: t_Vec_usize_Global;
  trail: t_Vec_Step_Global;
  curr_i: UInt64.t;
  decisions: t_Vec_usize_Global }

constant const_MAX: UInt64.t = [%#suint_macros] (18446744073709551615: UInt64.t)

function view_Vec_usize_Global (self: t_Vec_usize_Global) : Seq.seq UInt64.t

axiom view_Vec_usize_Global_spec:
  forall self: t_Vec_usize_Global [view_Vec_usize_Global self]. [%#svec'4] Seq.length (view_Vec_usize_Global self)
    <= UInt64.t'int const_MAX

let decision_level (self: t_Trail) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:decision_level ensures] [%#strail] UInt64.t'int result
    = Seq.length (view_Vec_usize_Global self.decisions)}
    (! return {result}) ]

type t_Vec_Clause_Global

type t_Formula = { clauses: t_Vec_Clause_Global; num_vars: UInt64.t }

type t_Vec_bool_Global

function view_Vec_bool_Global (self: t_Vec_bool_Global) : Seq.seq bool

axiom view_Vec_bool_Global_spec:
  forall self: t_Vec_bool_Global [view_Vec_bool_Global self]. [%#svec'4] Seq.length (view_Vec_bool_Global self)
    <= UInt64.t'int const_MAX

predicate index_Vec_bool_Global [@inline:trivial] (self: t_Vec_bool_Global) (ix: int) =
  [%#svec'12] Seq.get (view_Vec_bool_Global self) ix

meta "rewrite_def" predicate index_Vec_bool_Global

let from_elem_bool (elem: bool) (n: UInt64.t) (return (x: t_Vec_bool_Global)) = any
  [ return (result: t_Vec_bool_Global) ->
