let rec unit_prop_step (self: MutBorrow.t t_Solver) (f: MutBorrow.t t_Formula) (d: MutBorrow.t t_Decisions)
  (t: MutBorrow.t t_Trail) (w: MutBorrow.t t_Watches) (return (x: t_ConflictResult)) =
