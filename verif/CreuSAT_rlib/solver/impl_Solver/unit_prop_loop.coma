    /\ UInt64.t'int cref'0 < Seq.length (view_Vec_Clause_Global f.clauses)
    /\ Seq.length (view_Clause (Seq.get (view_Vec_Clause_Global f.clauses) (UInt64.t'int cref'0))) > 1
    | Unit cref'0 -> 0 <= UInt64.t'int cref'0
    /\ UInt64.t'int cref'0 < Seq.length (view_Vec_Clause_Global f.clauses)
    /\ Seq.length (view_Clause (Seq.get (view_Vec_Clause_Global f.clauses) (UInt64.t'int cref'0))) = 1
