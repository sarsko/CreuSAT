    | s2 = s3 [ _ck -> (! {[@expl:type invariant] inv_refmut_Decisions d} any) ]
    | s3 = -{resolve_refmut_Decisions d}- s4
    | s4 = -{resolve_refmut_Formula f}- s5
    | s5 = -{resolve_refmut_Solver self}- s6
    | s6 = [ &_ret <- Some ([%#ssolver'12] true) ] s7
    | s7 = return {_ret} ] ]
  [ & _ret: t_Option_bool = Any.any_l ()
  | & self: MutBorrow.t t_Solver = self
  | & f: MutBorrow.t t_Formula = f
  | & d: MutBorrow.t t_Decisions = d
  | & t: MutBorrow.t t_Trail = t
  | & w: MutBorrow.t t_Watches = w
  | & old_f: MutBorrow.t t_Formula = Any.any_l ()
  | & old_t: MutBorrow.t t_Trail = Any.any_l ()
  | & old_w: MutBorrow.t t_Watches = Any.any_l ()
  | & old_d: MutBorrow.t t_Decisions = Any.any_l ()
  | & _70: t_ConflictResult = Any.any_l ()
  | & _71: MutBorrow.t t_Solver = Any.any_l ()
  | & _72: MutBorrow.t t_Formula = Any.any_l ()
  | & _73: MutBorrow.t t_Decisions = Any.any_l ()
  | & _74: MutBorrow.t t_Trail = Any.any_l ()
  | & _75: MutBorrow.t t_Watches = Any.any_l ()
  | & _old: t_Solver = Any.any_l ()
  | & _old'0: t_Formula = Any.any_l ()
  | & _old'1: t_Decisions = Any.any_l ()
  | & _old'2: t_Trail = Any.any_l ()
  | & _old'3: t_Watches = Any.any_l () ])
  [ return (result: t_Option_bool) ->
  {[@stop_split] [@expl:unit_prop_loop ensures] ([@stop_split] [@expl:unit_prop_loop ensures #0] [%#ssolver'14] inv'1 f.final)
    /\ ([@stop_split] [@expl:unit_prop_loop ensures #1] [%#ssolver'15] inv'5 t.final f.final)
    /\ ([@stop_split] [@expl:unit_prop_loop ensures #2] [%#ssolver'16] inv'2 w.final f.final)
    /\ ([@stop_split] [@expl:unit_prop_loop ensures #3] [%#ssolver'17] inv'6 d.final (UInt64.t'int f.current.num_vars))
    /\ ([@stop_split] [@expl:unit_prop_loop ensures #4] [%#ssolver'19] match result with
        | Some b -> if b then true else not_satisfiable f.final
        | None -> true
        end)
    /\ ([@stop_split] [@expl:unit_prop_loop ensures #5] [%#ssolver'20] UInt64.t'int f.current.num_vars
      = UInt64.t'int f.final.num_vars)
    /\ ([@stop_split] [@expl:unit_prop_loop ensures #6] [%#ssolver'21] equisat f.current f.final)}
    (! return {result}) ]
