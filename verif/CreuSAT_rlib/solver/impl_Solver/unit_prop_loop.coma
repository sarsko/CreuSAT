predicate watches_inv_internal [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_watches.rs" 9 0 9 77] (w: Seq.seq t_Vec_Watcher_Global) (n: int) (f: t_Formula) =
