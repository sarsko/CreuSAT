  /\ ([@stop_split] [@expl:unit_prop_step requires #0] [%#ssolver'23] inv'1 f.current)
  /\ ([@stop_split] [@expl:unit_prop_step requires #1] [%#ssolver'24] inv'2 w.current f.current)
  /\ ([@stop_split] [@expl:unit_prop_step requires #2] [%#ssolver'25] inv'5 t.current f.current)
  /\ ([@stop_split] [@expl:unit_prop_step requires #3] [%#ssolver'26] inv'6 d.current (UInt64.t'int f.current.num_vars))
  /\ ([@stop_split] [@expl:unit_prop_step requires #4] [%#ssolver'27] UInt64.t'int f.current.num_vars
  < ComputerDivision.div (UInt64.t'int const_MAX) 2)}
  any
  [ return (result: t_ConflictResult) ->
  {[@stop_split] [@expl:unit_prop_step ensures] ([@stop_split] [@expl:unit_prop_step ensures #0] [%#ssolver'23] inv'1 f.final)
    /\ ([@stop_split] [@expl:unit_prop_step ensures #1] [%#ssolver'24] inv'2 w.final f.final)
    /\ ([@stop_split] [@expl:unit_prop_step ensures #2] [%#ssolver'25] inv'5 t.final f.final)
    /\ ([@stop_split] [@expl:unit_prop_step ensures #3] [%#ssolver'26] inv'6 d.final (UInt64.t'int f.current.num_vars))
    /\ ([@stop_split] [@expl:unit_prop_step ensures #4] [%#ssolver'28] UInt64.t'int f.current.num_vars
      = UInt64.t'int f.final.num_vars)
    /\ ([@stop_split] [@expl:unit_prop_step ensures #5] [%#ssolver'29] equisat f.current f.final)
    /\ ([@stop_split] [@expl:unit_prop_step ensures #6] [%#ssolver'30] match result with
      | Ground -> not_satisfiable f.final
      | _ -> true
      end)}
    (! return {result}) ]

