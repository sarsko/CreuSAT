let rec unit_prop_loop (self: MutBorrow.t t_Solver) (f: MutBorrow.t t_Formula) (d: MutBorrow.t t_Decisions)
  (t: MutBorrow.t t_Trail) (w: MutBorrow.t t_Watches) (return (x: t_Option_bool)) =
  {[@stop_split] [@expl:unit_prop_loop requires] ([@stop_split] [@expl:unit_prop_loop 'd' type invariant] [%#ssolver'26] inv_refmut_Decisions d)
  /\ ([@stop_split] [@expl:unit_prop_loop requires #0] [%#ssolver'27] inv'1 f.current)
  /\ ([@stop_split] [@expl:unit_prop_loop requires #1] [%#ssolver'28] inv'4 t.current f.current)
  /\ ([@stop_split] [@expl:unit_prop_loop requires #2] [%#ssolver'29] inv'5 w.current f.current)
  /\ ([@stop_split] [@expl:unit_prop_loop requires #3] [%#ssolver'30] inv'6 d.current (UInt64.t'int f.current.num_vars))
  /\ ([@stop_split] [@expl:unit_prop_loop requires #4] [%#ssolver'31] UInt64.t'int f.current.num_vars
  < ComputerDivision.div (UInt64.t'int const_MAX) 2)}
  any
  [ return (result: t_Option_bool) ->
  {[@stop_split] [@expl:unit_prop_loop ensures] ([@stop_split] [@expl:unit_prop_loop ensures #0] [%#ssolver'27] inv'1 f.final)
    /\ ([@stop_split] [@expl:unit_prop_loop ensures #1] [%#ssolver'28] inv'4 t.final f.final)
    /\ ([@stop_split] [@expl:unit_prop_loop ensures #2] [%#ssolver'29] inv'5 w.final f.final)
    /\ ([@stop_split] [@expl:unit_prop_loop ensures #3] [%#ssolver'30] inv'6 d.final (UInt64.t'int f.current.num_vars))
    /\ ([@stop_split] [@expl:unit_prop_loop ensures #4] [%#ssolver'32] match result with
        | Some b -> if b then true else not_satisfiable f.final
        | None -> true
        end)
    /\ ([@stop_split] [@expl:unit_prop_loop ensures #5] [%#ssolver'33] UInt64.t'int f.current.num_vars
      = UInt64.t'int f.final.num_vars)
    /\ ([@stop_split] [@expl:unit_prop_loop ensures #6] [%#ssolver'34] equisat f.current f.final)}
    (! return {result}) ]

let rec elim_Some (_x: t_Option_bool) (return (f0'0: bool)) = any
  [ _k (f0'0: bool) -> {Some f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
