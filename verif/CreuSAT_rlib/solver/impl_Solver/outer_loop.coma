let rec reduceDB (self: MutBorrow.t t_Formula) (watches'0: MutBorrow.t t_Watches) (t: t_Trail) (s: MutBorrow.t t_Solver)
  (return (x: ())) =
  {[@stop_split] [@expl:reduceDB requires] ([@stop_split] [@expl:reduceDB requires #0] [%#sformula] inv'1 self.current)
  /\ ([@stop_split] [@expl:reduceDB requires #1] [%#sformula'0] inv'5 watches'0.current self.current)
  /\ ([@stop_split] [@expl:reduceDB requires #2] [%#sformula'1] inv'1 self.current)
  /\ ([@stop_split] [@expl:reduceDB requires #3] [%#sformula'2] inv'4 t self.current)
  /\ ([@stop_split] [@expl:reduceDB requires #4] [%#sformula'3] UInt64.t'int self.current.num_vars
  < ComputerDivision.div (UInt64.t'int const_MAX) 2)}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:reduceDB ensures] ([@stop_split] [@expl:reduceDB ensures #0] [%#sformula] inv'1 self.final)
    /\ ([@stop_split] [@expl:reduceDB ensures #1] [%#sformula'0] inv'5 watches'0.final self.final)
