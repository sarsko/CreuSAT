predicate inv'3 [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_trail.rs" 10 4 10 40] (self: t_Reason) (f: t_Formula) =
  [%#slogic_trail'6] match self with
    | Long cref -> 0 <= UInt64.t'int cref
