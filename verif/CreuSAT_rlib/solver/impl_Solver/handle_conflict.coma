type t_Decisions__private

predicate inv__private (x: t_Decisions__private)

type t_Vec_Node_Global

type t_Decisions = {
  linked_list: t_Vec_Node_Global;
  start: UInt64.t;
  search: UInt64.t;
  t_Decisions__private: t_Decisions__private }

predicate inv_Decisions (_1: t_Decisions)

axiom inv_axiom [@rewrite]: forall x: t_Decisions [inv_Decisions x]. inv_Decisions x
    = inv__private x.t_Decisions__private

type t_Vec_Clause_Global

type t_Formula = { clauses: t_Vec_Clause_Global; num_vars: UInt64.t }

type t_Vec_u8_Global

type t_Assignments = { f0: t_Vec_u8_Global }

type t_Vec_usize_Global

type t_Vec_Step_Global

type t_Trail = {
  assignments: t_Assignments;
  lit_to_level: t_Vec_usize_Global;
  trail: t_Vec_Step_Global;
  curr_i: UInt64.t;
  decisions: t_Vec_usize_Global }

type t_Vec_Lit_Global

type t_Clause = { deleted'0: bool; lbd'0: UInt32.t; search'0: UInt64.t; lits'0: t_Vec_Lit_Global }

type t_Conflict = Ground | Unit t_Clause | Learned UInt64.t t_Clause | Restart t_Clause

predicate invariant_refmut_Decisions [@inline:trivial] (self: MutBorrow.t t_Decisions) =
  [%#sinvariant] inv_Decisions self.current /\ inv_Decisions self.final

meta "rewrite_def" predicate invariant_refmut_Decisions

predicate inv_refmut_Decisions [@inline:trivial] (_1: MutBorrow.t t_Decisions) = invariant_refmut_Decisions _1

meta "rewrite_def" predicate inv_refmut_Decisions

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Clause_Global (self: t_Vec_Clause_Global) : Seq.seq t_Clause

axiom view_Vec_Clause_Global_spec: forall self: t_Vec_Clause_Global. [%#svec] Seq.length (view_Vec_Clause_Global self)
    <= UInt64.t'int const_MAX

type t_Lit = { idx: UInt64.t; polarity: bool }

