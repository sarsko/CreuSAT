let rec analyze_conflict (f: t_Formula) (trail'0: t_Trail) (cref: UInt64.t) (d: MutBorrow.t t_Decisions)
  (return (x: t_Conflict)) =
  {[@stop_split] [@expl:analyze_conflict requires] ([@stop_split] [@expl:analyze_conflict 'd' type invariant] [%#sconflict_analysis] inv_refmut_Decisions d)
  /\ ([@stop_split] [@expl:analyze_conflict requires #0] [%#sconflict_analysis'0] inv'1 f)
  /\ ([@stop_split] [@expl:analyze_conflict requires #1] [%#sconflict_analysis'1] UInt64.t'int f.num_vars
    < UInt64.t'int const_MAX)
  /\ ([@stop_split] [@expl:analyze_conflict requires #2] [%#sconflict_analysis'2] inv'4 trail'0 f)
  /\ ([@stop_split] [@expl:analyze_conflict requires #3] [%#sconflict_analysis'3] UInt64.t'int cref
    < Seq.length (view_Vec_Clause_Global f.clauses))
  /\ ([@stop_split] [@expl:analyze_conflict requires #4] [%#sconflict_analysis'4] unsat (Seq.get (view_Vec_Clause_Global f.clauses) (UInt64.t'int cref)) trail'0.assignments)
  /\ ([@stop_split] [@expl:analyze_conflict requires #5] [%#sconflict_analysis'5] inv'5 d.current (UInt64.t'int f.num_vars))}
  any
  [ return (result: t_Conflict) ->
  {[@stop_split] [@expl:analyze_conflict ensures] ([@stop_split] [@expl:analyze_conflict ensures #0] [%#sconflict_analysis'6] match result with
        | Ground -> not_satisfiable f
        | Unit clause -> inv'0 clause (UInt64.t'int f.num_vars)
        /\ Seq.length (view_Clause clause) = 1
        /\ vars_in_range_inner (view_Clause clause) (UInt64.t'int f.num_vars)
        /\ no_duplicate_indexes_inner (view_Clause clause) /\ equisat_extension_inner clause (view_Formula f)
        | Learned s_idx clause -> inv'0 clause (UInt64.t'int f.num_vars)
        /\ Seq.length (view_Clause clause) > 1
        /\ vars_in_range_inner (view_Clause clause) (UInt64.t'int f.num_vars)
        /\ no_duplicate_indexes_inner (view_Clause clause)
        /\ equisat_extension_inner clause (view_Formula f) /\ UInt64.t'int s_idx < Seq.length (view_Clause clause)
        | Restart clause -> inv'0 clause (UInt64.t'int f.num_vars)
        /\ Seq.length (view_Clause clause) > 1
        /\ vars_in_range_inner (view_Clause clause) (UInt64.t'int f.num_vars)
        /\ no_duplicate_indexes_inner (view_Clause clause) /\ equisat_extension_inner clause (view_Formula f)
        end)
    /\ ([@stop_split] [@expl:analyze_conflict ensures #1] [%#sconflict_analysis'5] inv'5 d.final (UInt64.t'int f.num_vars))}
    (! return {result}) ]

type t_Solver = {
  num_lemmas: UInt64.t;
  max_lemmas: UInt64.t;
  num_conflicts: UInt64.t;
  initial_len: UInt64.t;
  inc_reduce_db: UInt64.t;
  fast: UInt64.t;
  slow: UInt64.t;
  perm_diff: t_Vec_usize_Global }

predicate resolve_refmut_Solver [@inline:trivial] (_1: MutBorrow.t t_Solver) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Solver

