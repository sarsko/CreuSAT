        (fun (_bor: MutBorrow.t t_Watches) -> [ &_19 <- _bor ] [ &watches'0 <- _bor.final ] s5)
    | s5 = init_watches [%#ssolver'4] {_19} {formula.current} (fun (_x: ()) -> [ &_18 <- _x ] s6)
    | s6 = MutBorrow.borrow_mut <t_Decisions> {decisions'0}
        (fun (_bor: MutBorrow.t t_Decisions) ->
          [ &_26 <- _bor ] -{inv_Decisions _bor.final}-
          [ &decisions'0 <- _bor.final ] s7) [ _ck -> (! {[@expl:type invariant] inv_Decisions decisions'0} any) ]
    | s7 = MutBorrow.borrow_mut <t_Trail> {trail'0}
        (fun (_bor: MutBorrow.t t_Trail) -> [ &_23 <- _bor ] [ &trail'0 <- _bor.final ] s8)
    | s8 = MutBorrow.borrow_final <t_Decisions> {_26.current} {MutBorrow.get_id _26}
        (fun (_bor: MutBorrow.t t_Decisions) ->
          [ &_25 <- _bor ] -{inv_Decisions _bor.final}-
          [ &_26 <- { _26 with current = _bor.final } ] s9)
      [ _ck -> (! {[@expl:type invariant] inv_Decisions _26.current} any) ]
    | s9 = learn_units [%#ssolver'5] {_23} {formula.current} {_25} (fun (_x: t_Option_bool) -> [ &_22 <- _x ] s10)
    | s10 = s11 [ _ck -> (! {[@expl:type invariant] inv_refmut_Decisions _26} any) ]
    | s11 = -{resolve_refmut_Decisions _26}- s12
    | s12 = any [ br0 -> {_22 = None} (! bb18) | br1 (x0: bool) -> {_22 = Some x0} (! bb14) ] ]
  | bb14 = s0
    [ s0 = s1 [ _ck -> (! {[@expl:type invariant] inv_Decisions decisions'0} any) ]
    | s1 = -{resolve_Decisions decisions'0}- s2
    | s2 = -{resolve_refmut_Formula formula}- s3
    | s3 = elim_Some {_22} (fun (r0: bool) -> any [ br0 -> {r0 = false} (! bb16) | br1 -> {r0} (! bb17) ]) ]
  | bb17 = s0 [ s0 = [ &_ret <- Unsat ] s1 | s1 = return {_ret} ]
  | bb16 = s0 [ s0 = [ &_ret <- Err ] s1 | s1 = return {_ret} ]
  | bb18 = s0
    [ s0 = new'3 [%#ssolver'6] {formula.current} (fun (_x: t_Solver) -> [ &solver'0 <- _x ] s1)
    | s1 = MutBorrow.borrow_mut <t_Solver> {solver'0}
        (fun (_bor: MutBorrow.t t_Solver) -> [ &_32 <- _bor ] [ &solver'0 <- _bor.final ] s2)
    | s2 = MutBorrow.borrow_final <t_Formula> {formula.current} {MutBorrow.get_id formula}
        (fun (_bor: MutBorrow.t t_Formula) -> [ &_33 <- _bor ] [ &formula <- { formula with current = _bor.final } ] s3)
    | s3 = inner [%#ssolver'7] {_32} {_33} {decisions'0} {trail'0} {watches'0}
        (fun (_x: t_SatResult) -> [ &_ret <- _x ] s4)
    | s4 = -{resolve_refmut_Formula formula}- s5
    | s5 = return {_ret} ] ]
  [ & _ret: t_SatResult = Any.any_l ()
  | & formula: MutBorrow.t t_Formula = formula
  | & _5: t_SatResult = Any.any_l ()
  | & o: t_SatResult = Any.any_l ()
  | & trail'0: t_Trail = Any.any_l ()
  | & _12: t_Assignments = Any.any_l ()
  | & decisions'0: t_Decisions = Any.any_l ()
  | & watches'0: t_Watches = Any.any_l ()
  | & _18: () = Any.any_l ()
  | & _19: MutBorrow.t t_Watches = Any.any_l ()
  | & _22: t_Option_bool = Any.any_l ()
  | & _23: MutBorrow.t t_Trail = Any.any_l ()
  | & _25: MutBorrow.t t_Decisions = Any.any_l ()
  | & _26: MutBorrow.t t_Decisions = Any.any_l ()
  | & solver'0: t_Solver = Any.any_l ()
  | & _32: MutBorrow.t t_Solver = Any.any_l ()
  | & _33: MutBorrow.t t_Formula = Any.any_l () ])
  [ return (result: t_SatResult) -> {[@stop_split] [@expl:solver ensures] [%#ssolver'8] match result with
      | Sat assn -> formula_sat_inner (view_Formula formula.final) (view_Vec_u8_Global assn)
      /\ equisat formula.current formula.final
      | Unsat -> not_satisfiable formula.final /\ equisat formula.current formula.final
      | _ -> true
      end}
    (! return {result}) ]
