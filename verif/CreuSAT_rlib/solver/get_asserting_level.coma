constant const_MAX: UInt64.t = [%#suint_macros] (18446744073709551615: UInt64.t)

function view_Vec_Lit_Global (self: t_Vec_Lit_Global) : Seq.seq t_Lit

axiom view_Vec_Lit_Global_spec:
  forall self: t_Vec_Lit_Global [view_Vec_Lit_Global self]. [%#svec'1] Seq.length (view_Vec_Lit_Global self)
    <= UInt64.t'int const_MAX

function view_Clause [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 13 4 13 33] (self: t_Clause) : Seq.seq t_Lit
 = [%#slogic_clause] view_Vec_Lit_Global self.lits

let index_Clause (self: t_Clause) (ix: UInt64.t) (return (x: t_Lit)) =
{[@stop_split] [@expl:index requires] [%#sclause] UInt64.t'int ix < Seq.length (view_Clause self)}
  any
  [ return (result: t_Lit) ->
  {[@stop_split] [@expl:index ensures] [%#sclause'0] Seq.get (view_Clause self) (UInt64.t'int ix) = result}
    (! return {result}) ]

function index [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_lit.rs" 18 4 18 35] [@inline:trivial] (self: t_Lit) : int
 = [%#slogic_lit] UInt64.t'int self.idx

meta "rewrite_def" function index

let index'0 (self: t_Lit) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:index ensures] [%#slit] UInt64.t'int result = index self}
    (! return {result}) ]

type t_Vec_usize_Global

type t_Vec_u8_Global

type t_Assignments = { f0: t_Vec_u8_Global }

type t_Vec_Step_Global

