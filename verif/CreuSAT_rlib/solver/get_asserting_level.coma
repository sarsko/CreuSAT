predicate clause_post_with_regards_to_inner [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_trail.rs" 115 0 115 90] (c: t_Clause) (a: Seq.seq UInt8.t) (j: int) =
  [%#slogic_trail'7] index (Seq.get (view_Clause c) 0) = j
