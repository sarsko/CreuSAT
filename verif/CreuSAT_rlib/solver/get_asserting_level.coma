  [%#slogic_clause'3] forall j: int, k: int. 0 <= j /\ j < Seq.length s /\ 0 <= k /\ k < Seq.length s /\ k <> j
    -> index (Seq.get s k) <> index (Seq.get s j)

predicate inv_internal [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 27 0 27 48] (s: Seq.seq t_Lit) (n: int) =
  [%#slogic_clause'4] vars_in_range_inner s n /\ no_duplicate_indexes_inner s

predicate inv'0 [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 199 4 199 36] (self: t_Clause) (n: int) =
  [%#slogic_clause'1] inv_internal (view_Clause self) n

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate inv_mirror [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 73 4 73 35] (self: t_Formula) =
  [%#slogic_formula'2] (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Clause_Global self.clauses)
      -> inv'0 (Seq.get (view_Vec_Clause_Global self.clauses) i) (UInt64.t'int self.num_vars))
  /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Clause_Global self.clauses)
    -> ge_log_Int (Seq.length (view_Clause (Seq.get (view_Vec_Clause_Global self.clauses) i))) 1)

type t_FormulaModel = { clauses'0: Seq.seq t_Clause; num_vars'0: int }

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate formula_invariant [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 22 0 22 49] (f: t_FormulaModel) =
  [%#slogic_formula'3] forall i: int. 0 <= i /\ i < Seq.length f.clauses'0
    -> inv'0 (Seq.get f.clauses'0 i) f.num_vars'0 /\ gt_log_Int (Seq.length (view_Clause (Seq.get f.clauses'0 i))) 0

function view_Formula [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 16 4 16 33] (self: t_Formula) : t_FormulaModel
 = [%#slogic_formula'1] { clauses'0 = view_Vec_Clause_Global self.clauses; num_vars'0 = UInt64.t'int self.num_vars }

predicate inv'1 [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 68 4 68 28] (self: t_Formula) =
  [%#slogic_formula'0] formula_invariant (view_Formula self)

axiom inv_spec: forall self: t_Formula [inv'1 self]. [%#slogic_formula] inv'1 self = inv_mirror self

function view_Vec_u8_Global (self: t_Vec_u8_Global) : Seq.seq UInt8.t

axiom view_Vec_u8_Global_spec:
  forall self: t_Vec_u8_Global [view_Vec_u8_Global self]. [%#svec'1] Seq.length (view_Vec_u8_Global self)
    <= UInt64.t'int const_MAX

function view_Assignments [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_assignments.rs" 17 4 17 33] (self: t_Assignments) : Seq.seq UInt8.t
 = [%#slogic_assignments'0] view_Vec_u8_Global self.f0

predicate inv'2 [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_assignments.rs" 45 4 45 40] (self: t_Assignments) (f: t_Formula) =
  [%#slogic_assignments] UInt64.t'int f.num_vars = Seq.length (view_Assignments self)
  /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Assignments self)
    -> UInt8.t'int (Seq.get (view_Assignments self) i) <= 3)

type t_Reason = Decision | Unit UInt64.t | Long UInt64.t

type t_Step = { lit: t_Lit; decision_level: UInt64.t; reason: t_Reason }

predicate inv'3 [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_trail.rs" 10 4 10 40] (self: t_Reason) (f: t_Formula) =
  [%#slogic_trail'6] match self with
    | Long cref -> 0 <= UInt64.t'int cref
    /\ UInt64.t'int cref < Seq.length (view_Vec_Clause_Global f.clauses)
    /\ gt_log_Int (Seq.length (view_Clause (Seq.get (view_Vec_Clause_Global f.clauses) (UInt64.t'int cref)))) 1
    | Unit cref -> 0 <= UInt64.t'int cref
    /\ UInt64.t'int cref < Seq.length (view_Vec_Clause_Global f.clauses)
    /\ Seq.length (view_Clause (Seq.get (view_Vec_Clause_Global f.clauses) (UInt64.t'int cref))) = 1
    | _ -> true
    end

predicate trail_invariant [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_trail.rs" 93 0 93 60] (trail'0: Seq.seq t_Step) (f: t_Formula) =
  [%#slogic_trail'0] forall i: int. 0 <= i /\ i < Seq.length trail'0
    -> inv (Seq.get trail'0 i).lit (UInt64.t'int f.num_vars) /\ inv'3 (Seq.get trail'0 i).reason f

function view_Vec_Step_Global (self: t_Vec_Step_Global) : Seq.seq t_Step

axiom view_Vec_Step_Global_spec:
  forall self: t_Vec_Step_Global [view_Vec_Step_Global self]. [%#svec'1] Seq.length (view_Vec_Step_Global self)
    <= UInt64.t'int const_MAX

predicate lit_idx_in [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_lit.rs" 58 4 58 46] (self: t_Lit) (c: t_Clause) =
  [%#slogic_lit'1] exists i: int. 0 <= i
    /\ i < Seq.length (view_Clause c) /\ index (Seq.get (view_Clause c) i) = index self

predicate lit_not_in_less_inner [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_trail.rs" 81 0 81 62] (t: Seq.seq t_Step) (f: t_Formula) =
  [%#slogic_trail'1] forall i: int. 0 <= i /\ i < Seq.length t
    -> (forall j: int. 0 <= j /\ j < i
      -> match (Seq.get t j).reason with
        | Long cref -> not lit_idx_in (Seq.get t i).lit (Seq.get (view_Vec_Clause_Global f.clauses) (UInt64.t'int cref))
        | _ -> true
        end)

predicate lit_is_unique_inner [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_trail.rs" 129 0 129 52] (trail'0: Seq.seq t_Step) =
  [%#slogic_trail'2] forall i: int. 0 <= i /\ i < Seq.length trail'0
    -> (forall j: int. 0 <= j /\ j < i -> index (Seq.get trail'0 j).lit <> index (Seq.get trail'0 i).lit)

predicate is_positive [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_lit.rs" 23 4 23 42] [@inline:trivial] (self: t_Lit) =
  [%#slogic_lit'5] self.polarity

meta "rewrite_def" predicate is_positive

predicate sat_inner [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_lit.rs" 71 4 71 57] (self: t_Lit) (a: Seq.seq UInt8.t) =
  [%#slogic_lit'2] if is_positive self then
    UInt8.t'int (Seq.get a (index self)) = 1
  else
    UInt8.t'int (Seq.get a (index self)) = 0


predicate unsat_inner [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_lit.rs" 81 4 81 59] (self: t_Lit) (a: Seq.seq UInt8.t) =
  [%#slogic_lit'4] if is_positive self then
