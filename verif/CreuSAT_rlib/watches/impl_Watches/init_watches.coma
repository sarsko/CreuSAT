  (! bb0
  [ bb0 = s0
    [ s0 = [ &old_w <- [%#swatches] self ] s1
    | s1 = [ &i <- [%#swatches'0] (0: UInt64.t) ] s2
    | s2 = [ &_old <- self.final ] s3
    | s3 = bb2 ]
  | bb2 = bb2
