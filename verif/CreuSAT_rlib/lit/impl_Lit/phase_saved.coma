let phase_saved [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/lit.rs" 116 4 116 68] (idx'0: UInt64.t)
  (assignments: t_Assignments) (return (x: t_Lit)) =
{[@stop_split] [@expl:phase_saved requires] [%#slit'3] UInt64.t'int idx'0 < Seq.length (view_Assignments assignments)}
  (! bb0
  [ bb0 = s0
    [ s0 = index_Assignments [%#slit] {assignments} {idx'0} (fun (_x: UInt8.t) -> [ &_15 <- _x ] s1)
    | s1 = [ &_13 <- _15 = ([%#slit'0] (1: UInt8.t)) ] s2
    | s2 = any [ br0 -> {_13 = false} (! bb3) | br1 -> {_13} (! bb2) ] ]
  | bb2 = s0 [ s0 = [ &_12 <- [%#slit'1] true ] s1 | s1 = bb4 ]
  | bb3 = s0 [ s0 = [ &_12 <- [%#slit'2] false ] s1 | s1 = bb4 ]
  | bb4 = s0 [ s0 = [ &_ret <- { idx = idx'0; polarity = _12 } ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_Lit = Any.any_l ()
  | & idx'0: UInt64.t = idx'0
  | & assignments: t_Assignments = assignments
  | & _12: bool = Any.any_l ()
  | & _13: bool = Any.any_l ()
  | & _15: UInt8.t = Any.any_l () ])
  [ return (result: t_Lit) ->
  {[@stop_split] [@expl:phase_saved ensures] ([@stop_split] [@expl:phase_saved ensures #0] [%#slit'4] index result
      = UInt64.t'int idx'0)
    /\ ([@stop_split] [@expl:phase_saved ensures #1] [%#slit'5] is_positive result
    = (UInt8.t'int (Seq.get (view_Assignments assignments) (UInt64.t'int idx'0)) = 1))}
    (! return {result}) ]
