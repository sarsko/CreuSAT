(* lit::Lit *)

use creusot.int.UInt64
use creusot.prelude.Any

type t_Lit = { idx: UInt64.t; polarity: bool }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let new [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/lit.rs" 121 4 121 49] (idx'0: UInt64.t)
  (polarity'0: bool) (return (x: t_Lit)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- { idx = idx'0; polarity = polarity'0 } ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_Lit = Any.any_l () | & idx'0: UInt64.t = idx'0 | & polarity'0: bool = polarity'0 ])
  [ return (result: t_Lit) -> (! return {result}) ]
