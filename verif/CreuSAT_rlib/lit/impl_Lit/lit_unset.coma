use creusot.int.UInt64
use creusot.int.UInt8
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_Lit = { idx: UInt64.t; polarity: bool }

function index [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_lit.rs" 18 4 18 35] [@inline:trivial] (self: t_Lit) : int
 = [%#slogic_lit'1] UInt64.t'int self.idx

meta "rewrite_def" function index

let index'0 (self: t_Lit) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:index ensures] [%#slit'4] UInt64.t'int result = index self}
    (! return {result}) ]

type t_Vec_u8_Global

type t_Assignments = { f0: t_Vec_u8_Global }

constant const_MAX: UInt64.t = [%#suint_macros] (18446744073709551615: UInt64.t)

function view_Vec_u8_Global (self: t_Vec_u8_Global) : Seq.seq UInt8.t

axiom view_Vec_u8_Global_spec:
  forall self: t_Vec_u8_Global [view_Vec_u8_Global self]. [%#svec] Seq.length (view_Vec_u8_Global self)
    <= UInt64.t'int const_MAX

function view_Assignments [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_assignments.rs" 17 4 17 33] (self: t_Assignments) : Seq.seq UInt8.t
 = [%#slogic_assignments] view_Vec_u8_Global self.f0

let index_Assignments (self: t_Assignments) (ix: UInt64.t) (return (x: UInt8.t)) =
{[@stop_split] [@expl:index requires] [%#sassignments] UInt64.t'int ix < Seq.length (view_Assignments self)}
  any
  [ return (result: UInt8.t) ->
  {[@stop_split] [@expl:index ensures] [%#sassignments'0] Seq.get (view_Assignments self) (UInt64.t'int ix) = result}
    (! return {result}) ]

predicate inv [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_lit.rs" 66 4 66 36] (self: t_Lit) (n: int) =
  [%#slogic_lit] index self < n

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate unset_inner [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_lit.rs" 91 4 91 59] (self: t_Lit) (a: Seq.seq UInt8.t) =
  [%#slogic_lit'2] ge_log_Int (UInt8.t'int (Seq.get a (index self))) 2

predicate unset [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_lit.rs" 101 4 101 46] (self: t_Lit) (a: t_Assignments) =
  [%#slogic_lit'0] unset_inner self (view_Assignments a)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let lit_unset [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/lit.rs" 83 4 83 51] (self: t_Lit)
  (a: t_Assignments) (return (x: bool)) =
{[@stop_split] [@expl:lit_unset requires] [%#slit'2] inv self (Seq.length (view_Assignments a))}
  (! bb0
  [ bb0 = s0
    [ s0 = index'0 [%#slit] {self} (fun (_x: UInt64.t) -> [ &_12 <- _x ] s1)
    | s1 = index_Assignments [%#slit'0] {a} {_12} (fun (_x: UInt8.t) -> [ &_10 <- _x ] s2)
    | s2 = [ &_ret <- UInt8.ge _10 ([%#slit'1] (2: UInt8.t)) ] s3
    | s3 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & self: t_Lit = self
  | & a: t_Assignments = a
  | & _10: UInt8.t = Any.any_l ()
  | & _12: UInt64.t = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:lit_unset ensures] [%#slit'3] result = unset self a}
    (! return {result}) ]
