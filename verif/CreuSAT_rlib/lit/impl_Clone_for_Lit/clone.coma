use creusot.int.UInt64
use creusot.prelude.Any

type t_Lit = { idx: UInt64.t; polarity: bool }

let clone_usize (self_: UInt64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:clone ensures] [%#snum] result = self_} (! return {result}) ]

let clone_bool (self_: bool) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:clone ensures] [%#sclone] result = self_} (! return {result}) ]

predicate postcondition_clone (self: ()) (args: UInt64.t) (result: UInt64.t) =
  [%#sclone'0] let self_ = args in [%#snum] result = self_

meta "rewrite_def" predicate postcondition_clone

predicate postcondition_clone'0 (self: ()) (args: bool) (result: bool) =
  [%#sclone'0] let self_ = args in [%#sclone] result = self_

meta "rewrite_def" predicate postcondition_clone'0

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let clone_Lit [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/lit.rs" 9 9 9 14] (self: t_Lit)
  (return (x: t_Lit)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &_6 <- self.idx ] s1
    | s1 = clone_usize [%#slit] {_6} (fun (_x: UInt64.t) -> [ &_4 <- _x ] s2)
    | s2 = [ &_9 <- self.polarity ] s3
    | s3 = clone_bool [%#slit'0] {_9} (fun (_x: bool) -> [ &_7 <- _x ] s4)
    | s4 = [ &_ret <- { idx = _4; polarity = _7 } ] s5
    | s5 = return {_ret} ] ]
  [ & _ret: t_Lit = Any.any_l ()
  | & self: t_Lit = self
  | & _4: UInt64.t = Any.any_l ()
  | & _6: UInt64.t = Any.any_l ()
  | & _7: bool = Any.any_l ()
  | & _9: bool = Any.any_l () ])
  [ return (result: t_Lit) -> {[@stop_split] [@expl:clone ensures] [%#slit'1] postcondition_clone () self.idx result.idx
    /\ postcondition_clone'0 () self.polarity result.polarity}
    (! return {result}) ]
