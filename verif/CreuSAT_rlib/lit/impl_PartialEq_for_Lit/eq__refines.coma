use creusot.int.UInt64

type t_Lit = { idx: UInt64.t; polarity: bool }

function deep_model_Lit [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/lit.rs" 30 4 30 31] (self: t_Lit) : t_Lit =
  [%#slit'0] self

function deep_model_ref_Lit [@inline:trivial] (self: t_Lit) : t_Lit = [%#smodel] deep_model_Lit self

meta "rewrite_def" function deep_model_ref_Lit

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self_: t_Lit. forall rhs: t_Lit. forall result: bool. ([%#slit] result = (self_ = rhs))
        -> ([%#scmp] result = (deep_model_ref_Lit self_ = deep_model_ref_Lit rhs))
