use creusot.int.UInt64
use creusot.prelude.Any
use int.Int

function min_log [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/util.rs" 83 0 83 37] (a: int) (b: int) : int
 = [%#sutil'3] if a <= b then a else b

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let min [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/util.rs" 96 0 96 39] (a: UInt64.t) (b: UInt64.t)
  (return (x: UInt64.t)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_15 <- UInt64.le a b ] s1 | s1 = any [ br0 -> {_15 = false} (! bb2) | br1 -> {_15} (! bb1) ] ]
  | bb1 = s0 [ s0 = [ &_ret <- a ] s1 | s1 = return {_ret} ]
  | bb2 = s0 [ s0 = [ &_ret <- b ] s1 | s1 = return {_ret} ] ]
  [ & _ret: UInt64.t = Any.any_l () | & a: UInt64.t = a | & b: UInt64.t = b | & _15: bool = Any.any_l () ])
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:min ensures] ([@stop_split] [@expl:min ensures #0] [%#sutil] UInt64.t'int result
      = min_log (UInt64.t'int a) (UInt64.t'int b))
    /\ ([@stop_split] [@expl:min ensures #1] [%#sutil'0] UInt64.t'int a <= UInt64.t'int b
      -> UInt64.t'int result = UInt64.t'int a)
    /\ ([@stop_split] [@expl:min ensures #2] [%#sutil'1] UInt64.t'int b < UInt64.t'int a
      -> UInt64.t'int result = UInt64.t'int b)
    /\ ([@stop_split] [@expl:min ensures #3] [%#sutil'2] UInt64.t'int result <= UInt64.t'int b
    /\ UInt64.t'int result <= UInt64.t'int a)}
    (! return {result}) ]
