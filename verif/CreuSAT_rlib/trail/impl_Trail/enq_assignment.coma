  {[@stop_split] [@expl:index_mut requires] [%#svec] in_bounds_usize ix (view_Vec_usize_Global self_.current)}
  any
  [ return (result: MutBorrow.t UInt64.t) ->
  {[@stop_split] [@expl:index_mut_Vec_usize_Global ensures] ([@stop_split] [@expl:index_mut ensures #0] [%#svec'0] has_value_usize ix (view_Vec_usize_Global self_.current) result.current)
    /\ ([@stop_split] [@expl:index_mut ensures #1] [%#svec'1] has_value_usize ix (view_Vec_usize_Global self_.final) result.final)
    /\ ([@stop_split] [@expl:index_mut ensures #2] [%#svec'2] resolve_elswhere_usize ix (view_Vec_usize_Global self_.current) (view_Vec_usize_Global self_.final))
    /\ ([@stop_split] [@expl:index_mut ensures #3] [%#svec'3] Seq.length (view_Vec_usize_Global self_.final)
    = Seq.length (view_Vec_usize_Global self_.current))}
    (! return {result}) ]

