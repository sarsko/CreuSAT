  [%#slogic_lit] index self < n

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

function view_Vec_Lit_Global (self: t_Vec_Lit_Global) : Seq.seq t_Lit

axiom view_Vec_Lit_Global_spec:
  forall self: t_Vec_Lit_Global [view_Vec_Lit_Global self]. [%#svec'0] Seq.length (view_Vec_Lit_Global self)
    <= UInt64.t'int const_MAX

function view_Clause [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 13 4 13 33] (self: t_Clause) : Seq.seq t_Lit
 = [%#slogic_clause] view_Vec_Lit_Global self.lits

predicate inv'2 [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_trail.rs" 10 4 10 40] (self: t_Reason) (f: t_Formula) =
  [%#slogic_trail'6] match self with
    | Long cref -> 0 <= UInt64.t'int cref
    /\ UInt64.t'int cref < Seq.length (view_Vec_Clause_Global f.clauses)
    /\ gt_log_Int (Seq.length (view_Clause (Seq.get (view_Vec_Clause_Global f.clauses) (UInt64.t'int cref)))) 1
    | Unit cref -> 0 <= UInt64.t'int cref
    /\ UInt64.t'int cref < Seq.length (view_Vec_Clause_Global f.clauses)
    /\ Seq.length (view_Clause (Seq.get (view_Vec_Clause_Global f.clauses) (UInt64.t'int cref))) = 1
    | _ -> true
