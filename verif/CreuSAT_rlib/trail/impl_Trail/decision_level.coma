use creusot.int.UInt64
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_Vec_usize_Global

type t_Vec_u8_Global

type t_Assignments = { f0: t_Vec_u8_Global }

type t_Vec_Step_Global

type t_Trail = {
  assignments: t_Assignments;
  lit_to_level: t_Vec_usize_Global;
  trail: t_Vec_Step_Global;
  curr_i: UInt64.t;
  decisions: t_Vec_usize_Global }

constant const_MAX: UInt64.t = [%#suint_macros] (18446744073709551615: UInt64.t)

function view_Vec_usize_Global (self: t_Vec_usize_Global) : Seq.seq UInt64.t

axiom view_Vec_usize_Global_spec:
  forall self: t_Vec_usize_Global [view_Vec_usize_Global self]. [%#svec'0] Seq.length (view_Vec_usize_Global self)
    <= UInt64.t'int const_MAX

let len_usize (self_: t_Vec_usize_Global) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#svec] UInt64.t'int result
    = Seq.length (view_Vec_usize_Global self_)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let decision_level [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/trail.rs" 34 4 34 41] (self: t_Trail)
  (return (x: UInt64.t)) = (! bb0
  [ bb0 = s0
    [ s0 = len_usize [%#strail] {self.decisions} (fun (_x: UInt64.t) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
  [ & _ret: UInt64.t = Any.any_l () | & self: t_Trail = self ])
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:decision_level ensures] [%#strail'0] UInt64.t'int result
    = Seq.length (view_Vec_usize_Global self.decisions)}
    (! return {result}) ]
