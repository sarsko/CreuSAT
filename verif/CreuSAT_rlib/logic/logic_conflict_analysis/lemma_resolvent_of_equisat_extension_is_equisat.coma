use creusot.int.UInt32
use creusot.int.UInt64
use seq.Seq
use creusot.int.UInt8
use int.Int

type t_Vec_Lit_Global

type t_Clause = { deleted: bool; lbd: UInt32.t; search: UInt64.t; lits: t_Vec_Lit_Global }

type t_FormulaModel = { clauses: Seq.seq t_Clause; num_vars: int }

type t_Lit = { idx: UInt64.t; polarity: bool }

function index [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_lit.rs" 18 4 18 35] [@inline:trivial] (self: t_Lit) : int
 = [%#slogic_lit'1] UInt64.t'int self.idx

meta "rewrite_def" function index

predicate inv [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_lit.rs" 66 4 66 36] (self: t_Lit) (n: int) =
  [%#slogic_lit'3] index self < n

predicate vars_in_range_inner [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 19 0 19 55] (s: Seq.seq t_Lit) (n: int) =
  [%#slogic_clause'6] forall i: int. 0 <= i /\ i < Seq.length s -> inv (Seq.get s i) n

predicate no_duplicate_indexes_inner [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 39 0 39 54] (s: Seq.seq t_Lit) =
  [%#slogic_clause'7] forall j: int, k: int. 0 <= j /\ j < Seq.length s /\ 0 <= k /\ k < Seq.length s /\ k <> j
    -> index (Seq.get s k) <> index (Seq.get s j)

predicate inv_internal [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 27 0 27 48] (s: Seq.seq t_Lit) (n: int) =
  [%#slogic_clause'5] vars_in_range_inner s n /\ no_duplicate_indexes_inner s

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Lit_Global (self: t_Vec_Lit_Global) : Seq.seq t_Lit

axiom view_Vec_Lit_Global_spec: forall self: t_Vec_Lit_Global. [%#svec] Seq.length (view_Vec_Lit_Global self)
    <= UInt64.t'int const_MAX

function view_Clause [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 13 4 13 33] (self: t_Clause) : Seq.seq t_Lit
 = [%#slogic_clause'3] view_Vec_Lit_Global self.lits

predicate inv'0 [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 199 4 199 36] (self: t_Clause) (n: int) =
  [%#slogic_clause'4] inv_internal (view_Clause self) n

predicate formula_invariant [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 22 0 22 49] (f: t_FormulaModel) =
  [%#slogic_formula] forall i: int. 0 <= i /\ i < Seq.length f.clauses
    -> inv'0 (Seq.get f.clauses i) f.num_vars /\ Seq.length (view_Clause (Seq.get f.clauses i)) > 0

predicate unset [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic.rs" 18 0 18 38] (v: UInt8.t) =
  [%#slogic] if UInt8.t'int v >= 2 then true else false

predicate complete_inner [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_assignments.rs" 31 0 31 52] (a: Seq.seq UInt8.t) =
  [%#slogic_assignments] forall i: int. 0 <= i /\ i < Seq.length a -> not unset (Seq.get a i)

predicate is_positive [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_lit.rs" 23 4 23 42] [@inline:trivial] (self: t_Lit) =
  [%#slogic_lit'2] self.polarity

meta "rewrite_def" predicate is_positive

predicate sat_inner [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_lit.rs" 71 4 71 57] (self: t_Lit) (a: Seq.seq UInt8.t) =
  [%#slogic_lit'4] if is_positive self then
    UInt8.t'int (Seq.get a (index self)) = 1
  else
    UInt8.t'int (Seq.get a (index self)) = 0


predicate sat_inner'0 [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 164 4 164 57] (self: t_Clause) (a: Seq.seq UInt8.t) =
  [%#slogic_clause'8] exists i: int. 0 <= i
    /\ i < Seq.length (view_Clause self) /\ sat_inner (Seq.get (view_Clause self) i) a

predicate formula_sat_inner [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 30 0 30 72] (f: t_FormulaModel) (a: Seq.seq UInt8.t) =
  [%#slogic_formula'1] forall i: int. 0 <= i /\ i < Seq.length f.clauses -> sat_inner'0 (Seq.get f.clauses i) a

predicate eventually_sat_complete [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 38 0 38 55] (f: t_FormulaModel) =
  [%#slogic_formula'0] exists a2: Seq.seq UInt8.t. Seq.length a2 = f.num_vars
    /\ complete_inner a2 /\ formula_sat_inner f a2

predicate equisat_extension_inner [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 32 0 32 66] (c: t_Clause) (f: t_FormulaModel) =
  [%#slogic_clause] eventually_sat_complete f
  -> eventually_sat_complete { clauses = Seq.snoc f.clauses c; num_vars = f.num_vars }

predicate in_formula_inner [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 127 4 127 58] (self: t_Clause) (f: t_FormulaModel) =
  [%#slogic_clause'0] exists i: int. 0 <= i /\ i < Seq.length f.clauses /\ Seq.get f.clauses i = self

predicate lit_in [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_lit.rs" 53 4 53 42] (self: t_Lit) (c: t_Clause) =
  [%#slogic_lit] exists i: int. 0 <= i /\ i < Seq.length (view_Clause c) /\ Seq.get (view_Clause c) i = self

predicate is_opp [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_lit.rs" 41 4 41 39] (self: t_Lit) (o: t_Lit) =
  [%#slogic_lit'0] index self = index o /\ is_positive self <> is_positive o

predicate resolvent_of [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 107 4 107 76] (self: t_Clause) (c: t_Clause) (c2: t_Clause) (k: int) (m: int) =
  [%#slogic_clause'1] (forall i: int. 0 <= i /\ i < Seq.length (view_Clause c) /\ i <> m
      -> lit_in (Seq.get (view_Clause c) i) self)
  /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Clause c2) /\ i <> k -> lit_in (Seq.get (view_Clause c2) i) self)
  /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Clause self)
      -> lit_in (Seq.get (view_Clause self) i) c \/ lit_in (Seq.get (view_Clause self) i) c2)
  /\ not lit_in (Seq.get (view_Clause c) m) self
  /\ not lit_in (Seq.get (view_Clause c2) k) self /\ is_opp (Seq.get (view_Clause c2) k) (Seq.get (view_Clause c) m)

predicate equals [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 212 4 212 42] (self: t_Clause) (o: t_Clause) =
  [%#slogic_clause'2] Seq.length (view_Clause self) = Seq.length (view_Clause o)
  /\ (forall j: int. 0 <= j /\ j < Seq.length (view_Clause self)
    -> Seq.get (view_Clause self) j = Seq.get (view_Clause o) j)

function lemma_eq_formulas [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_conflict_analysis.rs" 16 0 16 70] (f: t_FormulaModel) (f2: t_FormulaModel) (c: t_Clause) : ()
 = [%#slogic_conflict_analysis'9] ()

axiom lemma_eq_formulas_spec:
  forall f: t_FormulaModel, f2: t_FormulaModel, c: t_Clause. ([%#slogic_conflict_analysis'4] f2.clauses
      = Seq.snoc f.clauses c)
    -> ([%#slogic_conflict_analysis'5] formula_invariant f)
    -> ([%#slogic_conflict_analysis'6] Seq.length f.clauses + 1 = Seq.length f2.clauses)

axiom lemma_eq_formulas_spec'0:
  forall f: t_FormulaModel, f2: t_FormulaModel, c: t_Clause. ([%#slogic_conflict_analysis'4] f2.clauses
      = Seq.snoc f.clauses c)
    -> ([%#slogic_conflict_analysis'5] formula_invariant f)
    -> ([%#slogic_conflict_analysis'7] forall i: int. 0 <= i /\ i < Seq.length f.clauses
      -> equals (Seq.get f.clauses i) (Seq.get f2.clauses i))

axiom lemma_eq_formulas_spec'1:
  forall f: t_FormulaModel, f2: t_FormulaModel, c: t_Clause. ([%#slogic_conflict_analysis'4] f2.clauses
      = Seq.snoc f.clauses c)
    -> ([%#slogic_conflict_analysis'5] formula_invariant f)
    -> ([%#slogic_conflict_analysis'8] view_Clause (Seq.get f2.clauses (Seq.length f2.clauses - 1)) = view_Clause c)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant f : t_FormulaModel

constant c : t_Clause

constant c2 : t_Clause

constant c3 : t_Clause

constant k : int

constant m : int

function lemma_resolvent_of_equisat_extension_is_equisat [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_conflict_analysis.rs" 25 0 27 1] (f: t_FormulaModel) (c: t_Clause) (c2: t_Clause) (c3: t_Clause) (k: int) (m: int) : ()

goal vc_lemma_resolvent_of_equisat_extension_is_equisat: ([%#slogic_conflict_analysis] formula_invariant f)
  -> ([%#slogic_conflict_analysis'0] equisat_extension_inner c f)
  -> ([%#slogic_conflict_analysis'1] in_formula_inner c2 f)
  -> ([%#slogic_conflict_analysis'2] resolvent_of c3 c c2 k m)
  -> ([@stop_split] [@expl:lemma_eq_formulas requires] ([@stop_split] [@expl:lemma_eq_formulas requires #0] [%#slogic_conflict_analysis'4] { clauses = Seq.snoc f.clauses c3;
                                                                                                                                             num_vars = f.num_vars }.clauses
      = Seq.snoc f.clauses c3)
    /\ ([@stop_split] [@expl:lemma_eq_formulas requires #1] [%#slogic_conflict_analysis'5] formula_invariant f))
  /\ (([@stop_split] [@expl:lemma_eq_formulas ensures] ([@stop_split] [@expl:lemma_eq_formulas ensures #0] [%#slogic_conflict_analysis'6] Seq.length f.clauses
        + 1
      = Seq.length { clauses = Seq.snoc f.clauses c3; num_vars = f.num_vars }.clauses)
    /\ ([@stop_split] [@expl:lemma_eq_formulas ensures #1] [%#slogic_conflict_analysis'7] forall i: int. 0 <= i
          /\ i < Seq.length f.clauses
        -> equals (Seq.get f.clauses i) (Seq.get { clauses = Seq.snoc f.clauses c3; num_vars = f.num_vars }.clauses i))
    /\ ([@stop_split] [@expl:lemma_eq_formulas ensures #2] [%#slogic_conflict_analysis'8] view_Clause (Seq.get { clauses = Seq.snoc f.clauses c3;
                                                                                                                 num_vars = f.num_vars }.clauses (Seq.length { clauses = Seq.snoc f.clauses c3;
                                                                                                                                                               num_vars = f.num_vars }.clauses
      - 1))
    = view_Clause c3))
  -> (let _ = lemma_eq_formulas f { clauses = Seq.snoc f.clauses c3;
                                    num_vars = f.num_vars } c3 in [@stop_split] [@expl:lemma_resolvent_of_equisat_extension_is_equisat ensures] [%#slogic_conflict_analysis'3] equisat_extension_inner c3 f))
