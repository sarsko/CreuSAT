let%span slogic = "/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic.rs" 30 10 30 28
let%span slogic'0 = "/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic.rs" 31 10 31 29

use creusot.int.UInt8

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant b : bool

function bool_to_assignedstate [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic.rs" 32 0 32 54] (b: bool) : UInt8.t

goal vc_bool_to_assignedstate: if b then
    let result = (1: UInt8.t) in [@stop_split] [@expl:bool_to_assignedstate ensures] ([@stop_split] [@expl:bool_to_assignedstate ensures #0] [%#slogic] b
      -> UInt8.t'int result = 1)
    /\ ([@stop_split] [@expl:bool_to_assignedstate ensures #1] [%#slogic'0] not b -> UInt8.t'int result = 0)
  else
    let result = (0: UInt8.t) in [@stop_split] [@expl:bool_to_assignedstate ensures] ([@stop_split] [@expl:bool_to_assignedstate ensures #0] [%#slogic] b
      -> UInt8.t'int result = 1)
    /\ ([@stop_split] [@expl:bool_to_assignedstate ensures #1] [%#slogic'0] not b -> UInt8.t'int result = 0)
  
