        | s1 = check_lit_invariant [%#sclause'3] {_22} {n} (fun (_x: bool) -> [ &_20 <- _x ] s2)
        | s2 = any [ br0 -> {_20 = false} (! bb8) | br1 -> {_20} (! bb7) ] ]
      | bb7 = s0
        [ s0 = UInt64.add [%#sclause'5] {i} {[%#sclause'4] (1: UInt64.t)} (fun (_x: UInt64.t) -> [ &i <- _x ] s1)
        | s1 = bb1 ] ] ]
  | bb8 = s0 [ s0 = [ &_ret <- [%#sclause'6] false ] s1 | s1 = return {_ret} ]
  | bb9 = s0 [ s0 = no_duplicates [%#sclause'7] {self} (fun (_x: bool) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & self: t_Clause = self
  | & n: UInt64.t = n
  | & i: UInt64.t = Any.any_l ()
  | & _15: bool = Any.any_l ()
  | & _17: UInt64.t = Any.any_l ()
  | & _20: bool = Any.any_l ()
