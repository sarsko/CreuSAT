use creusot.int.UInt64
use creusot.int.UInt32
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_Vec_Lit_Global

type t_Clause = { deleted: bool; lbd: UInt32.t; search: UInt64.t; lits: t_Vec_Lit_Global }

type t_Lit = { idx: UInt64.t; polarity: bool }

constant const_MAX: UInt64.t = [%#suint_macros] (18446744073709551615: UInt64.t)

function view_Vec_Lit_Global (self: t_Vec_Lit_Global) : Seq.seq t_Lit

axiom view_Vec_Lit_Global_spec:
  forall self: t_Vec_Lit_Global [view_Vec_Lit_Global self]. [%#svec] Seq.length (view_Vec_Lit_Global self)
    <= UInt64.t'int const_MAX

function view_Clause [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 13 4 13 33] (self: t_Clause) : Seq.seq t_Lit
 = [%#slogic_clause] view_Vec_Lit_Global self.lits

let len (self: t_Clause) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sclause'9] UInt64.t'int result
    = Seq.length (view_Clause self)}
    (! return {result}) ]

function index [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_lit.rs" 18 4 18 35] [@inline:trivial] (self: t_Lit) : int
 = [%#slogic_lit'0] UInt64.t'int self.idx

meta "rewrite_def" function index

predicate inv [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_lit.rs" 66 4 66 36] (self: t_Lit) (n: int) =
  [%#slogic_lit] index self < n

let index_Clause (self: t_Clause) (ix: UInt64.t) (return (x: t_Lit)) =
{[@stop_split] [@expl:index requires] [%#sclause'10] UInt64.t'int ix < Seq.length (view_Clause self)}
  any
  [ return (result: t_Lit) ->
  {[@stop_split] [@expl:index ensures] [%#sclause'11] Seq.get (view_Clause self) (UInt64.t'int ix) = result}
    (! return {result}) ]

let check_lit_invariant (self: t_Lit) (n: UInt64.t) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:check_lit_invariant ensures] [%#slit] result
    = inv self (UInt64.t'int n)}
    (! return {result}) ]

predicate no_duplicate_indexes_inner [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 39 0 39 54] (s: Seq.seq t_Lit) =
  [%#slogic_clause'3] forall j: int, k: int. 0 <= j /\ j < Seq.length s /\ 0 <= k /\ k < Seq.length s /\ k <> j
    -> index (Seq.get s k) <> index (Seq.get s j)

predicate no_duplicate_indexes [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 189 4 189 45] (self: t_Clause) =
  [%#slogic_clause'1] no_duplicate_indexes_inner (view_Clause self)

let no_duplicates (self: t_Clause) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:no_duplicates ensures] [%#sclause'12] result
    = no_duplicate_indexes self}
    (! return {result}) ]

predicate vars_in_range_inner [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 19 0 19 55] (s: Seq.seq t_Lit) (n: int) =
  [%#slogic_clause'4] forall i: int. 0 <= i /\ i < Seq.length s -> inv (Seq.get s i) n

predicate inv_internal [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 27 0 27 48] (s: Seq.seq t_Lit) (n: int) =
  [%#slogic_clause'2] vars_in_range_inner s n /\ no_duplicate_indexes_inner s

predicate inv'0 [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 199 4 199 36] (self: t_Clause) (n: int) =
  [%#slogic_clause'0] inv_internal (view_Clause self) n

