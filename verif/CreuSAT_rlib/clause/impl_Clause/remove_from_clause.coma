          /\ Seq.get (view_Clause self.final) i = Seq.get (view_Clause self.current) j))
    /\ ([@stop_split] [@expl:move_to_end ensures #2] [%#sclause'12] Seq.get (view_Clause self.final) (Seq.length (view_Clause self.final)
        - 1)
      = Seq.get (view_Clause self.current) (UInt64.t'int idx'0))
    /\ ([@stop_split] [@expl:move_to_end ensures #3] [%#sclause'13] Seq.length (view_Clause self.final)
      = Seq.length (view_Clause self.current))
    /\ ([@stop_split] [@expl:move_to_end ensures #4] [%#sclause'14] forall j: int. 0 <= j
        /\ j < Seq.length (view_Clause self.current) -> lit_in (Seq.get (view_Clause self.current) j) self.final)}
    (! return {result}) ]

type t_Option_Lit = None | Some t_Lit

let pop_Lit (self_: MutBorrow.t t_Vec_Lit_Global) (return (x: t_Option_Lit)) = any
  [ return (result: t_Option_Lit) -> {[@stop_split] [@expl:pop ensures] [%#svec] match result with
      | Some t -> view_Vec_Lit_Global self_.final
        = Seq.([..]) (view_Vec_Lit_Global self_.current) 0 (Seq.length (view_Vec_Lit_Global self_.current) - 1)
      /\ view_Vec_Lit_Global self_.current = Seq.snoc (view_Vec_Lit_Global self_.final) t
      | None -> self_.current = self_.final /\ Seq.length (view_Vec_Lit_Global self_.current) = 0
      end}
    (! return {result}) ]

predicate resolve_refmut_Clause [@inline:trivial] (_1: MutBorrow.t t_Clause) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Clause

meta "compute_max_steps" 1000000

