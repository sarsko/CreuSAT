let move_to_end (self: MutBorrow.t t_Clause) (idx'0: UInt64.t) (_f: t_Formula) (return (x: ())) =
{[@stop_split] [@expl:move_to_end requires] ([@stop_split] [@expl:move_to_end requires #0] [%#sclause'8] inv'0 self.current (UInt64.t'int _f.num_vars))
