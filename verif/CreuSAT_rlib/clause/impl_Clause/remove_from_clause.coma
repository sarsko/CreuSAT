  /\ ([@stop_split] [@expl:move_to_end requires #2] [%#sclause'10] UInt64.t'int idx'0
  < Seq.length (view_Clause self.current))}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:move_to_end ensures] ([@stop_split] [@expl:move_to_end ensures #0] [%#sclause'8] inv'0 self.final (UInt64.t'int _f.num_vars))
    /\ ([@stop_split] [@expl:move_to_end ensures #1] [%#sclause'11] forall i: int. 0 <= i
          /\ i < Seq.length (view_Clause self.final)
        -> (exists j: int. 0 <= j
