use int.Int

type t_Vec_Lit_Global

type t_Clause = { deleted: bool; lbd: UInt32.t; search: UInt64.t; lits: t_Vec_Lit_Global }

type t_Lit = { idx: UInt64.t; polarity: bool }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Lit_Global (self: t_Vec_Lit_Global) : Seq.seq t_Lit

axiom view_Vec_Lit_Global_spec: forall self: t_Vec_Lit_Global. [%#svec] Seq.length (view_Vec_Lit_Global self)
    <= UInt64.t'int const_MAX

function view_Clause [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 13 4 13 33] (self: t_Clause) : Seq.seq t_Lit
 = [%#slogic_clause] view_Vec_Lit_Global self.lits

let rec len (self: t_Clause) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sclause'15] UInt64.t'int result
    = Seq.length (view_Clause self)}
    (! return {result}) ]

function index [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_lit.rs" 18 4 18 35] [@inline:trivial] (self: t_Lit) : int
 = [%#slogic_lit] UInt64.t'int self.idx

meta "rewrite_def" function index

let rec index_Clause (self: t_Clause) (ix: UInt64.t) (return (x: t_Lit)) =
  {[@stop_split] [@expl:index requires] [%#sclause'16] UInt64.t'int ix < Seq.length (view_Clause self)}
  any
  [ return (result: t_Lit) ->
  {[@stop_split] [@expl:index ensures] [%#sclause'17] Seq.get (view_Clause self) (UInt64.t'int ix) = result}
    (! return {result}) ]

let rec index'0 (self: t_Lit) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:index ensures] [%#slit] UInt64.t'int result = index self}
