predicate no_duplicate_indexes_inner [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 39 0 39 54] (s: Seq.seq t_Lit) =
  [%#slogic_clause'1] forall j: int, k: int. 0 <= j /\ j < Seq.length s /\ 0 <= k /\ k < Seq.length s /\ k <> j
    -> index (Seq.get s k) <> index (Seq.get s j)

predicate no_duplicate_indexes [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 189 4 189 45] (self: t_Clause) =
  [%#slogic_clause'0] no_duplicate_indexes_inner (view_Clause self)

