predicate inv [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_lit.rs" 66 4 66 36] (self: t_Lit) (n: int) =
  [%#slogic_lit'0] index self < n

predicate vars_in_range_inner [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 19 0 19 55] (s: Seq.seq t_Lit) (n: int) =
  [%#slogic_clause'15] forall i: int. 0 <= i /\ i < Seq.length s -> inv (Seq.get s i) n

predicate no_duplicate_indexes_inner [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 39 0 39 54] (s: Seq.seq t_Lit) =
  [%#slogic_clause'13] forall j: int, k: int. 0 <= j /\ j < Seq.length s /\ 0 <= k /\ k < Seq.length s /\ k <> j
    -> index (Seq.get s k) <> index (Seq.get s j)

predicate inv_internal [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 27 0 27 48] (s: Seq.seq t_Lit) (n: int) =
  [%#slogic_clause'14] vars_in_range_inner s n /\ no_duplicate_indexes_inner s

function view_Clause [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 13 4 13 33] (self: t_Clause) : Seq.seq t_Lit
 = [%#slogic_clause'9] view_Vec_Lit_Global self.lits

predicate inv'0 [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 199 4 199 36] (self: t_Clause) (n: int) =
  [%#slogic_clause'10] inv_internal (view_Clause self) n

predicate formula_invariant [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 22 0 22 49] (f: t_FormulaModel) =
  [%#slogic_formula'2] forall i: int. 0 <= i /\ i < Seq.length f.clauses
    -> inv'0 (Seq.get f.clauses i) f.num_vars /\ Seq.length (view_Clause (Seq.get f.clauses i)) > 0

