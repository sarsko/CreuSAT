  [%#slogic] if UInt8.t'int v >= 2 then true else false

predicate complete_inner [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_assignments.rs" 31 0 31 52] (a: Seq.seq UInt8.t) =
  [%#slogic_assignments] forall i: int. 0 <= i /\ i < Seq.length a -> not unset (Seq.get a i)

predicate is_positive [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_lit.rs" 23 4 23 42] [@inline:trivial] (self: t_Lit) =
  [%#slogic_lit'2] self.polarity

meta "rewrite_def" predicate is_positive

predicate sat_inner [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_lit.rs" 71 4 71 57] (self: t_Lit) (a: Seq.seq UInt8.t) =
  [%#slogic_lit'1] if is_positive self then
    UInt8.t'int (Seq.get a (index self)) = 1
  else
    UInt8.t'int (Seq.get a (index self)) = 0


predicate sat_inner'0 [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 164 4 164 57] (self: t_Clause) (a: Seq.seq UInt8.t) =
  [%#slogic_clause'16] exists i: int. 0 <= i
    /\ i < Seq.length (view_Clause self) /\ sat_inner (Seq.get (view_Clause self) i) a

predicate formula_sat_inner [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 30 0 30 72] (f: t_FormulaModel) (a: Seq.seq UInt8.t) =
  [%#slogic_formula'5] forall i: int. 0 <= i /\ i < Seq.length f.clauses -> sat_inner'0 (Seq.get f.clauses i) a

predicate eventually_sat_complete [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 38 0 38 55] (f: t_FormulaModel) =
  [%#slogic_formula'4] exists a2: Seq.seq UInt8.t. Seq.length a2 = f.num_vars
    /\ complete_inner a2 /\ formula_sat_inner f a2

predicate equisat_extension_inner [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 32 0 32 66] (c: t_Clause) (f: t_FormulaModel) =
  [%#slogic_clause'12] eventually_sat_complete f
  -> eventually_sat_complete { clauses = Seq.snoc f.clauses c; num_vars = f.num_vars }

predicate permutation_of_Lit (self: Seq.seq t_Lit) (other: Seq.seq t_Lit) =
  [%#sseq] Permut.permut self other 0 (Seq.length self)

function lemma_permuted_clause_maintains_equisat [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 227 0 227 86] (f: t_FormulaModel) (c: t_Clause) (c2: t_Clause) : ()

axiom lemma_permuted_clause_maintains_equisat_spec:
  forall f: t_FormulaModel, c: t_Clause, c2: t_Clause. ([%#slogic_clause] formula_invariant f)
    -> ([%#slogic_clause'0] equisat_extension_inner c f)
    -> ([%#slogic_clause'1] permutation_of_Lit (view_Clause c) (view_Clause c2))
    -> ([%#slogic_clause'2] equisat_extension_inner c2 f)

type t_Vec_Clause_Global

type t_Formula = { clauses'0: t_Vec_Clause_Global; num_vars'0: UInt64.t }

function view_Vec_Clause_Global (self: t_Vec_Clause_Global) : Seq.seq t_Clause

axiom view_Vec_Clause_Global_spec: forall self: t_Vec_Clause_Global. [%#svec'2] Seq.length (view_Vec_Clause_Global self)
    <= UInt64.t'int const_MAX

function view_Formula [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 16 4 16 33] (self: t_Formula) : t_FormulaModel
 = [%#slogic_formula] { clauses = view_Vec_Clause_Global self.clauses'0; num_vars = UInt64.t'int self.num_vars'0 }

function dup_stable_on_permut [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 237 0 237 51] (c1: t_Clause) (c2: t_Clause) : ()
 = [%#slogic_clause'8] ()

axiom dup_stable_on_permut_spec:
  forall c1: t_Clause, c2: t_Clause. ([%#slogic_clause'3] no_duplicate_indexes_inner (view_Clause c1))
    -> ([%#slogic_clause'4] exists i: int, j: int. Permut.exchange (view_Clause c2) (view_Clause c1) j i)
    -> ([%#slogic_clause'5] permutation_of_Lit (view_Clause c1) (view_Clause c2))

axiom dup_stable_on_permut_spec'0:
  forall c1: t_Clause, c2: t_Clause. ([%#slogic_clause'3] no_duplicate_indexes_inner (view_Clause c1))
    -> ([%#slogic_clause'4] exists i: int, j: int. Permut.exchange (view_Clause c2) (view_Clause c1) j i)
    -> ([%#slogic_clause'6] permutation_of_Lit (view_Clause c2) (view_Clause c1))

axiom dup_stable_on_permut_spec'1:
  forall c1: t_Clause, c2: t_Clause. ([%#slogic_clause'3] no_duplicate_indexes_inner (view_Clause c1))
    -> ([%#slogic_clause'4] exists i: int, j: int. Permut.exchange (view_Clause c2) (view_Clause c1) j i)
    -> ([%#slogic_clause'7] no_duplicate_indexes_inner (view_Clause c2))

predicate inv_mirror [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 73 4 73 35] (self: t_Formula) =
  [%#slogic_formula'3] (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Clause_Global self.clauses'0)
      -> inv'0 (Seq.get (view_Vec_Clause_Global self.clauses'0) i) (UInt64.t'int self.num_vars'0))
  /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Clause_Global self.clauses'0)
    -> Seq.length (view_Clause (Seq.get (view_Vec_Clause_Global self.clauses'0) i)) >= 1)

predicate inv'1 [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_formula.rs" 68 4 68 28] (self: t_Formula) =
  [%#slogic_formula'1] formula_invariant (view_Formula self)

axiom inv_spec: forall self: t_Formula. [%#slogic_formula'0] inv'1 self = inv_mirror self

predicate equisat_extension [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/logic/logic_clause.rs" 92 4 92 54] (self: t_Clause) (f: t_Formula) =
  [%#slogic_clause'11] equisat_extension_inner self (view_Formula f)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec swap_lits_in_clause [#"/Users/sarekhs/Programming/CreuSAT/CreuSAT/src/clause.rs" 165 4 165 75]
  (self: MutBorrow.t t_Clause) (_f: t_Formula) (j: UInt64.t) (k: UInt64.t) (return (x: ())) =
  {[@stop_split] [@expl:swap_lits_in_clause requires] ([@stop_split] [@expl:swap_lits_in_clause requires #0] [%#sclause'3] Seq.length (view_Clause self.current)
    > UInt64.t'int j)
  /\ ([@stop_split] [@expl:swap_lits_in_clause requires #1] [%#sclause'4] Seq.length (view_Clause self.current)
    > UInt64.t'int k)
  /\ ([@stop_split] [@expl:swap_lits_in_clause requires #2] [%#sclause'5] inv'1 _f)
  /\ ([@stop_split] [@expl:swap_lits_in_clause requires #3] [%#sclause'6] inv'0 self.current (UInt64.t'int _f.num_vars'0))
  /\ ([@stop_split] [@expl:swap_lits_in_clause requires #4] [%#sclause'7] equisat_extension self.current _f)}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &old_c <- [%#sclause] self ] s1
    | s1 = MutBorrow.borrow_final <t_Vec_Lit_Global> {self.current.lits}
        {MutBorrow.inherit_id (MutBorrow.get_id self) 3}
        (fun (_bor: MutBorrow.t t_Vec_Lit_Global) ->
          [ &_37 <- _bor ] [ &self <- { self with current = { self.current with lits = _bor.final } } ] s2)
    | s2 = deref_mut_Vec_Lit_Global [%#sclause'0] {_37}
        (fun (_x: MutBorrow.t (Slice64.slice t_Lit)) -> [ &_36 <- _x ] s3)
    | s3 = MutBorrow.borrow_final <Slice64.slice t_Lit> {_36.current} {MutBorrow.get_id _36}
        (fun (_bor: MutBorrow.t (Slice64.slice t_Lit)) ->
          [ &_35 <- _bor ] [ &_36 <- { _36 with current = _bor.final } ] s4)
    | s4 = swap_Lit [%#sclause'0] {_35} {j} {k} (fun (_x: ()) -> [ &_34 <- _x ] s5)
    | s5 = -{resolve_refmut_slice_Lit _36}- s6
    | s6 = -{resolve_refmut_Clause self}- s7
    | s7 =
      {[@expl:assertion] [%#sclause'1] let _ = lemma_permuted_clause_maintains_equisat (view_Formula _f) old_c.current self.current in true}
      s8
    | s8 = {[@expl:assertion] [%#sclause'2] let _ = dup_stable_on_permut old_c.current self.current in true} s9
    | s9 = return {_ret} ] ]
  [ & _ret: () = Any.any_l ()
  | & self: MutBorrow.t t_Clause = self
  | & _f: t_Formula = _f
  | & j: UInt64.t = j
  | & k: UInt64.t = k
  | & old_c: MutBorrow.t t_Clause = Any.any_l ()
  | & _34: () = Any.any_l ()
  | & _35: MutBorrow.t (Slice64.slice t_Lit) = Any.any_l ()
  | & _36: MutBorrow.t (Slice64.slice t_Lit) = Any.any_l ()
  | & _37: MutBorrow.t t_Vec_Lit_Global = Any.any_l () ])
  [ return (result: ()) ->
  {[@stop_split] [@expl:swap_lits_in_clause ensures] ([@stop_split] [@expl:swap_lits_in_clause ensures #0] [%#sclause'6] inv'0 self.final (UInt64.t'int _f.num_vars'0))
    /\ ([@stop_split] [@expl:swap_lits_in_clause ensures #1] [%#sclause'7] equisat_extension self.final _f)
    /\ ([@stop_split] [@expl:swap_lits_in_clause ensures #2] [%#sclause'8] Seq.length (view_Clause self.current)
      = Seq.length (view_Clause self.final))
    /\ ([@stop_split] [@expl:swap_lits_in_clause ensures #3] [%#sclause'9] Permut.exchange (view_Clause self.final) (view_Clause self.current) (UInt64.t'int j) (UInt64.t'int k))}
    (! return {result}) ]
