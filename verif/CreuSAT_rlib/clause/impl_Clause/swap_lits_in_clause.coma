type t_Vec_Lit_Global

type t_Clause = { deleted: bool; lbd: UInt32.t; search: UInt64.t; lits: t_Vec_Lit_Global }

type t_Lit = { idx: UInt64.t; polarity: bool }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Lit_Global (self: t_Vec_Lit_Global) : Seq.seq t_Lit

axiom view_Vec_Lit_Global_spec: forall self: t_Vec_Lit_Global. [%#svec'2] Seq.length (view_Vec_Lit_Global self)
    <= UInt64.t'int const_MAX

let rec deref_mut_Vec_Lit_Global (self_: MutBorrow.t t_Vec_Lit_Global) (return (x: MutBorrow.t (Slice64.slice t_Lit))) =
  any
  [ return (result: MutBorrow.t (Slice64.slice t_Lit)) ->
  {[@stop_split] [@expl:deref_mut_Vec_Lit_Global ensures] ([@stop_split] [@expl:deref_mut ensures #0] [%#svec] Slice64.view result.current
      = view_Vec_Lit_Global self_.current)
    /\ ([@stop_split] [@expl:deref_mut ensures #1] [%#svec'0] Seq.length (view_Vec_Lit_Global self_.final)
      = Seq.length (view_Vec_Lit_Global self_.current))
    /\ ([@stop_split] [@expl:deref_mut ensures #2] [%#svec'1] Slice64.view result.final
    = view_Vec_Lit_Global self_.final)}
    (! return {result}) ]

let rec swap_Lit (self_: MutBorrow.t (Slice64.slice t_Lit)) (i: UInt64.t) (j: UInt64.t) (return (x: ())) =
  {[@stop_split] [@expl:swap_Lit requires] ([@stop_split] [@expl:swap requires #0] [%#sslice] UInt64.t'int i
    < Seq.length (Slice64.view self_.current))
  /\ ([@stop_split] [@expl:swap requires #1] [%#sslice'0] UInt64.t'int j < Seq.length (Slice64.view self_.current))}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:swap ensures] [%#sslice'1] Permut.exchange (Slice64.view self_.final) (Slice64.view self_.current) (UInt64.t'int i) (UInt64.t'int j)}
    (! return {result}) ]

predicate resolve_refmut_slice_Lit [@inline:trivial] (_1: MutBorrow.t (Slice64.slice t_Lit)) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_slice_Lit

predicate resolve_refmut_Clause [@inline:trivial] (_1: MutBorrow.t t_Clause) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Clause

type t_FormulaModel = { clauses: Seq.seq t_Clause; num_vars: int }

