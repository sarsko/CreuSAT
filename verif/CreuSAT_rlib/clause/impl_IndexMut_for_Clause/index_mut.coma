  [ return (result: MutBorrow.t t_Lit) ->
  {[@stop_split] [@expl:index_mut_Vec_Lit_Global ensures] ([@stop_split] [@expl:index_mut ensures #0] [%#svec'0] has_value_usize ix (view_Vec_Lit_Global self_.current) result.current)
    /\ ([@stop_split] [@expl:index_mut ensures #1] [%#svec'1] has_value_usize ix (view_Vec_Lit_Global self_.final) result.final)
