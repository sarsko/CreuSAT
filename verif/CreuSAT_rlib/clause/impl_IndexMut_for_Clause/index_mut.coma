predicate resolve_refmut_Lit [@inline:trivial] (_1: MutBorrow.t t_Lit) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Lit

predicate resolve_refmut_Clause [@inline:trivial] (_1: MutBorrow.t t_Clause) = _1.final = _1.current

