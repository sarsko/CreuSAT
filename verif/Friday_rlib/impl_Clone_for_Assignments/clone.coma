function postcondition_mut_hist_inv_clone (self: ()) (args: bool) (res_state: ()) (res: bool) : ()

axiom postcondition_mut_hist_inv_clone_spec:
  forall self: (), args: bool, res_state: (), res: bool. ([%#sops'2] postcondition_mut_clone self args res_state res)
