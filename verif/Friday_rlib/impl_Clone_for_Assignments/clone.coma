predicate postcondition_clone [@inline:trivial] (self: ()) (args: bool) (result: bool) =
  let self_ = args in [%#sclone] result = self_

meta "rewrite_def" predicate postcondition_clone

function fn_once_clone (self: ()) (args: bool) (res: bool) : ()

axiom fn_once_clone_spec: forall self: (), args: bool, res: bool. [%#sops'0] postcondition_once_clone self args res
    = (postcondition_clone self args res /\ resolve_clone self)

function fn_mut_clone (self: ()) (args: bool) (res_state: ()) (res: bool) : ()

axiom fn_mut_clone_spec:
  forall self: (), args: bool, res_state: (), res: bool. [%#sops] postcondition_mut_clone self args res_state res
    = (postcondition_clone self args res /\ self = res_state)

let rec clone_bool (self_: bool) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:clone ensures] [%#sclone] result = self_} (! return {result}) ]

let rec clone_Vec_bool_Global (self_: t_Vec_bool_Global) (return (x: t_Vec_bool_Global)) = any
  [ return (result: t_Vec_bool_Global) ->
  {[@stop_split] [@expl:clone_Vec_bool_Global ensures] ([@stop_split] [@expl:clone ensures #0] [%#svec] Seq.length (view_Vec_bool_Global self_)
      = Seq.length (view_Vec_bool_Global result))
    /\ ([@stop_split] [@expl:clone ensures #1] [%#svec'0] forall i: int. 0 <= i
        /\ i < Seq.length (view_Vec_bool_Global self_)
      -> postcondition_clone () (Seq.get (view_Vec_bool_Global self_) i) (Seq.get (view_Vec_bool_Global result) i))}
    (! return {result}) ]

