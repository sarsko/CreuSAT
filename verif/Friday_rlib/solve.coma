predicate sat [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Friday/src/lib.rs" 102 4 102 44] (self: t_Lit) (a: t_Assignments) =
  [%#slib'27] Seq.get (view_Assignments a) (UInt64.t'int self.var') = self.value

