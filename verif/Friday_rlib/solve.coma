  {[@stop_split] [@expl:set_next ensures] ([@stop_split] [@expl:set_next ensures #0] [%#slib'18] compatible result.assign pa)
    /\ ([@stop_split] [@expl:set_next ensures #1] [%#slib'19] Seq.get (view_Assignments result.assign) (UInt64.t'int pa.ix)
      = b)
    /\ ([@stop_split] [@expl:set_next ensures #2] [%#slib'20] UInt64.t'int result.ix = UInt64.t'int pa.ix + 1)}
    (! return {result}) ]

predicate invariant' [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Friday/src/lib.rs" 129 4 129 42] (self: t_Pasn) (n: int) =
  [%#slib'21] UInt64.t'int self.ix <= Seq.length (view_Assignments self.assign)
