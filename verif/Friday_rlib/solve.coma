predicate compatible [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Friday/src/lib.rs" 111 4 111 41] (self: t_Assignments) (pa: t_Pasn) =
  [%#slib'22] Seq.length (view_Vec_bool_Global pa.assign.f0) = Seq.length (view_Vec_bool_Global self.f0)
