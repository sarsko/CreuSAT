predicate inv_Formula (_1: t_Formula)

axiom inv_axiom [@rewrite]: forall x: t_Formula [inv_Formula x]. inv_Formula x = invariant_Formula x

predicate invariant_ref_Formula [@inline:trivial] (self: t_Formula) = [%#sinvariant] inv_Formula self

