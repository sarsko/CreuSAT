type t_Pasn = { assign: t_Assignments; ix: UInt64.t }

constant const_MAX: UInt64.t = [%#suint_macros] (18446744073709551615: UInt64.t)

function view_Vec_bool_Global (self: t_Vec_bool_Global) : Seq.seq bool

axiom view_Vec_bool_Global_spec:
  forall self: t_Vec_bool_Global [view_Vec_bool_Global self]. [%#svec'4] Seq.length (view_Vec_bool_Global self)
    <= UInt64.t'int const_MAX

function view_Assignments [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Friday/src/lib.rs" 28 4 28 33] (self: t_Assignments) : Seq.seq bool
 = [%#slib'9] view_Vec_bool_Global self.f0

predicate eq [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Friday/src/lib.rs" 122 4 122 44] (self: t_Pasn) (rhs: t_Pasn) =
  [%#slib'11] view_Assignments self.assign = view_Assignments rhs.assign /\ self.ix = rhs.ix

let clone_Pasn (self: t_Pasn) (return (x: t_Pasn)) = any
  [ return (result: t_Pasn) -> {[@stop_split] [@expl:clone ensures] [%#slib'8] eq self result} (! return {result}) ]

predicate in_bounds_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq bool) =
  [%#sslice] UInt64.t'int self < Seq.length seq

meta "rewrite_def" predicate in_bounds_usize

predicate has_value_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq bool) (out: bool) =
  [%#sslice'0] Seq.get seq (UInt64.t'int self) = out

meta "rewrite_def" predicate has_value_usize

predicate resolve_elswhere_usize [@inline:trivial] (self: UInt64.t) (old': Seq.seq bool) (fin: Seq.seq bool) =
  [%#sslice'1] forall i: int. 0 <= i /\ i <> UInt64.t'int self /\ i < Seq.length old' -> Seq.get old' i = Seq.get fin i

meta "rewrite_def" predicate resolve_elswhere_usize

let index_mut_Vec_bool_Global (self_: MutBorrow.t t_Vec_bool_Global) (ix'0: UInt64.t) (return (x: MutBorrow.t bool)) =
{[@stop_split] [@expl:index_mut requires] [%#svec] in_bounds_usize ix'0 (view_Vec_bool_Global self_.current)}
  any
  [ return (result: MutBorrow.t bool) ->
  {[@stop_split] [@expl:index_mut_Vec_bool_Global ensures] ([@stop_split] [@expl:index_mut ensures #0] [%#svec'0] has_value_usize ix'0 (view_Vec_bool_Global self_.current) result.current)
    /\ ([@stop_split] [@expl:index_mut ensures #1] [%#svec'1] has_value_usize ix'0 (view_Vec_bool_Global self_.final) result.final)
    /\ ([@stop_split] [@expl:index_mut ensures #2] [%#svec'2] resolve_elswhere_usize ix'0 (view_Vec_bool_Global self_.current) (view_Vec_bool_Global self_.final))
    /\ ([@stop_split] [@expl:index_mut ensures #3] [%#svec'3] Seq.length (view_Vec_bool_Global self_.final)
    = Seq.length (view_Vec_bool_Global self_.current))}
    (! return {result}) ]

predicate resolve_refmut_bool [@inline:trivial] (_1: MutBorrow.t bool) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_bool

predicate compatible [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Friday/src/lib.rs" 111 4 111 41] (self: t_Assignments) (pa: t_Pasn) =
  [%#slib'10] Seq.length (view_Vec_bool_Global pa.assign.f0) = Seq.length (view_Vec_bool_Global self.f0)
  /\ (forall i: int. 0 <= i /\ i < UInt64.t'int pa.ix
    -> Seq.get (view_Assignments pa.assign) i = Seq.get (view_Assignments self) i)

