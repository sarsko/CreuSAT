    | s6 = [ &_ret <- new_pa ] s7
    | s7 = return {_ret} ] ]
  [ & _ret: t_Pasn = Any.any_l ()
  | & pa: t_Pasn = pa
  | & b: bool = b
  | & new_pa: t_Pasn = Any.any_l ()
  | & _17: MutBorrow.t bool = Any.any_l ()
  | & _18: MutBorrow.t t_Vec_bool_Global = Any.any_l () ])
  [ return (result: t_Pasn) ->
  {[@stop_split] [@expl:set_next ensures] ([@stop_split] [@expl:set_next ensures #0] [%#slib'5] compatible result.assign pa)
    /\ ([@stop_split] [@expl:set_next ensures #1] [%#slib'6] Seq.get (view_Assignments result.assign) (UInt64.t'int pa.ix)
      = b)
