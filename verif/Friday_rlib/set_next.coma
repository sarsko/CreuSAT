    [ s0 = clone_Pasn [%#slib] {pa} (fun (_x: t_Pasn) -> [ &new_pa <- _x ] s1)
    | s1 = MutBorrow.borrow_mut <t_Vec_bool_Global> {new_pa.assign.f0}
        (fun (_bor: MutBorrow.t t_Vec_bool_Global) ->
