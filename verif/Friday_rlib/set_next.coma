    | s2 = index_mut_Vec_bool_Global [%#slib'0] {_18} {pa.ix} (fun (_x: MutBorrow.t bool) -> [ &_17 <- _x ] s3)
    | s3 = [ &_17 <- { _17 with current = b } ] s4
    | s4 = -{resolve_refmut_bool _17}- s5
    | s5 = UInt64.add [%#slib'2] {new_pa.ix} {[%#slib'1] (1: UInt64.t)}
