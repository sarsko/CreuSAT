use creusot.int.UInt64
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_Vec_bool_Global

type t_Assignments = { f0: t_Vec_bool_Global }

type t_Pasn = { assign: t_Assignments; ix: UInt64.t }

constant const_MAX: UInt64.t = [%#suint_macros] (18446744073709551615: UInt64.t)

function view_Vec_bool_Global (self: t_Vec_bool_Global) : Seq.seq bool

axiom view_Vec_bool_Global_spec:
  forall self: t_Vec_bool_Global [view_Vec_bool_Global self]. [%#svec] Seq.length (view_Vec_bool_Global self)
    <= UInt64.t'int const_MAX

function view_Assignments [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Friday/src/lib.rs" 28 4 28 33] (self: t_Assignments) : Seq.seq bool
 = [%#slib'3] view_Vec_bool_Global self.f0

let clone_Assignments (self: t_Assignments) (return (x: t_Assignments)) = any
  [ return (result: t_Assignments) -> {[@stop_split] [@expl:clone ensures] [%#slib'1] view_Assignments result
    = view_Assignments self}
    (! return {result}) ]

predicate eq [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Friday/src/lib.rs" 122 4 122 44] (self: t_Pasn) (rhs: t_Pasn) =
  [%#slib'2] view_Assignments self.assign = view_Assignments rhs.assign /\ self.ix = rhs.ix

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let clone_Pasn [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Friday/src/lib.rs" 53 4 53 27] (self: t_Pasn)
  (return (x: t_Pasn)) = (! bb0
  [ bb0 = s0
    [ s0 = clone_Assignments [%#slib] {self.assign} (fun (_x: t_Assignments) -> [ &_4 <- _x ] s1)
    | s1 = [ &_ret <- { assign = _4; ix = self.ix } ] s2
    | s2 = return {_ret} ] ]
  [ & _ret: t_Pasn = Any.any_l () | & self: t_Pasn = self | & _4: t_Assignments = Any.any_l () ])
  [ return (result: t_Pasn) -> {[@stop_split] [@expl:clone ensures] [%#slib'0] eq self result} (! return {result}) ]
