let rec solve (f: t_Formula) (pa: t_Pasn) (return (x: bool)) =
  {[@stop_split] [@expl:solve requires] ([@stop_split] [@expl:solve 'f' type invariant] [%#slib'7] inv_ref_Formula f)
  /\ ([@stop_split] [@expl:solve requires #0] [%#slib'8] invariant' pa (UInt64.t'int f.num_vars))
  /\ ([@stop_split] [@expl:solve requires #1] [%#slib'9] invariant_ref_Formula f)}
  any
  [ return (result: bool) -> {[@stop_split] [@expl:solve ensures] [%#slib'10] (not result)
    = (forall a: t_Assignments. compatible a pa -> not sat'1 f a)}
    (! return {result}) ]

