let rec solver [#"/Users/sarekhs/Programming/CreuSAT/Friday/src/lib.rs" 214 0 214 34] (f: t_Formula)
  (return (x: bool)) =
  {[@stop_split] [@expl:solver requires] ([@stop_split] [@expl:solver 'f' type invariant] [%#slib'2] inv_ref_Formula f)
  /\ ([@stop_split] [@expl:solver requires] [%#slib'3] invariant_ref_Formula f)}
  (! bb0
  [ bb0 = s0
    [ s0 = from_elem_bool [%#svec] {[%#slib] false} {f.num_vars} (fun (_x: t_Vec_bool_Global) -> [ &_11 <- _x ] s1)
    | s1 = [ &_10 <- { f0 = _11 } ] s2
    | s2 = [ &_9 <- { assign = _10; ix = ([%#slib'0] (0: UInt64.t)) } ] s3
    | s3 = solve [%#slib'1] {f} {_9} (fun (_x: bool) -> [ &_ret <- _x ] s4)
    | s4 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & f: t_Formula = f
  | & _9: t_Pasn = Any.any_l ()
  | & _10: t_Assignments = Any.any_l ()
  | & _11: t_Vec_bool_Global = Any.any_l () ])
  [ return (result: bool) ->
  {[@stop_split] [@expl:solver ensures] ([@stop_split] [@expl:solver ensures #0] [%#slib'4] not result
      -> (forall a: t_Assignments. Seq.length (view_Assignments a) = num_vars'0 f -> not sat'1 f a))
    /\ ([@stop_split] [@expl:solver ensures #1] [%#slib'5] result -> (exists a: t_Assignments. sat'1 f a))}
    (! return {result}) ]
