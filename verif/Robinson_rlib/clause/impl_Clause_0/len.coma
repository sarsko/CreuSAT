  [ bb0 = s0 [ s0 = len_Lit [%#sclause] {self.rest} (fun (_x: UInt64.t) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
  [ & _ret: UInt64.t = Any.any_l () | & self: t_Clause = self ])
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sclause'0] UInt64.t'int result
    = Seq.length (view_Clause self)}
    (! return {result}) ]
