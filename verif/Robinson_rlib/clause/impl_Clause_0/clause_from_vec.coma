(* clause::Clause *)

use creusot.prelude.Any

type t_Vec_Lit_Global

type t_Clause = { rest: t_Vec_Lit_Global }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let clause_from_vec [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Robinson/src/clause.rs" 107 4 107 51]
  (vec: t_Vec_Lit_Global) (return (x: t_Clause)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- { rest = vec } ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_Clause = Any.any_l () | & vec: t_Vec_Lit_Global = vec ])
  [ return (result: t_Clause) -> (! return {result}) ]
