(* #"/Users/sarekhs/Programming/CreuSAT/Robinson/src/logic.rs" 8 0 8 54 *)

let%span slogic = "/Users/sarekhs/Programming/CreuSAT/Robinson/src/logic.rs" 6 10 6 28
let%span slogic'0 = "/Users/sarekhs/Programming/CreuSAT/Robinson/src/logic.rs" 7 10 7 29

use creusot.int.UInt8

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant b : bool

function bool_to_assignedstate [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/logic.rs" 8 0 8 54] (b: bool) : UInt8.t

goal vc_bool_to_assignedstate: if b then
    let result = (1: UInt8.t) in [@stop_split] [@expl:bool_to_assignedstate ensures] ([@stop_split] [@expl:bool_to_assignedstate ensures #0] [%#slogic] b
      -> UInt8.t'int result = 1)
    /\ ([@stop_split] [@expl:bool_to_assignedstate ensures #1] [%#slogic'0] not b -> UInt8.t'int result = 0)
  else
    let result = (0: UInt8.t) in [@stop_split] [@expl:bool_to_assignedstate ensures] ([@stop_split] [@expl:bool_to_assignedstate ensures #0] [%#slogic] b
      -> UInt8.t'int result = 1)
    /\ ([@stop_split] [@expl:bool_to_assignedstate ensures #1] [%#slogic'0] not b -> UInt8.t'int result = 0)
  
