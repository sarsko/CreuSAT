use creusot.int.UInt64
use creusot.int.UInt8
use seq.Seq
use int.Int

type t_Vec_Lit_Global

type t_Clause = { rest: t_Vec_Lit_Global }

type t_Vec_Clause_Global

type t_Formula = { clauses: t_Vec_Clause_Global; num_vars: UInt64.t }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Clause_Global (self: t_Vec_Clause_Global) : Seq.seq t_Clause

axiom view_Vec_Clause_Global_spec: forall self: t_Vec_Clause_Global. [%#svec] Seq.length (view_Vec_Clause_Global self)
    <= UInt64.t'int const_MAX

type t_Lit = { idx: UInt64.t; polarity: bool }

function view_Vec_Lit_Global (self: t_Vec_Lit_Global) : Seq.seq t_Lit

axiom view_Vec_Lit_Global_spec: forall self: t_Vec_Lit_Global. [%#svec] Seq.length (view_Vec_Lit_Global self)
    <= UInt64.t'int const_MAX

function view_Clause [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/clause.rs" 17 4 17 33] (self: t_Clause) : Seq.seq t_Lit
 = [%#sclause'2] view_Vec_Lit_Global self.rest

predicate inv [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/lit.rs" 32 4 32 36] (self: t_Lit) (n: int) =
  [%#slit'2] UInt64.t'int self.idx < n

predicate vars_in_range [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/clause.rs" 77 4 77 46] (self: t_Clause) (n: int) =
  [%#sclause'3] forall i: int. 0 <= i /\ i < Seq.length (view_Clause self) -> inv (Seq.get (view_Clause self) i) n

predicate inv'0 [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/clause.rs" 93 4 93 36] (self: t_Clause) (n: int) =
  [%#sclause'1] vars_in_range self n

predicate inv'1 [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/formula.rs" 34 4 34 28] (self: t_Formula) =
  [%#sformula] forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Clause_Global self.clauses)
    -> inv'0 (Seq.get (view_Vec_Clause_Global self.clauses) i) (UInt64.t'int self.num_vars)

predicate unset [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/logic.rs" 40 0 40 38] (v: UInt8.t) =
  [%#slogic'10] if UInt8.t'int v >= 2 then true else false

predicate sat_inner [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/lit.rs" 37 4 37 57] (self: t_Lit) (a: Seq.seq UInt8.t) =
  [%#slit'3] if self.polarity then
    UInt8.t'int (Seq.get a (UInt64.t'int self.idx)) = 1
  else
    UInt8.t'int (Seq.get a (UInt64.t'int self.idx)) = 0


predicate sat_inner'0 [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/clause.rs" 59 4 59 57] (self: t_Clause) (a: Seq.seq UInt8.t) =
  [%#sclause'4] exists i: int. 0 <= i /\ i < Seq.length (view_Clause self) /\ sat_inner (Seq.get (view_Clause self) i) a

predicate unset_inner [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/lit.rs" 57 4 57 59] (self: t_Lit) (a: Seq.seq UInt8.t) =
  [%#slit'1] UInt8.t'int (Seq.get a (UInt64.t'int self.idx)) >= 2

predicate unit_inner [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/clause.rs" 32 4 32 58] (self: t_Clause) (a: Seq.seq UInt8.t) =
  [%#sclause] vars_in_range self (Seq.length a)
  /\ not sat_inner'0 self a
  /\ (exists i: int. 0 <= i
    /\ i < Seq.length (view_Clause self)
    /\ unset_inner (Seq.get (view_Clause self) i) a
    /\ (forall j: int. 0 <= j /\ j < Seq.length (view_Clause self) /\ j <> i
      -> not unset_inner (Seq.get (view_Clause self) j) a))

predicate in_formula [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/clause.rs" 24 4 24 47] (self: t_Clause) (f: t_Formula) =
  [%#sclause'0] exists i: int. 0 <= i
    /\ i < Seq.length (view_Vec_Clause_Global f.clauses) /\ Seq.get (view_Vec_Clause_Global f.clauses) i = self

function index [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/lit.rs" 17 4 17 35] [@inline:trivial] (self: t_Lit) : int
 = [%#slit] UInt64.t'int self.idx

meta "rewrite_def" function index

function bool_to_assignedstate [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/logic.rs" 8 0 8 54] (b: bool) : UInt8.t
 = [%#slogic'13] if b then (1: UInt8.t) else (0: UInt8.t)

axiom bool_to_assignedstate_spec: forall b: bool. [%#slogic'11] b -> UInt8.t'int (bool_to_assignedstate b) = 1

axiom bool_to_assignedstate_spec'0: forall b: bool. [%#slogic'12] not b -> UInt8.t'int (bool_to_assignedstate b) = 0

predicate unsat_inner [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/lit.rs" 47 4 47 59] (self: t_Lit) (a: Seq.seq UInt8.t) =
  [%#slit'0] if self.polarity then
    UInt8.t'int (Seq.get a (UInt64.t'int self.idx)) = 0
  else
    UInt8.t'int (Seq.get a (UInt64.t'int self.idx)) = 1


predicate compatible_inner [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/assignments.rs" 22 0 22 78] (a: Seq.seq UInt8.t) (a2: Seq.seq UInt8.t) =
  [%#sassignments'0] Seq.length a = Seq.length a2
  /\ (forall i: int. 0 <= i /\ i < Seq.length a -> unset (Seq.get a i) \/ Seq.get a i = Seq.get a2 i)

predicate complete_inner [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/assignments.rs" 30 0 30 52] (a: Seq.seq UInt8.t) =
  [%#sassignments'1] forall i: int. 0 <= i /\ i < Seq.length a -> not unset (Seq.get a i)

predicate compatible_complete_inner [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/assignments.rs" 37 0 37 87] (a: Seq.seq UInt8.t) (a2: Seq.seq UInt8.t) =
  [%#sassignments] compatible_inner a a2 /\ complete_inner a2

predicate sat_inner'1 [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/formula.rs" 78 4 78 57] (self: t_Formula) (a: Seq.seq UInt8.t) =
  [%#sformula'2] forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Clause_Global self.clauses)
    -> sat_inner'0 (Seq.get (view_Vec_Clause_Global self.clauses) i) a

predicate eventually_sat_complete_inner [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/formula.rs" 61 4 61 77] (self: t_Formula) (a: Seq.seq UInt8.t) =
  [%#sformula'0] exists a2: Seq.seq UInt8.t. Seq.length a2 = UInt64.t'int self.num_vars
    /\ compatible_complete_inner a a2 /\ sat_inner'1 self a2

function flip_v [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/logic.rs" 17 0 17 48] (v: UInt8.t) : UInt8.t =
  [%#slogic'14] if UInt8.t'int v = 0 then (1: UInt8.t) else if UInt8.t'int v = 1 then (0: UInt8.t) else v

predicate unsat_inner'0 [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/clause.rs" 46 4 46 59] (self: t_Clause) (a: Seq.seq UInt8.t) =
  [%#sclause'5] forall i: int. 0 <= i /\ i < Seq.length (view_Clause self)
    -> unsat_inner (Seq.get (view_Clause self) i) a

predicate unsat_inner'1 [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/formula.rs" 91 4 91 59] (self: t_Formula) (a: Seq.seq UInt8.t) =
  [%#sformula'1] exists i: int. 0 <= i
    /\ i < Seq.length (view_Vec_Clause_Global self.clauses)
    /\ unsat_inner'0 (Seq.get (view_Vec_Clause_Global self.clauses) i) a

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant c : t_Clause

constant f : t_Formula

constant a : Seq.seq UInt8.t

constant ix : int

constant v : UInt8.t

function lemma_unit_wrong_polarity_unsat_formula [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/logic.rs" 72 0 74 1] (c: t_Clause) (f: t_Formula) (a: Seq.seq UInt8.t) (ix: int) (v: UInt8.t) : ()

goal vc_lemma_unit_wrong_polarity_unsat_formula: ([%#slogic] inv'1 f)
  -> ([%#slogic'0] UInt64.t'int f.num_vars = Seq.length a)
  -> ([%#slogic'1] 0 <= ix /\ ix < Seq.length a /\ unset (Seq.get a ix))
  -> ([%#slogic'2] not unset v)
  -> ([%#slogic'3] unit_inner c a)
  -> ([%#slogic'4] in_formula c f)
  -> ([%#slogic'5] inv'0 c (Seq.length a))
  -> ([%#slogic'6] exists j: int. 0 <= j
      /\ j < Seq.length (view_Clause c)
      /\ index (Seq.get (view_Clause c) j) = ix /\ bool_to_assignedstate (Seq.get (view_Clause c) j).polarity = v)
  -> ([%#slogic'7] forall j: int. 0 <= j /\ j < Seq.length (view_Clause c) /\ not index (Seq.get (view_Clause c) j) = ix
      -> unsat_inner (Seq.get (view_Clause c) j) a)
  -> ([@stop_split] [@expl:lemma_unit_wrong_polarity_unsat_formula ensures] ([@stop_split] [@expl:lemma_unit_wrong_polarity_unsat_formula ensures #0] [%#slogic'8] not eventually_sat_complete_inner f (Seq.set a ix (flip_v v)))
  /\ ([@stop_split] [@expl:lemma_unit_wrong_polarity_unsat_formula ensures #1] [%#slogic'9] unsat_inner'1 f (Seq.set a ix (flip_v v))))
