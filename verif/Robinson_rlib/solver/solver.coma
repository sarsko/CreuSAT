type t_Vec_Clause_Global

type t_Formula = { clauses: t_Vec_Clause_Global; num_vars: UInt64.t }

type t_Vec_u8_Global

type t_SatResult = Sat t_Vec_u8_Global | Unsat | Unknown

type t_Vec_Lit_Global

type t_Clause = { rest: t_Vec_Lit_Global }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Clause_Global (self: t_Vec_Clause_Global) : Seq.seq t_Clause

axiom view_Vec_Clause_Global_spec: forall self: t_Vec_Clause_Global. [%#svec'0] Seq.length (view_Vec_Clause_Global self)
    <= UInt64.t'int const_MAX

type t_Lit = { idx: UInt64.t; polarity: bool }

function view_Vec_Lit_Global (self: t_Vec_Lit_Global) : Seq.seq t_Lit

axiom view_Vec_Lit_Global_spec: forall self: t_Vec_Lit_Global. [%#svec'0] Seq.length (view_Vec_Lit_Global self)
    <= UInt64.t'int const_MAX

function view_Clause [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/clause.rs" 17 4 17 33] (self: t_Clause) : Seq.seq t_Lit
 = [%#sclause'0] view_Vec_Lit_Global self.rest

predicate inv [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/lit.rs" 32 4 32 36] (self: t_Lit) (n: int) =
  [%#slit] UInt64.t'int self.idx < n

predicate vars_in_range [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/clause.rs" 77 4 77 46] (self: t_Clause) (n: int) =
  [%#sclause] forall i: int. 0 <= i /\ i < Seq.length (view_Clause self) -> inv (Seq.get (view_Clause self) i) n

predicate sat_inner [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/lit.rs" 37 4 37 57] (self: t_Lit) (a: Seq.seq UInt8.t) =
  [%#slit'0] if self.polarity then
    UInt8.t'int (Seq.get a (UInt64.t'int self.idx)) = 1
  else
    UInt8.t'int (Seq.get a (UInt64.t'int self.idx)) = 0


predicate sat_inner'0 [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/clause.rs" 59 4 59 57] (self: t_Clause) (a: Seq.seq UInt8.t) =
  [%#sclause'1] exists i: int. 0 <= i /\ i < Seq.length (view_Clause self) /\ sat_inner (Seq.get (view_Clause self) i) a

predicate sat_inner'1 [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/formula.rs" 78 4 78 57] (self: t_Formula) (a: Seq.seq UInt8.t) =
  [%#sformula'10] forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Clause_Global self.clauses)
    -> sat_inner'0 (Seq.get (view_Vec_Clause_Global self.clauses) i) a

predicate eventually_sat_no_ass [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/formula.rs" 49 4 49 46] (self: t_Formula) =
  [%#sformula'2] exists a2: Seq.seq UInt8.t. sat_inner'1 self a2

type tup2_Seq_Clause_Int = { f0: Seq.seq t_Clause; f1: int }

predicate formula_sat_inner [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/formula.rs" 24 0 24 78] (f: tup2_Seq_Clause_Int) (a: Seq.seq UInt8.t) =
  [%#sformula'4] forall i: int. 0 <= i /\ i < Seq.length f.f0 -> sat_inner'0 (Seq.get f.f0 i) a

function view_Formula [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/formula.rs" 18 4 18 33] (self: t_Formula) : tup2_Seq_Clause_Int
 = [%#sformula'5] { f0 = view_Vec_Clause_Global self.clauses; f1 = UInt64.t'int self.num_vars }

function view_Vec_u8_Global (self: t_Vec_u8_Global) : Seq.seq UInt8.t

axiom view_Vec_u8_Global_spec: forall self: t_Vec_u8_Global. [%#svec'0] Seq.length (view_Vec_u8_Global self)
    <= UInt64.t'int const_MAX

predicate contains_empty_clause [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/formula.rs" 104 4 104 46] (self: t_Formula) =
  [%#sformula'6] exists i: int. 0 <= i
    /\ i < Seq.length (view_Vec_Clause_Global self.clauses)
    /\ Seq.length (view_Clause (Seq.get (view_Vec_Clause_Global self.clauses) i)) = 0

predicate unset [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/logic.rs" 40 0 40 38] (v: UInt8.t) =
  [%#slogic] if UInt8.t'int v >= 2 then true else false

predicate complete_inner [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/assignments.rs" 30 0 30 52] (a: Seq.seq UInt8.t) =
  [%#sassignments'4] forall i: int. 0 <= i /\ i < Seq.length a -> not unset (Seq.get a i)

predicate eventually_sat_complete_no_ass [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/formula.rs" 54 4 54 55] (self: t_Formula) =
  [%#sformula'3] exists a2: Seq.seq UInt8.t. Seq.length a2 = UInt64.t'int self.num_vars
    /\ complete_inner a2 /\ sat_inner'1 self a2

predicate inv'0 [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/clause.rs" 93 4 93 36] (self: t_Clause) (n: int) =
  [%#sclause'2] vars_in_range self n

predicate inv'1 [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/formula.rs" 34 4 34 28] (self: t_Formula) =
  [%#sformula'7] forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Clause_Global self.clauses)
    -> inv'0 (Seq.get (view_Vec_Clause_Global self.clauses) i) (UInt64.t'int self.num_vars)

let rec check_and_establish_formula_invariant (self: MutBorrow.t t_Formula) (return (x: t_SatResult)) =
  {[@stop_split] [@expl:check_and_establish_formula_invariant requires] [%#sformula] forall i: int. 0 <= i
      /\ i < Seq.length (view_Vec_Clause_Global self.current.clauses)
    -> vars_in_range (Seq.get (view_Vec_Clause_Global self.current.clauses) i) (UInt64.t'int const_MAX)}
  any
  [ return (result: t_SatResult) ->
  {[@stop_split] [@expl:check_and_establish_formula_invariant ensures] ([@stop_split] [@expl:check_and_establish_formula_invariant ensures #0] [%#sformula'0] match result with
        | Sat assn -> eventually_sat_no_ass self.final
        /\ formula_sat_inner (view_Formula self.current) (view_Vec_u8_Global assn)
        | Unsat -> contains_empty_clause self.final /\ not eventually_sat_complete_no_ass self.current
        | Unknown -> inv'1 self.final
        end)
    /\ ([@stop_split] [@expl:check_and_establish_formula_invariant ensures #1] [%#sformula'1] self.current.clauses
    = self.final.clauses)}
    (! return {result}) ]

predicate resolve_refmut_Formula [@inline:trivial] (_1: MutBorrow.t t_Formula) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Formula

type t_Assignments = { f0'0: t_Vec_u8_Global; f1'0: UInt64.t }

function view_Assignments [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/assignments.rs" 16 4 16 33] (self: t_Assignments) : Seq.seq UInt8.t
 = [%#sassignments'3] view_Vec_u8_Global self.f0'0

predicate inv'2 [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/assignments.rs" 49 4 49 40] (self: t_Assignments) (f: t_Formula) =
  [%#sassignments'2] UInt64.t'int f.num_vars = Seq.length (view_Assignments self)
  /\ UInt64.t'int self.f1'0 <= UInt64.t'int f.num_vars

let rec new (f: t_Formula) (return (x: t_Assignments)) = {[@stop_split] [@expl:new requires] [%#sassignments] inv'1 f}
  any
  [ return (result: t_Assignments) ->
  {[@stop_split] [@expl:new ensures] ([@stop_split] [@expl:new ensures #0] [%#sassignments'0] inv'2 result f)
    /\ ([@stop_split] [@expl:new ensures #1] [%#sassignments'1] forall i: int. 0 <= i
        /\ i < Seq.length (view_Assignments result) -> unset (Seq.get (view_Assignments result) i))}
    (! return {result}) ]

type t_Vec_usize_Global

type t_Decisions = { lit_order: t_Vec_usize_Global }

function view_Vec_usize_Global (self: t_Vec_usize_Global) : Seq.seq UInt64.t

axiom view_Vec_usize_Global_spec: forall self: t_Vec_usize_Global. [%#svec'0] Seq.length (view_Vec_usize_Global self)
    <= UInt64.t'int const_MAX

predicate inv'3 [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/decision.rs" 11 4 11 36] (self: t_Decisions) (n: int) =
  [%#sdecision'1] Seq.length (view_Vec_usize_Global self.lit_order) = n
  /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_usize_Global self.lit_order)
    -> UInt64.t'int (Seq.get (view_Vec_usize_Global self.lit_order) i) < n)

let rec new'0 (f: t_Formula) (return (x: t_Decisions)) = {[@stop_split] [@expl:new requires] [%#sdecision] inv'1 f}
  any
  [ return (result: t_Decisions) ->
  {[@stop_split] [@expl:new ensures] [%#sdecision'0] inv'3 result (UInt64.t'int f.num_vars)}
    (! return {result}) ]

predicate compatible_inner [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/assignments.rs" 22 0 22 78] (a: Seq.seq UInt8.t) (a2: Seq.seq UInt8.t) =
  [%#sassignments'5] Seq.length a = Seq.length a2
  /\ (forall i: int. 0 <= i /\ i < Seq.length a -> unset (Seq.get a i) \/ Seq.get a i = Seq.get a2 i)

predicate eventually_sat_inner [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/formula.rs" 42 4 42 68] (self: t_Formula) (a: Seq.seq UInt8.t) =
  [%#sformula'11] exists a2: Seq.seq UInt8.t. Seq.length a2 = UInt64.t'int self.num_vars
    /\ compatible_inner a a2 /\ sat_inner'1 self a2

predicate eventually_sat [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/formula.rs" 73 4 73 55] (self: t_Formula) (a: t_Assignments) =
  [%#sformula'8] eventually_sat_inner self (view_Assignments a)

predicate compatible_complete_inner [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/assignments.rs" 37 0 37 87] (a: Seq.seq UInt8.t) (a2: Seq.seq UInt8.t) =
  [%#sassignments'6] compatible_inner a a2 /\ complete_inner a2

predicate eventually_sat_complete_inner [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/formula.rs" 61 4 61 77] (self: t_Formula) (a: Seq.seq UInt8.t) =
  [%#sformula'12] exists a2: Seq.seq UInt8.t. Seq.length a2 = UInt64.t'int self.num_vars
    /\ compatible_complete_inner a a2 /\ sat_inner'1 self a2

predicate eventually_sat_complete [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/formula.rs" 68 4 68 64] (self: t_Formula) (a: t_Assignments) =
  [%#sformula'9] eventually_sat_complete_inner self (view_Assignments a)

let rec inner (f: t_Formula) (a: t_Assignments) (d: t_Decisions) (return (x: bool)) =
  {[@stop_split] [@expl:inner requires] ([@stop_split] [@expl:inner requires #0] [%#ssolver'9] inv'1 f)
  /\ ([@stop_split] [@expl:inner requires #1] [%#ssolver'10] inv'2 a f)
  /\ ([@stop_split] [@expl:inner requires #2] [%#ssolver'11] inv'3 d (UInt64.t'int f.num_vars))}
  any
  [ return (result: bool) ->
  {[@stop_split] [@expl:inner ensures] ([@stop_split] [@expl:inner ensures #0] [%#ssolver'12] result = true
      -> eventually_sat f a)
    /\ ([@stop_split] [@expl:inner ensures #1] [%#ssolver'13] result = false -> not eventually_sat_complete f a)}
    (! return {result}) ]

let rec new_u8 (return (x: t_Vec_u8_Global)) = any
  [ return (result: t_Vec_u8_Global) ->
  {[@stop_split] [@expl:new ensures] [%#svec] Seq.length (view_Vec_u8_Global result) = 0}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec solver [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/solver.rs" 46 0 46 49]
  (formula: MutBorrow.t t_Formula) (return (x: t_SatResult)) =
  {[@stop_split] [@expl:solver requires] [%#ssolver'6] forall i: int. 0 <= i
      /\ i < Seq.length (view_Vec_Clause_Global formula.current.clauses)
    -> vars_in_range (Seq.get (view_Vec_Clause_Global formula.current.clauses) i) (UInt64.t'int const_MAX)}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &old_f <- [%#ssolver] formula ] s1
    | s1 = MutBorrow.borrow_final <t_Formula> {formula.current} {MutBorrow.get_id formula}
        (fun (_bor: MutBorrow.t t_Formula) -> [ &_14 <- _bor ] [ &formula <- { formula with current = _bor.final } ] s2)
    | s2 = check_and_establish_formula_invariant [%#ssolver'0] {_14} (fun (_x: t_SatResult) -> [ &_13 <- _x ] s3)
    | s3 = any
      [ br0 (x0: t_Vec_u8_Global) -> {_13 = Sat x0} (! bb3)
      | br1 -> {_13 = Unsat} (! bb3)
      | br2 -> {_13 = Unknown} (! bb6) ] ]
  | bb3 = s0
    [ s0 = -{resolve_refmut_Formula formula}- s1 | s1 = [ &o <- _13 ] s2 | s2 = [ &_ret <- o ] s3 | s3 = return {_ret} ]
  | bb6 = s0
    [ s0 = {[@expl:assertion] [%#ssolver'1] formula.current.clauses = old_f.current.clauses} s1
    | s1 = new [%#ssolver'2] {formula.current} (fun (_x: t_Assignments) -> [ &assignments <- _x ] s2)
    | s2 = new'0 [%#ssolver'3] {formula.current} (fun (_x: t_Decisions) -> [ &decisions <- _x ] s3)
    | s3 = -{resolve_refmut_Formula formula}- s4
    | s4 = [ &_31 <- decisions ] s5
    | s5 = inner [%#ssolver'4] {formula.current} {assignments} {_31} (fun (_x: bool) -> [ &_27 <- _x ] s6)
    | s6 = any [ br0 -> {_27 = false} (! bb14) | br1 -> {_27} (! bb10) ] ]
  | bb10 = s0
    [ s0 = new_u8 [%#ssolver'5] (fun (_x: t_Vec_u8_Global) -> [ &_33 <- _x ] s1)
    | s1 = [ &_ret <- Sat _33 ] s2
    | s2 = return {_ret} ]
  | bb14 = s0 [ s0 = [ &_ret <- Unsat ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_SatResult = Any.any_l ()
  | & formula: MutBorrow.t t_Formula = formula
  | & old_f: MutBorrow.t t_Formula = Any.any_l ()
  | & _13: t_SatResult = Any.any_l ()
  | & _14: MutBorrow.t t_Formula = Any.any_l ()
  | & o: t_SatResult = Any.any_l ()
  | & assignments: t_Assignments = Any.any_l ()
  | & decisions: t_Decisions = Any.any_l ()
  | & _27: bool = Any.any_l ()
  | & _31: t_Decisions = Any.any_l ()
  | & _33: t_Vec_u8_Global = Any.any_l () ])
  [ return (result: t_SatResult) ->
  {[@stop_split] [@expl:solver ensures] ([@stop_split] [@expl:solver ensures #0] [%#ssolver'7] match result with
        | Sat _assn -> eventually_sat_no_ass formula.final
        | Unsat -> not eventually_sat_complete_no_ass formula.final
        | _ -> false
        end)
    /\ ([@stop_split] [@expl:solver ensures #1] [%#ssolver'8] formula.final.clauses = formula.current.clauses)}
    (! return {result}) ]
