    <= UInt64.t'int const_MAX

function view_Clause [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/clause.rs" 17 4 17 33] (self: t_Clause) : Seq.seq t_Lit
 = [%#sclause'3] view_Vec_Lit_Global self.rest

predicate inv [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/lit.rs" 32 4 32 36] (self: t_Lit) (n: int) =
  [%#slit] UInt64.t'int self.idx < n

predicate vars_in_range [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/clause.rs" 77 4 77 46] (self: t_Clause) (n: int) =
  [%#sclause'0] forall i: int. 0 <= i /\ i < Seq.length (view_Clause self) -> inv (Seq.get (view_Clause self) i) n

predicate inv'0 [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/clause.rs" 93 4 93 36] (self: t_Clause) (n: int) =
  [%#sclause] vars_in_range self n

predicate inv'1 [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/formula.rs" 34 4 34 28] (self: t_Formula) =
  [%#sformula] forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Clause_Global self.clauses)
    -> inv'0 (Seq.get (view_Vec_Clause_Global self.clauses) i) (UInt64.t'int self.num_vars)

function view_Vec_u8_Global (self: t_Vec_u8_Global) : Seq.seq UInt8.t

axiom view_Vec_u8_Global_spec: forall self: t_Vec_u8_Global. [%#svec'4] Seq.length (view_Vec_u8_Global self)
    <= UInt64.t'int const_MAX

function view_Assignments [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/assignments.rs" 16 4 16 33] (self: t_Assignments) : Seq.seq UInt8.t
 = [%#sassignments'17] view_Vec_u8_Global self.f0

predicate inv'2 [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/assignments.rs" 49 4 49 40] (self: t_Assignments) (f: t_Formula) =
  [%#sassignments'14] UInt64.t'int f.num_vars = Seq.length (view_Assignments self)
  /\ UInt64.t'int self.f1 <= UInt64.t'int f.num_vars

predicate unset [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/logic.rs" 40 0 40 38] (v: UInt8.t) =
  [%#slogic] if UInt8.t'int v >= 2 then true else false

predicate compatible_inner [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/assignments.rs" 22 0 22 78] (a: Seq.seq UInt8.t) (a2: Seq.seq UInt8.t) =
  [%#sassignments'18] Seq.length a = Seq.length a2
  /\ (forall i: int. 0 <= i /\ i < Seq.length a -> unset (Seq.get a i) \/ Seq.get a i = Seq.get a2 i)

predicate complete_inner [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/assignments.rs" 30 0 30 52] (a: Seq.seq UInt8.t) =
  [%#sassignments'20] forall i: int. 0 <= i /\ i < Seq.length a -> not unset (Seq.get a i)

predicate compatible_complete_inner [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/assignments.rs" 37 0 37 87] (a: Seq.seq UInt8.t) (a2: Seq.seq UInt8.t) =
  [%#sassignments'19] compatible_inner a a2 /\ complete_inner a2

predicate sat_inner [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/lit.rs" 37 4 37 57] (self: t_Lit) (a: Seq.seq UInt8.t) =
  [%#slit'1] if self.polarity then
    UInt8.t'int (Seq.get a (UInt64.t'int self.idx)) = 1
  else
    UInt8.t'int (Seq.get a (UInt64.t'int self.idx)) = 0


predicate sat_inner'0 [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/clause.rs" 59 4 59 57] (self: t_Clause) (a: Seq.seq UInt8.t) =
  [%#sclause'2] exists i: int. 0 <= i /\ i < Seq.length (view_Clause self) /\ sat_inner (Seq.get (view_Clause self) i) a

predicate sat_inner'1 [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/formula.rs" 78 4 78 57] (self: t_Formula) (a: Seq.seq UInt8.t) =
  [%#sformula'7] forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Clause_Global self.clauses)
    -> sat_inner'0 (Seq.get (view_Vec_Clause_Global self.clauses) i) a

predicate eventually_sat_complete_inner [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/formula.rs" 61 4 61 77] (self: t_Formula) (a: Seq.seq UInt8.t) =
  [%#sformula'5] exists a2: Seq.seq UInt8.t. Seq.length a2 = UInt64.t'int self.num_vars
    /\ compatible_complete_inner a a2 /\ sat_inner'1 self a2

predicate eventually_sat_complete [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/formula.rs" 68 4 68 64] (self: t_Formula) (a: t_Assignments) =
  [%#sformula'1] eventually_sat_complete_inner self (view_Assignments a)

predicate compatible [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/assignments.rs" 56 4 56 52] (self: t_Assignments) (a2: t_Assignments) =
  [%#sassignments'15] compatible_inner (view_Assignments self) (view_Assignments a2)

predicate unsat_inner [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/lit.rs" 47 4 47 59] (self: t_Lit) (a: Seq.seq UInt8.t) =
  [%#slit'0] if self.polarity then
    UInt8.t'int (Seq.get a (UInt64.t'int self.idx)) = 0
  else
    UInt8.t'int (Seq.get a (UInt64.t'int self.idx)) = 1


predicate unsat_inner'0 [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/clause.rs" 46 4 46 59] (self: t_Clause) (a: Seq.seq UInt8.t) =
  [%#sclause'1] forall i: int. 0 <= i /\ i < Seq.length (view_Clause self)
    -> unsat_inner (Seq.get (view_Clause self) i) a

predicate unsat_inner'1 [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/formula.rs" 91 4 91 59] (self: t_Formula) (a: Seq.seq UInt8.t) =
  [%#sformula'6] exists i: int. 0 <= i
    /\ i < Seq.length (view_Vec_Clause_Global self.clauses)
    /\ unsat_inner'0 (Seq.get (view_Vec_Clause_Global self.clauses) i) a

predicate unsat [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/formula.rs" 99 4 99 46] (self: t_Formula) (a: t_Assignments) =
  [%#sformula'2] unsat_inner'1 self (view_Assignments a)

predicate sat [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/formula.rs" 86 4 86 44] (self: t_Formula) (a: t_Assignments) =
  [%#sformula'3] sat_inner'1 self (view_Assignments a)

predicate complete [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/assignments.rs" 61 4 61 33] (self: t_Assignments) =
  [%#sassignments'16] forall i: int. 0 <= i /\ i < Seq.length (view_Assignments self)
    -> not unset (Seq.get (view_Assignments self) i)

let rec do_unit_propagation (self: MutBorrow.t t_Assignments) (f: t_Formula) (return (x: t_Option_bool)) =
  {[@stop_split] [@expl:do_unit_propagation requires] ([@stop_split] [@expl:do_unit_propagation requires #0] [%#sassignments] inv'1 f)
  /\ ([@stop_split] [@expl:do_unit_propagation requires #1] [%#sassignments'0] inv'2 self.current f)}
  any
  [ return (result: t_Option_bool) ->
  {[@stop_split] [@expl:do_unit_propagation ensures] ([@stop_split] [@expl:do_unit_propagation ensures #0] [%#sassignments'0] inv'2 self.final f)
    /\ ([@stop_split] [@expl:do_unit_propagation ensures #1] [%#sassignments'1] eventually_sat_complete f self.current
      = eventually_sat_complete f self.final)
    /\ ([@stop_split] [@expl:do_unit_propagation ensures #2] [%#sassignments'2] compatible self.current self.final)
    /\ ([@stop_split] [@expl:do_unit_propagation ensures #3] [%#sassignments'3] result = Some false
      -> unsat f self.final)
    /\ ([@stop_split] [@expl:do_unit_propagation ensures #4] [%#sassignments'4] result = Some true -> sat f self.final)
    /\ ([@stop_split] [@expl:do_unit_propagation ensures #5] [%#sassignments'5] result = None
    -> not complete self.final)}
    (! return {result}) ]

type t_Vec_usize_Global

type t_Decisions = { lit_order: t_Vec_usize_Global }

function view_Vec_usize_Global (self: t_Vec_usize_Global) : Seq.seq UInt64.t

axiom view_Vec_usize_Global_spec: forall self: t_Vec_usize_Global. [%#svec'4] Seq.length (view_Vec_usize_Global self)
    <= UInt64.t'int const_MAX

predicate inv'3 [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/decision.rs" 11 4 11 36] (self: t_Decisions) (n: int) =
  [%#sdecision] Seq.length (view_Vec_usize_Global self.lit_order) = n
  /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_usize_Global self.lit_order)
    -> UInt64.t'int (Seq.get (view_Vec_usize_Global self.lit_order) i) < n)

let rec find_unassigned (self: MutBorrow.t t_Assignments) (d: t_Decisions) (_f: t_Formula) (return (x: UInt64.t)) =
  {[@stop_split] [@expl:find_unassigned requires] ([@stop_split] [@expl:find_unassigned requires #0] [%#sassignments'6] inv'2 self.current _f)
  /\ ([@stop_split] [@expl:find_unassigned requires #1] [%#sassignments'7] not complete self.current)
  /\ ([@stop_split] [@expl:find_unassigned requires #2] [%#sassignments'8] inv'3 d (Seq.length (view_Assignments self.current)))}
  any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:find_unassigned ensures] ([@stop_split] [@expl:find_unassigned ensures #0] [%#sassignments'6] inv'2 self.final _f)
    /\ ([@stop_split] [@expl:find_unassigned ensures #1] [%#sassignments'9] UInt64.t'int result
        < Seq.length (view_Assignments self.current)
      /\ unset (Seq.get (view_Assignments self.current) (UInt64.t'int result)))
    /\ ([@stop_split] [@expl:find_unassigned ensures #2] [%#sassignments'10] view_Assignments self.current
    = view_Assignments self.final)}
    (! return {result}) ]

let rec clone' (self: t_Assignments) (return (x: t_Assignments)) = any
  [ return (result: t_Assignments) ->
  {[@stop_split] [@expl:clone ensures] ([@stop_split] [@expl:clone ensures #0] [%#sassignments'11] forall i: int. 0 <= i
          /\ i < Seq.length (view_Assignments self)
        -> Seq.get (view_Assignments self) i = Seq.get (view_Assignments result) i)
    /\ ([@stop_split] [@expl:clone ensures #1] [%#sassignments'12] Seq.length (view_Assignments self)
      = Seq.length (view_Assignments result))
    /\ ([@stop_split] [@expl:clone ensures #2] [%#sassignments'13] UInt64.t'int result.f1 = UInt64.t'int self.f1)}
    (! return {result}) ]

predicate in_bounds_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq UInt8.t) =
  [%#sslice] UInt64.t'int self < Seq.length seq

meta "rewrite_def" predicate in_bounds_usize

predicate has_value_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq UInt8.t) (out: UInt8.t) =
  [%#sslice'0] Seq.get seq (UInt64.t'int self) = out

meta "rewrite_def" predicate has_value_usize

predicate resolve_elswhere_usize [@inline:trivial] (self: UInt64.t) (old': Seq.seq UInt8.t) (fin: Seq.seq UInt8.t) =
  [%#sslice'1] forall i: int. 0 <= i /\ i <> UInt64.t'int self /\ i < Seq.length old' -> Seq.get old' i = Seq.get fin i

meta "rewrite_def" predicate resolve_elswhere_usize

let rec index_mut_Vec_u8_Global (self_: MutBorrow.t t_Vec_u8_Global) (ix: UInt64.t) (return (x: MutBorrow.t UInt8.t)) =
  {[@stop_split] [@expl:index_mut requires] [%#svec] in_bounds_usize ix (view_Vec_u8_Global self_.current)}
  any
  [ return (result: MutBorrow.t UInt8.t) ->
  {[@stop_split] [@expl:index_mut_Vec_u8_Global ensures] ([@stop_split] [@expl:index_mut ensures #0] [%#svec'0] has_value_usize ix (view_Vec_u8_Global self_.current) result.current)
    /\ ([@stop_split] [@expl:index_mut ensures #1] [%#svec'1] has_value_usize ix (view_Vec_u8_Global self_.final) result.final)
    /\ ([@stop_split] [@expl:index_mut ensures #2] [%#svec'2] resolve_elswhere_usize ix (view_Vec_u8_Global self_.current) (view_Vec_u8_Global self_.final))
    /\ ([@stop_split] [@expl:index_mut ensures #3] [%#svec'3] Seq.length (view_Vec_u8_Global self_.final)
    = Seq.length (view_Vec_u8_Global self_.current))}
    (! return {result}) ]

predicate resolve_refmut_u8 [@inline:trivial] (_1: MutBorrow.t UInt8.t) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_u8

let rec elim_Some (_x: t_Option_bool) (return (f0'0: bool)) = any
  [ _k (f0'0: bool) -> {Some f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

predicate eventually_sat_inner [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/formula.rs" 42 4 42 68] (self: t_Formula) (a: Seq.seq UInt8.t) =
  [%#sformula'4] exists a2: Seq.seq UInt8.t. Seq.length a2 = UInt64.t'int self.num_vars
    /\ compatible_inner a a2 /\ sat_inner'1 self a2

predicate eventually_sat [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/formula.rs" 73 4 73 55] (self: t_Formula) (a: t_Assignments) =
  [%#sformula'0] eventually_sat_inner self (view_Assignments a)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec inner [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/solver.rs" 16 0 16 64] (f: t_Formula)
  (a: t_Assignments) (d: t_Decisions) (return (x: bool)) =
  {[@stop_split] [@expl:inner requires] ([@stop_split] [@expl:inner requires #0] [%#ssolver'9] inv'1 f)
  /\ ([@stop_split] [@expl:inner requires #1] [%#ssolver'10] inv'2 a f)
  /\ ([@stop_split] [@expl:inner requires #2] [%#ssolver'11] inv'3 d (UInt64.t'int f.num_vars))}
  (! bb0
  [ bb0 = s0
    [ s0 = MutBorrow.borrow_mut <t_Assignments> {a}
        (fun (_bor: MutBorrow.t t_Assignments) -> [ &_21 <- _bor ] [ &a <- _bor.final ] s1)
    | s1 = do_unit_propagation [%#ssolver] {_21} {f} (fun (_x: t_Option_bool) -> [ &_20 <- _x ] s2)
    | s2 = any [ br0 -> {_20 = None} (! bb2) | br1 (x0: bool) -> {_20 = Some x0} (! bb4) ] ]
  | bb2 = s0
    [ s0 = MutBorrow.borrow_mut <t_Assignments> {a}
        (fun (_bor: MutBorrow.t t_Assignments) -> [ &_27 <- _bor ] [ &a <- _bor.final ] s1)
    | s1 = find_unassigned [%#ssolver'0] {_27} {d} {f} (fun (_x: UInt64.t) -> [ &next <- _x ] s2)
    | s2 = clone' [%#ssolver'1] {a} (fun (_x: t_Assignments) -> [ &a_cloned <- _x ] s3)
    | s3 = MutBorrow.borrow_mut <t_Vec_u8_Global> {a.f0}
        (fun (_bor: MutBorrow.t t_Vec_u8_Global) -> [ &_33 <- _bor ] [ &a <- { a with f0 = _bor.final } ] s4)
    | s4 = index_mut_Vec_u8_Global [%#ssolver'2] {_33} {next} (fun (_x: MutBorrow.t UInt8.t) -> [ &_32 <- _x ] s5)
    | s5 = [ &_32 <- { _32 with current = ([%#ssolver'3] (1: UInt8.t)) } ] s6
    | s6 = -{resolve_refmut_u8 _32}- s7
    | s7 = [ &old_a1 <- a.f1 ] s8
    | s8 = inner [%#ssolver'4] {f} {a} {d} (fun (_x: bool) -> [ &_37 <- _x ] s9)
    | s9 = any [ br0 -> {_37 = false} (! bb11) | br1 -> {_37} (! bb9) ] ]
  | bb9 = s0 [ s0 = [ &_ret <- [%#ssolver'5] true ] s1 | s1 = return {_ret} ]
  | bb11 = s0
    [ s0 = MutBorrow.borrow_mut <t_Vec_u8_Global> {a_cloned.f0}
        (fun (_bor: MutBorrow.t t_Vec_u8_Global) ->
          [ &_43 <- _bor ] [ &a_cloned <- { a_cloned with f0 = _bor.final } ] s1)
    | s1 = index_mut_Vec_u8_Global [%#ssolver'6] {_43} {next} (fun (_x: MutBorrow.t UInt8.t) -> [ &_42 <- _x ] s2)
    | s2 = [ &_42 <- { _42 with current = ([%#ssolver'7] (0: UInt8.t)) } ] s3
    | s3 = -{resolve_refmut_u8 _42}- s4
    | s4 = [ &a_cloned <- { a_cloned with f1 = old_a1 } ] s5
    | s5 = inner [%#ssolver'8] {f} {a_cloned} {d} (fun (_x: bool) -> [ &_ret <- _x ] s6)
    | s6 = return {_ret} ]
  | bb4 = s0
    [ s0 = elim_Some {_20} (fun (r0: bool) -> [ &n <- r0 ] s1) | s1 = [ &_ret <- n ] s2 | s2 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & f: t_Formula = f
  | & a: t_Assignments = a
  | & d: t_Decisions = d
  | & _20: t_Option_bool = Any.any_l ()
  | & _21: MutBorrow.t t_Assignments = Any.any_l ()
  | & n: bool = Any.any_l ()
  | & next: UInt64.t = Any.any_l ()
  | & _27: MutBorrow.t t_Assignments = Any.any_l ()
  | & a_cloned: t_Assignments = Any.any_l ()
  | & _32: MutBorrow.t UInt8.t = Any.any_l ()
  | & _33: MutBorrow.t t_Vec_u8_Global = Any.any_l ()
  | & old_a1: UInt64.t = Any.any_l ()
  | & _37: bool = Any.any_l ()
  | & _42: MutBorrow.t UInt8.t = Any.any_l ()
  | & _43: MutBorrow.t t_Vec_u8_Global = Any.any_l () ])
  [ return (result: bool) ->
  {[@stop_split] [@expl:inner ensures] ([@stop_split] [@expl:inner ensures #0] [%#ssolver'12] result = true
      -> eventually_sat f a)
    /\ ([@stop_split] [@expl:inner ensures #1] [%#ssolver'13] result = false -> not eventually_sat_complete f a)}
    (! return {result}) ]
