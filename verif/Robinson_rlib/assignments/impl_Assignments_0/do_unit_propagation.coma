type t_ClauseState = Sat | Unsat | Unit | Unknown

constant const_MAX: UInt64.t = [%#suint_macros] (18446744073709551615: UInt64.t)

function view_Vec_u8_Global (self: t_Vec_u8_Global) : Seq.seq UInt8.t

axiom view_Vec_u8_Global_spec:
  forall self: t_Vec_u8_Global [view_Vec_u8_Global self]. [%#svec] Seq.length (view_Vec_u8_Global self)
    <= UInt64.t'int const_MAX

function view_Assignments [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Robinson/src/assignments.rs" 16 4 16 33] (self: t_Assignments) : Seq.seq UInt8.t
 = [%#sassignments'22] view_Vec_u8_Global self.f0

predicate inv [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Robinson/src/assignments.rs" 49 4 49 40] (self: t_Assignments) (f: t_Formula) =
  [%#sassignments'20] UInt64.t'int f.num_vars = Seq.length (view_Assignments self)
  /\ UInt64.t'int self.f1 <= UInt64.t'int f.num_vars

type t_Vec_Lit_Global

type t_Clause = { rest: t_Vec_Lit_Global }

function view_Vec_Clause_Global (self: t_Vec_Clause_Global) : Seq.seq t_Clause

axiom view_Vec_Clause_Global_spec:
  forall self: t_Vec_Clause_Global [view_Vec_Clause_Global self]. [%#svec] Seq.length (view_Vec_Clause_Global self)
    <= UInt64.t'int const_MAX

type t_Lit = { idx: UInt64.t; polarity: bool }

function view_Vec_Lit_Global (self: t_Vec_Lit_Global) : Seq.seq t_Lit

axiom view_Vec_Lit_Global_spec:
  forall self: t_Vec_Lit_Global [view_Vec_Lit_Global self]. [%#svec] Seq.length (view_Vec_Lit_Global self)
    <= UInt64.t'int const_MAX

function view_Clause [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Robinson/src/clause.rs" 17 4 17 33] (self: t_Clause) : Seq.seq t_Lit
 = [%#sclause'3] view_Vec_Lit_Global self.rest

predicate inv'0 [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Robinson/src/lit.rs" 32 4 32 36] (self: t_Lit) (n: int) =
  [%#slit] UInt64.t'int self.idx < n

predicate vars_in_range [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Robinson/src/clause.rs" 77 4 77 46] (self: t_Clause) (n: int) =
  [%#sclause'0] forall i: int. 0 <= i /\ i < Seq.length (view_Clause self) -> inv'0 (Seq.get (view_Clause self) i) n

predicate inv'1 [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Robinson/src/clause.rs" 93 4 93 36] (self: t_Clause) (n: int) =
  [%#sclause] vars_in_range self n

predicate inv'2 [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Robinson/src/formula.rs" 34 4 34 28] (self: t_Formula) =
  [%#sformula'0] forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Clause_Global self.clauses)
    -> inv'1 (Seq.get (view_Vec_Clause_Global self.clauses) i) (UInt64.t'int self.num_vars)

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate unset [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Robinson/src/logic.rs" 40 0 40 38] (v: UInt8.t) =
  [%#slogic] if ge_log_Int (UInt8.t'int v) 2 then true else false

predicate compatible_inner [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Robinson/src/assignments.rs" 22 0 22 78] (a: Seq.seq UInt8.t) (a2: Seq.seq UInt8.t) =
  [%#sassignments'23] Seq.length a = Seq.length a2
  /\ (forall i: int. 0 <= i /\ i < Seq.length a -> unset (Seq.get a i) \/ Seq.get a i = Seq.get a2 i)

predicate complete_inner [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Robinson/src/assignments.rs" 30 0 30 52] (a: Seq.seq UInt8.t) =
  [%#sassignments'25] forall i: int. 0 <= i /\ i < Seq.length a -> not unset (Seq.get a i)

predicate compatible_complete_inner [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Robinson/src/assignments.rs" 37 0 37 87] (a: Seq.seq UInt8.t) (a2: Seq.seq UInt8.t) =
  [%#sassignments'24] compatible_inner a a2 /\ complete_inner a2

predicate sat_inner [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Robinson/src/lit.rs" 37 4 37 57] (self: t_Lit) (a: Seq.seq UInt8.t) =
  [%#slit'1] if self.polarity then
    UInt8.t'int (Seq.get a (UInt64.t'int self.idx)) = 1
  else
    UInt8.t'int (Seq.get a (UInt64.t'int self.idx)) = 0


predicate sat_inner'0 [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Robinson/src/clause.rs" 59 4 59 57] (self: t_Clause) (a: Seq.seq UInt8.t) =
  [%#sclause'2] exists i: int. 0 <= i /\ i < Seq.length (view_Clause self) /\ sat_inner (Seq.get (view_Clause self) i) a

predicate sat_inner'1 [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Robinson/src/formula.rs" 78 4 78 57] (self: t_Formula) (a: Seq.seq UInt8.t) =
  [%#sformula'5] forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Clause_Global self.clauses)
    -> sat_inner'0 (Seq.get (view_Vec_Clause_Global self.clauses) i) a

predicate eventually_sat_complete_inner [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Robinson/src/formula.rs" 61 4 61 77] (self: t_Formula) (a: Seq.seq UInt8.t) =
  [%#sformula'3] exists a2: Seq.seq UInt8.t. Seq.length a2 = UInt64.t'int self.num_vars
    /\ compatible_complete_inner a a2 /\ sat_inner'1 self a2

predicate eventually_sat_complete [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Robinson/src/formula.rs" 68 4 68 64] (self: t_Formula) (a: t_Assignments) =
  [%#sformula] eventually_sat_complete_inner self (view_Assignments a)

predicate compatible [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Robinson/src/assignments.rs" 56 4 56 52] (self: t_Assignments) (a2: t_Assignments) =
  [%#sassignments'19] compatible_inner (view_Assignments self) (view_Assignments a2)

predicate sat [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Robinson/src/formula.rs" 86 4 86 44] (self: t_Formula) (a: t_Assignments) =
  [%#sformula'2] sat_inner'1 self (view_Assignments a)

predicate unsat_inner [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Robinson/src/lit.rs" 47 4 47 59] (self: t_Lit) (a: Seq.seq UInt8.t) =
  [%#slit'0] if self.polarity then
    UInt8.t'int (Seq.get a (UInt64.t'int self.idx)) = 0
  else
    UInt8.t'int (Seq.get a (UInt64.t'int self.idx)) = 1


predicate unsat_inner'0 [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Robinson/src/clause.rs" 46 4 46 59] (self: t_Clause) (a: Seq.seq UInt8.t) =
  [%#sclause'1] forall i: int. 0 <= i /\ i < Seq.length (view_Clause self)
    -> unsat_inner (Seq.get (view_Clause self) i) a

predicate unsat_inner'1 [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Robinson/src/formula.rs" 91 4 91 59] (self: t_Formula) (a: Seq.seq UInt8.t) =
  [%#sformula'4] exists i: int. 0 <= i
    /\ i < Seq.length (view_Vec_Clause_Global self.clauses)
    /\ unsat_inner'0 (Seq.get (view_Vec_Clause_Global self.clauses) i) a

predicate unsat [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Robinson/src/formula.rs" 99 4 99 46] (self: t_Formula) (a: t_Assignments) =
  [%#sformula'1] unsat_inner'1 self (view_Assignments a)

predicate complete [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Robinson/src/assignments.rs" 61 4 61 33] (self: t_Assignments) =
  [%#sassignments'21] forall i: int. 0 <= i /\ i < Seq.length (view_Assignments self)
    -> not unset (Seq.get (view_Assignments self) i)

let unit_propagate (self: MutBorrow.t t_Assignments) (f: t_Formula) (return (x: t_ClauseState)) =
{[@stop_split] [@expl:unit_propagate requires] ([@stop_split] [@expl:unit_propagate requires #0] [%#sassignments'13] inv self.current f)
  /\ ([@stop_split] [@expl:unit_propagate requires #1] [%#sassignments'14] inv'2 f)}
  any
  [ return (result: t_ClauseState) ->
  {[@stop_split] [@expl:unit_propagate ensures] ([@stop_split] [@expl:unit_propagate ensures #0] [%#sassignments'13] inv self.final f)
    /\ ([@stop_split] [@expl:unit_propagate ensures #1] [%#sassignments'15] eventually_sat_complete f self.final
      = eventually_sat_complete f self.current)
    /\ ([@stop_split] [@expl:unit_propagate ensures #2] [%#sassignments'16] compatible self.current self.final)
    /\ ([@stop_split] [@expl:unit_propagate ensures #3] [%#sassignments'17] match result with
        | Sat -> sat f self.final
        | Unsat -> unsat f self.final
        | Unknown -> not complete self.final
        | Unit -> not complete self.current
        end)
    /\ ([@stop_split] [@expl:unit_propagate ensures #4] [%#sassignments'18] complete self.current
    -> self.current = self.final /\ (result = Unsat \/ sat f self.current))}
    (! return {result}) ]

predicate resolve_refmut_Assignments [@inline:trivial] (_1: MutBorrow.t t_Assignments) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Assignments

type t_Option_bool = None | Some bool

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let do_unit_propagation [#"/Users/sarekhs/Programming/XXXX-current/CreuSAT/Robinson/src/assignments.rs" 231 4 231 70]
  (self: MutBorrow.t t_Assignments) (f: t_Formula) (return (x: t_Option_bool)) =
{[@stop_split] [@expl:do_unit_propagation requires] ([@stop_split] [@expl:do_unit_propagation requires #0] [%#sassignments'6] inv'2 f)
  /\ ([@stop_split] [@expl:do_unit_propagation requires #1] [%#sassignments'7] inv self.current f)}
  (! bb0
  [ bb0 = s0 [ s0 = [ &_old_a <- [%#sassignments] self ] s1 | s1 = [ &_old <- self.final ] s2 | s2 = bb2 ]
  | bb2 = bb2
    [ bb2 = {[@expl:inferred invariant: unchanged value] _old = self.final}
      {[@expl:loop invariant #0] [%#sassignments'3] inv self.current f}
      {[@expl:loop invariant #1] [%#sassignments'2] compatible _old_a.current self.current}
      {[@expl:loop invariant #2] [%#sassignments'1] eventually_sat_complete f _old_a.current
      -> eventually_sat_complete f self.current}
      (! s0)
      [ s0 = MutBorrow.borrow_mut <t_Assignments> {self.current}
          (fun (_bor: MutBorrow.t t_Assignments) -> [ &_41 <- _bor ] [ &self <- { self with current = _bor.final } ] s1)
      | s1 = unit_propagate [%#sassignments'0] {_41} {f} (fun (_x: t_ClauseState) -> [ &_40 <- _x ] s2)
      | s2 = any
        [ br0 -> {_40 = Sat} (! bb6)
        | br1 -> {_40 = Unsat} (! bb7)
        | br2 -> {_40 = Unit} (! bb2)
        | br3 -> {_40 = Unknown} (! bb8) ] ] ]
  | bb8 = s0 [ s0 = -{resolve_refmut_Assignments self}- s1 | s1 = [ &_ret <- None ] s2 | s2 = return {_ret} ]
  | bb7 = s0
    [ s0 = -{resolve_refmut_Assignments self}- s1
    | s1 = [ &_ret <- Some ([%#sassignments'4] false) ] s2
    | s2 = return {_ret} ]
  | bb6 = s0
    [ s0 = -{resolve_refmut_Assignments self}- s1
    | s1 = [ &_ret <- Some ([%#sassignments'5] true) ] s2
    | s2 = return {_ret} ] ]
  [ & _ret: t_Option_bool = Any.any_l ()
  | & self: MutBorrow.t t_Assignments = self
  | & f: t_Formula = f
  | & _old_a: MutBorrow.t t_Assignments = Any.any_l ()
  | & _40: t_ClauseState = Any.any_l ()
  | & _41: MutBorrow.t t_Assignments = Any.any_l ()
  | & _old: t_Assignments = Any.any_l () ])
  [ return (result: t_Option_bool) ->
  {[@stop_split] [@expl:do_unit_propagation ensures] ([@stop_split] [@expl:do_unit_propagation ensures #0] [%#sassignments'7] inv self.final f)
    /\ ([@stop_split] [@expl:do_unit_propagation ensures #1] [%#sassignments'8] eventually_sat_complete f self.current
      = eventually_sat_complete f self.final)
    /\ ([@stop_split] [@expl:do_unit_propagation ensures #2] [%#sassignments'9] compatible self.current self.final)
    /\ ([@stop_split] [@expl:do_unit_propagation ensures #3] [%#sassignments'10] result = Some false
      -> unsat f self.final)
    /\ ([@stop_split] [@expl:do_unit_propagation ensures #4] [%#sassignments'11] result = Some true -> sat f self.final)
    /\ ([@stop_split] [@expl:do_unit_propagation ensures #5] [%#sassignments'12] result = None
    -> not complete self.final)}
    (! return {result}) ]
