use int.Int

type t_Vec_Clause_Global

type t_Formula = { clauses: t_Vec_Clause_Global; num_vars: UInt64.t }

type t_Vec_Lit_Global

type t_Clause = { rest: t_Vec_Lit_Global }

predicate in_bounds_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_Clause) =
  [%#sslice] UInt64.t'int self < Seq.length seq

meta "rewrite_def" predicate in_bounds_usize

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Clause_Global (self: t_Vec_Clause_Global) : Seq.seq t_Clause

axiom view_Vec_Clause_Global_spec: forall self: t_Vec_Clause_Global. [%#svec'6] Seq.length (view_Vec_Clause_Global self)
    <= UInt64.t'int const_MAX

predicate has_value_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_Clause) (out: t_Clause) =
  [%#sslice'0] Seq.get seq (UInt64.t'int self) = out

meta "rewrite_def" predicate has_value_usize

let rec index_Vec_Clause_Global (self_: t_Vec_Clause_Global) (ix: UInt64.t) (return (x: t_Clause)) =
  {[@stop_split] [@expl:index requires] [%#svec] in_bounds_usize ix (view_Vec_Clause_Global self_)}
  any
  [ return (result: t_Clause) ->
  {[@stop_split] [@expl:index ensures] [%#svec'0] has_value_usize ix (view_Vec_Clause_Global self_) result}
    (! return {result}) ]

type t_Vec_u8_Global

type t_Assignments = { f0: t_Vec_u8_Global; f1: UInt64.t }

type t_ClauseState = Sat | Unsat | Unit | Unknown

type t_Lit = { idx: UInt64.t; polarity: bool }

function view_Vec_Lit_Global (self: t_Vec_Lit_Global) : Seq.seq t_Lit

axiom view_Vec_Lit_Global_spec: forall self: t_Vec_Lit_Global. [%#svec'6] Seq.length (view_Vec_Lit_Global self)
    <= UInt64.t'int const_MAX

function view_Clause [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/clause.rs" 17 4 17 33] (self: t_Clause) : Seq.seq t_Lit
 = [%#sclause'16] view_Vec_Lit_Global self.rest

predicate inv [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/lit.rs" 32 4 32 36] (self: t_Lit) (n: int) =
  [%#slit'4] UInt64.t'int self.idx < n

predicate vars_in_range [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/clause.rs" 77 4 77 46] (self: t_Clause) (n: int) =
  [%#sclause'21] forall i: int. 0 <= i /\ i < Seq.length (view_Clause self) -> inv (Seq.get (view_Clause self) i) n

predicate inv'0 [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/clause.rs" 93 4 93 36] (self: t_Clause) (n: int) =
  [%#sclause'15] vars_in_range self n

function view_Vec_u8_Global (self: t_Vec_u8_Global) : Seq.seq UInt8.t

axiom view_Vec_u8_Global_spec: forall self: t_Vec_u8_Global. [%#svec'6] Seq.length (view_Vec_u8_Global self)
    <= UInt64.t'int const_MAX

function view_Assignments [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/assignments.rs" 16 4 16 33] (self: t_Assignments) : Seq.seq UInt8.t
 = [%#sassignments'21] view_Vec_u8_Global self.f0

predicate inv'1 [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/formula.rs" 34 4 34 28] (self: t_Formula) =
  [%#sformula] forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Clause_Global self.clauses)
    -> inv'0 (Seq.get (view_Vec_Clause_Global self.clauses) i) (UInt64.t'int self.num_vars)

predicate inv'2 [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/assignments.rs" 49 4 49 40] (self: t_Assignments) (f: t_Formula) =
  [%#sassignments'22] UInt64.t'int f.num_vars = Seq.length (view_Assignments self)
  /\ UInt64.t'int self.f1 <= UInt64.t'int f.num_vars

predicate sat_inner [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/lit.rs" 37 4 37 57] (self: t_Lit) (a: Seq.seq UInt8.t) =
  [%#slit'3] if self.polarity then
    UInt8.t'int (Seq.get a (UInt64.t'int self.idx)) = 1
  else
    UInt8.t'int (Seq.get a (UInt64.t'int self.idx)) = 0


predicate sat_inner'0 [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/clause.rs" 59 4 59 57] (self: t_Clause) (a: Seq.seq UInt8.t) =
  [%#sclause'19] exists i: int. 0 <= i
    /\ i < Seq.length (view_Clause self) /\ sat_inner (Seq.get (view_Clause self) i) a

predicate sat [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/clause.rs" 67 4 67 44] (self: t_Clause) (a: t_Assignments) =
  [%#sclause'13] sat_inner'0 self (view_Assignments a)

predicate unsat_inner [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/lit.rs" 47 4 47 59] (self: t_Lit) (a: Seq.seq UInt8.t) =
  [%#slit'1] if self.polarity then
    UInt8.t'int (Seq.get a (UInt64.t'int self.idx)) = 0
  else
    UInt8.t'int (Seq.get a (UInt64.t'int self.idx)) = 1


predicate unsat_inner'0 [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/clause.rs" 46 4 46 59] (self: t_Clause) (a: Seq.seq UInt8.t) =
  [%#sclause'20] forall i: int. 0 <= i /\ i < Seq.length (view_Clause self)
    -> unsat_inner (Seq.get (view_Clause self) i) a

predicate unsat [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/clause.rs" 54 4 54 46] (self: t_Clause) (a: t_Assignments) =
  [%#sclause'14] unsat_inner'0 self (view_Assignments a)

predicate unset_inner [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/lit.rs" 57 4 57 59] (self: t_Lit) (a: Seq.seq UInt8.t) =
  [%#slit'2] UInt8.t'int (Seq.get a (UInt64.t'int self.idx)) >= 2

predicate unit_inner [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/clause.rs" 32 4 32 58] (self: t_Clause) (a: Seq.seq UInt8.t) =
  [%#sclause'17] vars_in_range self (Seq.length a)
  /\ not sat_inner'0 self a
  /\ (exists i: int. 0 <= i
    /\ i < Seq.length (view_Clause self)
    /\ unset_inner (Seq.get (view_Clause self) i) a
    /\ (forall j: int. 0 <= j /\ j < Seq.length (view_Clause self) /\ j <> i
      -> not unset_inner (Seq.get (view_Clause self) j) a))

predicate unit' [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/clause.rs" 41 4 41 45] (self: t_Clause) (a: t_Assignments) =
  [%#sclause'12] unit_inner self (view_Assignments a)

predicate unset [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/logic.rs" 40 0 40 38] (v: UInt8.t) =
  [%#slogic'31] if UInt8.t'int v >= 2 then true else false

predicate complete [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/assignments.rs" 61 4 61 33] (self: t_Assignments) =
  [%#sassignments'24] forall i: int. 0 <= i /\ i < Seq.length (view_Assignments self)
    -> not unset (Seq.get (view_Assignments self) i)

let rec check_if_unit (self: t_Clause) (a: t_Assignments) (_f: t_Formula) (return (x: t_ClauseState)) =
  {[@stop_split] [@expl:check_if_unit requires] ([@stop_split] [@expl:check_if_unit requires #0] [%#sclause] inv'0 self (Seq.length (view_Assignments a)))
  /\ ([@stop_split] [@expl:check_if_unit requires #1] [%#sclause'0] inv'1 _f)
  /\ ([@stop_split] [@expl:check_if_unit requires #2] [%#sclause'1] inv'2 a _f)}
  any
  [ return (result: t_ClauseState) ->
  {[@stop_split] [@expl:check_if_unit ensures] ([@stop_split] [@expl:check_if_unit ensures #0] [%#sclause'2] result
        = Sat -> sat self a)
    /\ ([@stop_split] [@expl:check_if_unit ensures #1] [%#sclause'3] result = Unsat -> unsat self a)
    /\ ([@stop_split] [@expl:check_if_unit ensures #2] [%#sclause'4] result = Unit -> unit' self a /\ not complete a)
    /\ ([@stop_split] [@expl:check_if_unit ensures #3] [%#sclause'5] result = Unknown -> not complete a)}
    (! return {result}) ]

predicate resolve_refmut_Assignments [@inline:trivial] (_1: MutBorrow.t t_Assignments) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Assignments

function index [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/lit.rs" 17 4 17 35] [@inline:trivial] (self: t_Lit) : int
 = [%#slit] UInt64.t'int self.idx

meta "rewrite_def" function index

let rec get_unit (self: t_Clause) (a: t_Assignments) (_f: t_Formula) (return (x: t_Lit)) =
  {[@stop_split] [@expl:get_unit requires] ([@stop_split] [@expl:get_unit requires #0] [%#sclause'6] unit' self a)
  /\ ([@stop_split] [@expl:get_unit requires #1] [%#sclause'7] inv'1 _f)
  /\ ([@stop_split] [@expl:get_unit requires #2] [%#sclause'8] inv'2 a _f)}
  any
  [ return (result: t_Lit) ->
  {[@stop_split] [@expl:get_unit ensures] ([@stop_split] [@expl:get_unit ensures #0] [%#sclause'9] exists j: int. 0 <= j
        /\ j < Seq.length (view_Clause self) /\ Seq.get (view_Clause self) j = result)
    /\ ([@stop_split] [@expl:get_unit ensures #1] [%#sclause'10] index result < Seq.length (view_Assignments a))
    /\ ([@stop_split] [@expl:get_unit ensures #2] [%#sclause'11] unset (Seq.get (view_Assignments a) (index result)))}
