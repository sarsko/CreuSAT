        | s1 = bb2 ] ] ]
  | bb9 = s0 [ s0 = -{resolve_refmut_Assignments self}- s1 | s1 = [ &_ret <- Unsat ] s2 | s2 = return {_ret} ]
  | bb19 = s0 [ s0 = -{resolve_refmut_Assignments self}- s1 | s1 = [ &_ret <- out ] s2 | s2 = return {_ret} ] ]
  [ & _ret: t_ClauseState = Any.any_l ()
  | & self: MutBorrow.t t_Assignments = self
  | & f: t_Formula = f
  | & _old_a: MutBorrow.t t_Assignments = Any.any_l ()
  | & i: UInt64.t = Any.any_l ()
  | & out: t_ClauseState = Any.any_l ()
  | & _59: bool = Any.any_l ()
  | & _61: UInt64.t = Any.any_l ()
  | & _64: t_ClauseState = Any.any_l ()
  | & _65: MutBorrow.t t_Assignments = Any.any_l ()
  | & _70: t_ClauseState = Any.any_l ()
  | & _72: t_ClauseState = Any.any_l ()
  | & _old: t_Assignments = Any.any_l () ])
  [ return (result: t_ClauseState) ->
  {[@stop_split] [@expl:unit_propagate ensures] ([@stop_split] [@expl:unit_propagate ensures #0] [%#sassignments'13] inv'0 self.final f)
    /\ ([@stop_split] [@expl:unit_propagate ensures #1] [%#sassignments'15] eventually_sat_complete f self.final
      = eventually_sat_complete f self.current)
    /\ ([@stop_split] [@expl:unit_propagate ensures #2] [%#sassignments'16] compatible self.current self.final)
    /\ ([@stop_split] [@expl:unit_propagate ensures #3] [%#sassignments'17] match result with
        | Sat -> sat'0 f self.final
        | Unsat -> unsat'0 f self.final
        | Unknown -> not complete self.final
        | Unit -> not complete self.current
        end)
    /\ ([@stop_split] [@expl:unit_propagate ensures #4] [%#sassignments'18] complete self.current
    -> self.current = self.final /\ (result = Unsat \/ sat'0 f self.current))}
    (! return {result}) ]
