let rec unit_prop_once (self: MutBorrow.t t_Assignments) (i: UInt64.t) (f: t_Formula) (return (x: t_ClauseState)) =
  {[@stop_split] [@expl:unit_prop_once requires] ([@stop_split] [@expl:unit_prop_once requires #0] [%#sassignments'22] inv'0 self.current f)
  /\ ([@stop_split] [@expl:unit_prop_once requires #1] [%#sassignments'23] inv'2 f)
  /\ ([@stop_split] [@expl:unit_prop_once requires #2] [%#sassignments'24] 0 <= UInt64.t'int i
  /\ UInt64.t'int i < Seq.length (view_Vec_Clause_Global f.clauses))}
  any
  [ return (result: t_ClauseState) ->
  {[@stop_split] [@expl:unit_prop_once ensures] ([@stop_split] [@expl:unit_prop_once ensures #0] [%#sassignments'22] inv'0 self.final f)
    /\ ([@stop_split] [@expl:unit_prop_once ensures #1] [%#sassignments'25] compatible self.current self.final)
    /\ ([@stop_split] [@expl:unit_prop_once ensures #2] [%#sassignments'26] eventually_sat_complete f self.current
      = eventually_sat_complete f self.final)
    /\ ([@stop_split] [@expl:unit_prop_once ensures #3] [%#sassignments'27] match result with
        | Unit -> unit' (Seq.get (view_Vec_Clause_Global f.clauses) (UInt64.t'int i)) self.current
        /\ not complete self.current
        | Sat -> sat (Seq.get (view_Vec_Clause_Global f.clauses) (UInt64.t'int i)) self.final
        /\ view_Assignments self.current = view_Assignments self.final
        | Unsat -> unsat (Seq.get (view_Vec_Clause_Global f.clauses) (UInt64.t'int i)) self.final
        /\ view_Assignments self.current = view_Assignments self.final
        | Unknown -> view_Assignments self.current = view_Assignments self.final /\ not complete self.final
        end)
    /\ ([@stop_split] [@expl:unit_prop_once ensures #4] [%#sassignments'28] complete self.current
    -> self.current = self.final /\ (result = Unsat \/ result = Sat))}
    (! return {result}) ]

