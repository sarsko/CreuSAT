use creusot.int.UInt64
use creusot.int.UInt8
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_Lit = { idx: UInt64.t; polarity: bool }

type t_Vec_u8_Global

type t_Assignments = { f0: t_Vec_u8_Global; f1: UInt64.t }

predicate in_bounds_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq UInt8.t) =
  [%#sslice] UInt64.t'int self < Seq.length seq

meta "rewrite_def" predicate in_bounds_usize

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_u8_Global (self: t_Vec_u8_Global) : Seq.seq UInt8.t

axiom view_Vec_u8_Global_spec: forall self: t_Vec_u8_Global. [%#svec'1] Seq.length (view_Vec_u8_Global self)
    <= UInt64.t'int const_MAX

predicate has_value_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq UInt8.t) (out: UInt8.t) =
  [%#sslice'0] Seq.get seq (UInt64.t'int self) = out

meta "rewrite_def" predicate has_value_usize

let rec index_Vec_u8_Global (self_: t_Vec_u8_Global) (ix: UInt64.t) (return (x: UInt8.t)) =
  {[@stop_split] [@expl:index requires] [%#svec] in_bounds_usize ix (view_Vec_u8_Global self_)}
  any
  [ return (result: UInt8.t) ->
  {[@stop_split] [@expl:index ensures] [%#svec'0] has_value_usize ix (view_Vec_u8_Global self_) result}
    (! return {result}) ]

predicate inv [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/lit.rs" 32 4 32 36] (self: t_Lit) (n: int) =
  [%#slit'5] UInt64.t'int self.idx < n

function view_Assignments [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/assignments.rs" 16 4 16 33] (self: t_Assignments) : Seq.seq UInt8.t
 = [%#sassignments] view_Vec_u8_Global self.f0

predicate sat_inner [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/lit.rs" 37 4 37 57] (self: t_Lit) (a: Seq.seq UInt8.t) =
  [%#slit'7] if self.polarity then
    UInt8.t'int (Seq.get a (UInt64.t'int self.idx)) = 1
  else
    UInt8.t'int (Seq.get a (UInt64.t'int self.idx)) = 0


predicate sat [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/lit.rs" 64 4 64 44] (self: t_Lit) (a: t_Assignments) =
  [%#slit'6] sat_inner self (view_Assignments a)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec lit_sat [#"/Users/sarekhs/Programming/CreuSAT/Robinson/src/lit.rs" 92 4 92 49] (self: t_Lit) (a: t_Assignments)
  (return (x: bool)) = {[@stop_split] [@expl:lit_sat requires] [%#slit'3] inv self (Seq.length (view_Assignments a))}
  (! bb0
  [ bb0 = any [ br0 -> {self.polarity = false} (! bb2) | br1 -> {self.polarity} (! bb3) ]
  | bb3 = s0
    [ s0 = index_Vec_u8_Global [%#slit] {a.f0} {self.idx} (fun (_x: UInt8.t) -> [ &_10 <- _x ] s1)
    | s1 = [ &_ret <- _10 = ([%#slit'0] (1: UInt8.t)) ] s2
    | s2 = return {_ret} ]
  | bb2 = s0
    [ s0 = index_Vec_u8_Global [%#slit'1] {a.f0} {self.idx} (fun (_x: UInt8.t) -> [ &_14 <- _x ] s1)
    | s1 = [ &_ret <- _14 = ([%#slit'2] (0: UInt8.t)) ] s2
    | s2 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & self: t_Lit = self
  | & a: t_Assignments = a
  | & _10: UInt8.t = Any.any_l ()
  | & _14: UInt8.t = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:lit_sat ensures] [%#slit'4] result = sat self a}
    (! return {result}) ]
