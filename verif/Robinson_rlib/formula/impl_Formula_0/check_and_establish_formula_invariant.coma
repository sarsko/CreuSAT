    | s2 = [ &_old <- self.final ] s3
    | s3 = [ &_old'0 <- self.current.clauses ] s4
    | s4 = bb7 ]
  | bb7 = bb7
    [ bb7 = {[@expl:inferred invariant: unchanged value] _old'0 = self.current.clauses}
      {[@expl:inferred invariant: unchanged value] _old = self.final}
      {[@expl:loop invariant #0] [%#sformula'10] forall j: int. 0 <= j /\ j < UInt64.t'int i
        -> inv'0 (Seq.get (view_Vec_Clause_Global self.current.clauses) j) (UInt64.t'int self.current.num_vars)}
      {[@expl:loop invariant #1] [%#sformula'9] forall j: int. 0 <= j /\ j < UInt64.t'int i
        -> Seq.length (view_Clause (Seq.get (view_Vec_Clause_Global self.current.clauses) j)) > 0}
      {[@expl:loop invariant #2] [%#sformula'8] (view_Formula self.current).f0 = (view_Formula old_self.current).f0}
      {[@expl:loop invariant #3] [%#sformula'7] self.current.clauses = old_self.current.clauses}
